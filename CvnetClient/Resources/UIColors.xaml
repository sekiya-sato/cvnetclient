<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib" >
	<!--Font Colors-->
	<SolidColorBrush x:Key="TitleColor" Color="AntiqueWhite"/>
	<SolidColorBrush x:Key="SubTitleColor" Color="FloralWhite"/>
	<SolidColorBrush x:Key="TitleLabelColor" Color="GhostWhite" />
	<SolidColorBrush x:Key="plainTextColor0" Color="White" />

    <SolidColorBrush x:Key="TextBtnColor1" Color="White"/>
    <SolidColorBrush x:Key="TextBtnColor2" Color="Black"/>
    <SolidColorBrush x:Key="FormMenuBg" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="MainMenuBg" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="DefaultButton1" Color="#A7D8D8"/>
    <SolidColorBrush x:Key="DefaultButton2" Color="#7FDBDA"/>
    <SolidColorBrush x:Key="DefaultButton3" Color="#B2DFDB"/>

    <SolidColorBrush x:Key="ExecButtonColor" Color="#3498db"/>
    <SolidColorBrush x:Key="BackBtnColor" Color="#95a5a6"/>

    <sys:Double x:Key="AppFontSize">16</sys:Double>
    <sys:Double x:Key="MenuFontSize">14</sys:Double>
    <sys:Double x:Key="ButtonSize">12</sys:Double>
    <sys:Double x:Key="TextSize">12</sys:Double>

    <FontWeight x:Key="AppFontWeight">Bold</FontWeight>
    <FontWeight x:Key="LabelFontWeight">Regular</FontWeight>
    <FontWeight x:Key="ButtonFontWeight">Regular</FontWeight>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource TextSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource LabelFontWeight}"/>
        
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="{DynamicResource LabelFontWeight}"/>
        <Setter Property="FontSize" Value="{DynamicResource TextSize}"/>
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>
</ResourceDictionary>