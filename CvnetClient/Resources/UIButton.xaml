<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
					xmlns:util="clr-namespace:CvnetClient.Utils">

	<!-- Tag to Image Source Converter -->
	<util:TagToImageSourceConverter x:Key="TagToImgConvert" />
	<util:ImageRatioConverter x:Key="ImageRatioConverter" />
	
	<!--Default Button Style-->
	<Style TargetType="Button">
		<Setter Property="Background" Value="#9932CC"/>
		<Setter Property="Foreground" Value="White"/> 
	</Style>

	<!-- Window Button -->
	<Style x:Key="WindowButton" TargetType="Button">
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FontFamily" Value="Montserrat" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="border"
							Width="18" Height="18"
							CornerRadius="9"
							Background="{TemplateBinding Background}">
						<ContentPresenter x:Name="contentPresenter"
										  HorizontalAlignment="Center" 
										  VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="#E0FFFF" />
							<Setter Property="Foreground" Value="Black" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Windows Button for Minimize, Close -->
	<Style x:Key="MinimizeWinBtn" TargetType="Button" BasedOn="{StaticResource WindowButton}">
		<Setter Property="Content" Value="-" />
		<Setter Property="Background" Value="#28AEED" />
	</Style>

	<Style x:Key="MaximizeWinBtn" TargetType="Button" BasedOn="{StaticResource WindowButton}">
		<Setter Property="Content" Value="◻" />
		<Setter Property="Background" Value="#22DD22" />
	</Style>

	<Style x:Key="CloseWinBtn" TargetType="Button" BasedOn="{StaticResource WindowButton}">
		<Setter Property="Content" Value="x" />
		<Setter Property="Background" Value="#DA34AE" />
	</Style>

	<!-- Icon Button Icon (Left) and Title (Right) -->
	<Style x:Key="IconButton" TargetType="Button"> 
		<Setter Property="Background" Value="#3A6AFF" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="{StaticResource plainTextColor0}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="border" 
							Width="{TemplateBinding Width}" 
							Height="{TemplateBinding Height}"
							CornerRadius="20"
							Background="{TemplateBinding Background}">
						<StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="5,0">
							<!-- Image on the left side -->
							<Image Source="{Binding Tag, 
													RelativeSource={RelativeSource TemplatedParent}, 
													Converter={StaticResource TagToImgConvert}}"
								   Width="{Binding ActualWidth, 
												   RelativeSource={RelativeSource AncestorType=Button}, 
												   Converter={StaticResource ImageRatioConverter}, 
												   ConverterParameter=0.3}"
								   Height="{Binding ActualHeight, 
												    RelativeSource={RelativeSource AncestorType=Button}, 
												    Converter={StaticResource ImageRatioConverter}, 
												    ConverterParameter=0.6}"
								   VerticalAlignment="Center" />
							<!-- Content (text) on the right side -->
							<ContentPresenter x:Name="contentPresenter"
											  VerticalAlignment="Center" 
											  HorizontalAlignment="Center" />
						</StackPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="#E0FFFF" />
							<Setter Property="Foreground" Value="Black" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Icon Button  Icon (Top) and Title (Bottom)  -->
	<Style x:Key="IconButton2" TargetType="Button">
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="Black" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="MinHeight" Value="50" />
		<Setter Property="MinWidth" Value="60" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="border"
							Width="{TemplateBinding Width}" 
							Height="{TemplateBinding Height}"
							BorderBrush="Black"
							BorderThickness="2" 
							CornerRadius="5"
							Background="{TemplateBinding Background}">
						<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
							<!-- Icon at the top -->
							<Image Source="{Binding Tag, 
												RelativeSource={RelativeSource TemplatedParent}, 
												Converter={StaticResource TagToImgConvert}}" 
								   Width="{Binding ActualWidth, 
								                   RelativeSource={RelativeSource AncestorType=Button}, 
								                   Converter={StaticResource ImageRatioConverter}, 
								                   ConverterParameter=0.5}"
								   Height="{Binding ActualHeight, 
								                    RelativeSource={RelativeSource AncestorType=Button}, 
								                    Converter={StaticResource ImageRatioConverter}, 
								                    ConverterParameter=0.55}"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
							<!-- Title at the bottom -->
							<ContentPresenter x:Name="contentPresenter"
										  VerticalAlignment="Center" 
										  HorizontalAlignment="Center" />
						</StackPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="#E0FFFF" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

