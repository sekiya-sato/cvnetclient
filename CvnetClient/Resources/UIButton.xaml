	<!--Default Button Style-->
	<Style TargetType="Button">
		<Setter Property="Background" Value="{DynamicResource DefaultButton3}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}"/>
        <Setter Property="FontSize" Value="{DynamicResource ButtonSize}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button"> 
                    <Border Background="{TemplateBinding Background}"
                            x:Name="border"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#BDBDBD"/>
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <!--<Setter TargetName="border" Property="Opacity" Value="0.5"/>-->
                            <!--<Setter Property="Foreground" Value="#FFD0D3D4"/>-->
                            <!-- Light gray background -->
                            <Setter TargetName="border" Property="Background" Value="#EEE"/>
                            <!-- Softer border -->
                            <Setter TargetName="border" Property="BorderBrush" Value="#AAA"/>
                            <!-- Gray text for icon + content -->
                            <Setter Property="Foreground" Value="#777"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

