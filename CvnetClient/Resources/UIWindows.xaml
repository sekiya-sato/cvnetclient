<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib" >

    <Style x:Key="GlobalWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
        <Setter Property="Background" Value="{DynamicResource FormMenuBg}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="{DynamicResource AppFontWeight}"/>
        <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border CornerRadius="5"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0.5"
                    BorderBrush="Black"
                    SnapsToDevicePixels="True">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding DragMoveCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                            Background="Black"
                            CornerRadius="5,5,0,0"
                            Padding="6,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0" Margin="6,0,0,0">
                                    </StackPanel>

                                    <TextBlock Text="{TemplateBinding Title}"
                                       Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{StaticResource TitleColor}"
                                       TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,4,0">
                                        <Button Command="{Binding MinimizeCommand}"
                                        Style="{StaticResource MinimizeWinBtn}" Margin="0,0,6,0"/>
                                        <Button Command="{Binding MaximizeCommand}"
                                        Style="{StaticResource MaximizeWinBtn}" Margin="0,0,6,0"/>
                                        <Button Command="{Binding CloseCommand}"
                                        Style="{StaticResource CloseWinBtn}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" Margin="12" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrintWindowStyle" TargetType="Window" BasedOn="{StaticResource GlobalWindowStyle}">
        <Setter Property="Height" Value="450"/>
        <Setter Property="Width" Value="800"/>
    </Style>
    
    <Style x:Key="PrintWindowStyle1" TargetType="Window" BasedOn="{StaticResource GlobalWindowStyle}">
        <Setter Property="Height" Value="650"/>
        <Setter Property="Width" Value="800"/>
    </Style>

    <Style x:Key="SmallWindow" TargetType="Window" BasedOn="{StaticResource GlobalWindowStyle}">
        <Setter Property="Height" Value="450"/>
        <Setter Property="Width" Value="650"/>
    </Style>

    <Style x:Key="MasterWindowStyle" TargetType="Window" BasedOn="{StaticResource GlobalWindowStyle}">
        <Setter Property="Width" Value="1000"/>
        <Setter Property="Height" Value="650"/>
    </Style>

    <Style x:Key="JissekiWindowStyle" TargetType="Window" BasedOn="{StaticResource GlobalWindowStyle}">
        <Setter Property="Width" Value="1000"/>
        <Setter Property="Height" Value="1000"/>
    </Style>

    <Style x:Key="MasterWindowStyle2" TargetType="Window" BasedOn="{StaticResource GlobalWindowStyle}">
        <Setter Property="Width" Value="1000"/>
        <Setter Property="Height" Value="800"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
        <Setter Property="MinWidth" Value="600"/>
        <Setter Property="MinHeight" Value="400"/>
    </Style>

    <Style x:Key="ExtraMasterWindowStyle" TargetType="Window" BasedOn="{StaticResource GlobalWindowStyle}">
        <Setter Property="Height" Value="1000"/>
        <Setter Property="Width" Value="1500"/>
    </Style>

    <Style x:Key="InputWindowStyle" TargetType="Window" BasedOn="{StaticResource GlobalWindowStyle}">
        <Setter Property="Height" Value="450"/>
        <Setter Property="Width" Value="800"/>
    </Style>
</ResourceDictionary>