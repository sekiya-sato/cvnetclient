<Application
	x:Class="CvnetClient.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:local="clr-namespace:CvnetClient"
	StartupUri="MainWindow.xaml">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!--  ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" /  -->
				<ResourceDictionary Source="/Resources/UIButton.xaml"/>
				<ResourceDictionary Source="/Resources/UIColors.xaml"/>
				<ResourceDictionary Source="/Resources/UICombobox.xaml"/>
				<ResourceDictionary Source="/Resources/UICommon.xaml"/>
				<ResourceDictionary Source="/Resources/UIGridData.xaml"/>
				<ResourceDictionary Source="/Resources/UITextBox.xaml"/>

				<!-- Pilih tema warna -->
				<materialDesign:BundledTheme BaseTheme="Light"
											 PrimaryColor="Blue"
											 SecondaryColor="Lime"/>

				<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>
