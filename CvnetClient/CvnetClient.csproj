<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>cvnet.ico</ApplicationIcon>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="cvnet.ico" />
    <None Remove="Images\button_icon\add_icon.png" />
    <None Remove="Images\button_icon\back_icon.png" />
    <None Remove="Images\button_icon\calendar_icon.png" />
    <None Remove="Images\button_icon\clear_button.png" />
    <None Remove="Images\button_icon\delete_icon.png" />
    <None Remove="Images\button_icon\enter_icon.png" />
    <None Remove="Images\button_icon\json_icon.png" />
    <None Remove="Images\button_icon\next_icon.png" />
    <None Remove="Images\button_icon\printer_icon.png" />
    <None Remove="Images\button_icon\refresh_icon.png" />
    <None Remove="Images\button_icon\search_icon.png" />
    <None Remove="Images\button_icon\update_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="cvnet.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ClassSatoo">
      <HintPath>..\ClassSatoo\bin\Debug\net9.0\ClassSatoo.dll</HintPath>
    </Reference>
    <Reference Include="CvnetBaseCore">
      <HintPath>..\CvnetBaseCore\bin\Debug\net9.0\CvnetBaseCore.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="cvnet.ico" />
    <Resource Include="Images\button_icon\add_icon.png" />
    <Resource Include="Images\button_icon\back_icon.png" />
    <Resource Include="Images\button_icon\calendar_icon.png" />
    <Resource Include="Images\button_icon\clear_button.png" />
    <Resource Include="Images\button_icon\delete_icon.png" />
    <Resource Include="Images\button_icon\enter_icon.png" />
    <Resource Include="Images\button_icon\json_icon.png" />
    <Resource Include="Images\button_icon\next_icon.png" />
    <Resource Include="Images\button_icon\printer_icon.png" />
    <Resource Include="Images\button_icon\refresh_icon.png" />
    <Resource Include="Images\button_icon\search_icon.png" />
    <Resource Include="Images\button_icon\update_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views.Common\WebTextView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Debug.json">
      <DependentUpon>appsettings.json</DependentUpon>
      <SubType>Designer</SubType>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Release.json">
      <DependentUpon>appsettings.json</DependentUpon>
      <SubType>Designer</SubType>
    </None>
    <None Update="Nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="set projdir=$(ProjectDir)&#xD;&#xA;set projcfg=$(Configuration)&#xD;&#xA;set projout=$(OutDir)&#xD;&#xA;call app-post-build.bat&#xD;&#xA;" />
  </Target>
</Project>
