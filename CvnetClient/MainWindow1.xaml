<Window x:Class="CvnetClient.MainWindow1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:local="clr-namespace:CvnetClient"
        mc:Ignorable="d"
        Title="MainWindow1" Height="600" Width="1120">
    <!--<Window.DataContext>
        <vm:MainMenuViewModel />
    </Window.DataContext>-->
    <Border CornerRadius="10,10,0,0"
        Background="#EEE"
        Grid.Row="0"
        Grid.ColumnSpan="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Body -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <!-- Sidebar -->
                <ColumnDefinition Width="*"/>
                <!-- Main -->
            </Grid.ColumnDefinitions>

            <!-- Header background -->
            <Rectangle Grid.Row="0" Grid.ColumnSpan="2" Fill="#DDD"/>

            <!-- Sidebar top (sambung header) -->
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#DDD"/>

            <!-- Sidebar bawah -->
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#DDD"/>

            <!-- Header text -->
            <TextBlock Text="Creative Vision.net"
                   Grid.Row="0" Grid.Column="1"
                   Margin="0,0,5,0 "
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontWeight="Bold"/>

            <!-- Sidebar content -->
            <StackPanel Grid.Row="1" Grid.Column="0"
                    Background="Transparent">
                <Button Content="🏠" Margin="5"/>
            </StackPanel>
            
            <!-- Main Content -->
            <Frame x:Name="MainFrame"
               Grid.Row="1"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>
        </Grid>
    </Border>

</Window>