<Window x:Class="CvnetClient.MainWindow1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:local="clr-namespace:CvnetClient"
        mc:Ignorable="d"
        Title="MainWindow1" Height="600" Width="1120"
        Loaded="Window_Loaded">
    <!--<Window.DataContext>
        <vm:MainMenuViewModel />
    </Window.DataContext>-->
    <Border CornerRadius="10,10,0,0"
        Background="#DDD"
        Grid.Row="0"
        Grid.ColumnSpan="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Body -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <!-- Sidebar -->
                <ColumnDefinition Width="*"/>
                <!-- Main -->
            </Grid.ColumnDefinitions>

            <!-- Header background -->
            <Rectangle Grid.Row="0" Grid.ColumnSpan="2" Fill="#DDD"/>

            <!-- Sidebar bawah -->
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#DDD"/>

            <Border Grid.Row="1" Grid.Column="1"

        Background="#EEE"
        CornerRadius="60,0,0,0"

                    HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Grid.ZIndex="10"/>

            <!-- Header text -->
            <TextBlock Text="Creative Vision.net"
                   Grid.Row="0" Grid.Column="1"
                   Margin="0,0,5,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontWeight="Bold"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#DDD">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Atas: Menu -->
                        <RowDefinition Height="*"/>
                        <!-- Tengah kosong -->
                        <RowDefinition Height="Auto"/>
                        <!-- Bawah: User -->
                    </Grid.RowDefinitions>

                    <!-- Menu Atas -->
                    <StackPanel x:Name="Sidebar" Grid.Row="0" Margin="0,20,0,0">
                        <ToggleButton x:Name="BtnHome" Content="🏠"
                          Style="{StaticResource SidebarButtonStyle}"
                          IsChecked="True"
                          Click="SidebarButton_Click"/>
                        <ToggleButton Content="📊"
                          Style="{StaticResource SidebarButtonStyle}"
                          Click="SidebarButton_Click"/>
                        <ToggleButton Content="⚙"
                          Style="{StaticResource SidebarButtonStyle}"
                          Click="SidebarButton_Click"/>
                    </StackPanel>

                    <!-- User Bawah -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,10">
                        <Button x:Name="UserButton"
                                Content="👤"
                                Style="{StaticResource UserButtonStyle}"
                                Click="UserButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}">
                                    <MenuItem Header="プロファイル" Click="Profile_Click"/>
                                    <MenuItem Header="ログアウト" Click="Logout_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- Main Content -->
            <Frame x:Name="MainFrame"
               Grid.Row="1"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Grid.ZIndex="20"/>
        </Grid>
    </Border>



</Window>