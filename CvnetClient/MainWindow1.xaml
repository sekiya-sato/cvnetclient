<Window x:Class="CvnetClient.MainWindow1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        mc:Ignorable="d"
        Title="CV.net" Height="600" Width="1120">
    
    <Window.DataContext>
        <vm:MainMenuViewModel />
    </Window.DataContext>
    <Window.InputBindings>
        
        <KeyBinding Key="F12" Command="{Binding DoLoginCommand}" />
        <KeyBinding
		Key="F11"
		Command="{Binding DoTestCommand}"
		Modifiers="Shift" />
        <KeyBinding
		Key="F10"
		Command="{Binding DoSettingCommand}"
		Modifiers="Shift" />
    </Window.InputBindings>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="ContentRendered">
            <behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Window.Resources>
        <Style x:Key="WhiteDisabledTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10,10,0,0"
        Background="#DDD"
        Grid.Row="0"
        Grid.ColumnSpan="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Row="0" Grid.ColumnSpan="2" Fill="#DDD"/>

            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#DDD"/>

            <Border Grid.Row="1" Grid.Column="1"

        Background="#EEE"
        CornerRadius="60,0,0,0"

                    HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Grid.ZIndex="10"/>

            <TextBlock Text="Creative Vision.net"
                   Grid.Row="0" Grid.Column="1"
                   Margin="0,0,5,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontWeight="Bold"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#DDD">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="Sidebar" Grid.Row="0" Margin="0,20,0,0">
                        <ToggleButton x:Name="BtnHome" Content="🏠"
                          Style="{StaticResource SidebarButtonStyle}"
                          IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                          Command="{Binding GoHomeCommand}"/>
                        <ToggleButton Content="📊"
                          Style="{StaticResource SidebarButtonStyle}"
                          IsChecked="{Binding IsReportSelected, Mode=OneWay}"
                          Command="{Binding GoReportCommand}"/>
                        <ToggleButton Content="⚙"
                          Style="{StaticResource SidebarButtonStyle}"
                          IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"            
                          Command="{Binding GoSettingsCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,10,0,10">
                        <Button x:Name="UserButton"
                                Content="👤"
                                Style="{StaticResource UserButtonStyle}">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}">
                                    <MenuItem Header="プロファイル" Command="{Binding ShowProfileCommand}"/>
                                    <MenuItem Header="設定" Command="{Binding DoSettingCommand}"/>
                                    <MenuItem Header="ログアウト" Command="{Binding DoLoginCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame"
               Grid.Row="1"
               Grid.Column="1"
               Content="{Binding CurrentPage}"
               NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"
               Grid.ZIndex="20"/>
        </Grid>
    </Border>
</Window>