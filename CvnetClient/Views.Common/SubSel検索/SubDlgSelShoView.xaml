<Window x:Class="CvnetClient.Views.SubDlgSelShoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
		xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
		xmlns:uc="clr-namespace:CvnetClient.Views.Component"
		xmlns:vm="clr-namespace:CvnetClient.ViewModels" 
        Title="検索条件" Height="600" Width="900" 
        Background="White">
	<Window.DataContext>
		<vm:SubDlgSelShoViewModel />
	</Window.DataContext>
	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="ContentRendered">
			<behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>
	<Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 検索条件 Card -->
        <materialDesign:Card Padding="16" Margin="0 0 0 16" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="検索条件" 
                           Margin="0 0 0 12"/>

                <!-- 商品CD & 商品名 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content=" 商品CD " VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="8"/>
					<TextBlock Grid.Column="2" Text="～" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Margin="8"/>

                    <TextBlock Text="商品名" Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="8"/>
                </Grid>

                <!-- 日付 + CheckBox -->
                <StackPanel Orientation="Horizontal" Margin="0 8">
                    <TextBlock Text="店頭投入日" VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <DatePicker Width="160" />
                    <CheckBox Content="在庫" VerticalAlignment="Center" Margin="0 0"/>
                </StackPanel>

                <!-- 条件結合 -->
                <StackPanel Orientation="Horizontal" Margin="0 8">
                    <TextBlock Text="条件結合" VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <RadioButton Content="AND" IsChecked="True" Margin="0 0 16 0"/>
                    <RadioButton Content="OR"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- 条件リスト DataGrid -->
		<uc:ListFlexView Grid.Row="1" 
						 Config="{Binding ListConfig}"
						 Rows="{Binding ListFlex}" 
						 QueryString="{Binding WhereClaus, Mode=TwoWay}" />

		<!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 0 0">
            <Button Content="🔍 検索" Style="{DynamicResource MaterialDesignContainedButton}" Margin="4"/> 
            <Button Content="❌ 閉じる" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>
