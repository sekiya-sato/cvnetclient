<Window x:Class="CvnetClient.Views.SubDlg01ShoSh5v2View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:CvnetClient.ViewModels"
		xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="{Binding DgTitle}" 
		Height="615" Width="1024"
		Style="{StaticResource MasterWindowStyle}">
	<Window.DataContext>
		<vm:SubDlg01ShoSh5v2ViewModel />
	</Window.DataContext>
    <Grid Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="2*" />
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition /> 
			</Grid.ColumnDefinitions>
			<Label Grid.Column="0"
				   Content="商品CD" 
				   VerticalContentAlignment="Center"
				   HorizontalContentAlignment="Left"/>
			<TextBox Grid.Column="1" 
					 Text="{Binding ShoSh5SearchOpt.ProdCd}"/>
			<Label Grid.Column="2"
				   Content="元上代" 
				   VerticalContentAlignment="Center"
				   HorizontalContentAlignment="Left"/>
			<TextBox Grid.Column="3"
					 HorizontalContentAlignment="Right"
					 Text="{Binding ShoSh5SearchOpt.OriCost}"/>
			<Label Grid.Column="4"
				   Content="上代" 
				   VerticalContentAlignment="Center"
				   HorizontalContentAlignment="Left"/>
			<TextBox Grid.Column="5"
					 HorizontalContentAlignment="Right"
					 Text="{Binding ShoSh5SearchOpt.Cost}"/>
			<Label Grid.Column="6"
				   Content="最終修正者" 
				   VerticalContentAlignment="Center"
				   HorizontalContentAlignment="Left"/>
			<TextBox Grid.Column="7"
					 HorizontalContentAlignment="Left"
					 Text="{Binding ShoSh5SearchOpt.LastModifier}"/>
			<Button Grid.Column="9"
					Command="{Binding DoColSizDeployCommand}"
					Content=" 色サイズ展開補助 "/> 
			<CheckBox Grid.Column="10"
					  IsChecked="{Binding ShoSh5SearchOpt.IsAdded}"
					  Visibility="{Binding ShoSh5SearchOpt.IsAddedVis}"
					  VerticalAlignment="Center"
					  HorizontalAlignment="Center"
					  Content="追加" />
		</Grid>

		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ListBox Grid.Column="0" 
					 Margin="0,0,5,0"
					 ItemsSource="{Binding ShoSh5SearchOpt.SelectedColor1}"
					 SelectionMode="Multiple">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock>
							<TextBlock.Text>
								<MultiBinding StringFormat="{}{0} {1}">
									<Binding Path="Code" />
									<Binding Path="Name" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<ListBox Grid.Column="1"
					 Margin="5,0,0,0"
					 ItemsSource="{Binding ShoSh5SearchOpt.SelectedColor2}"
					 SelectionMode="Multiple">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock>
							<TextBlock.Text>
								<MultiBinding StringFormat="{}{0} {1}">
									<Binding Path="Code" />
									<Binding Path="Name" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<Label Grid.Column="2" 
				   FontSize="40"
				   Content="x" />

			<ListBox Grid.Column="3" 
					 Margin="0,0,5,0"
					 ItemsSource="{Binding ShoSh5SearchOpt.SelectedSiz}"
					 SelectionMode="Multiple">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock>
							<TextBlock.Text>
								<MultiBinding StringFormat="{}{0} {1}">
									<Binding Path="Code" />
									<Binding Path="Name" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<Button Grid.Column="4"
					Command="{Binding DoAddColSizCommand}"
					Content="色サイズ&#x0a;展開作成" />
		</Grid>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Label Grid.Column="0"
				   Content="↓1行もない場合、「行」の文字をダブルクリックで行追加" />
			<Button Grid.Column="2"
					Margin="5,0,0,0"
					Content="上代一括クリア" 
					Command="{Binding DoClearAllPriceCommand}"/>
			<Button Grid.Column="3"
					Margin="5,0,0,0"
					Content="中止一括ON/OFF"
					Command="{Binding DoBatchCancelToggleCommand}"/>
			<Button Grid.Column="4" 
					Margin="5,0,0,0"
					Content="配分一括マスタ依存" 
					Command="{Binding DoApplyMasterAllCommand}"/>
		</Grid>

		<uc:CvnetFlexView Grid.Row="3"
						  d:ItemsSource="{d:SampleData ItemCount=5}" 
						  ItemsSource="{Binding ShoSh5List}"
						  IsSynchronizedWithCurrentItem="True"
						  HeadersVisibility="Column"
						  GridLinesVisibility="All"
						  HorizontalGridLinesBrush="#B0B0B0"
						  VerticalGridLinesBrush="#B0B0B0"
						  BorderBrush="#707070"
						  BorderThickness="1">
			<uc:CvnetFlexView.Columns>
				<!--Line1-->
				<DataGridTemplateColumn Header="色CD" Width="0.5*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBox Text="{Binding ColorCD}"
									 Background="{Binding ColorBgColor}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!--mei1-->
				<DataGridTemplateColumn Header="色名" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBox Text="{Binding ColorName}"
									 IsReadOnly="{Binding ColorNameRO}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!--Line2-->
				<DataGridTemplateColumn Header="ｻｲｽﾞ" Width="0.5*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBox Text="{Binding SizCD}"
								 Background="{Binding SizBgColor}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!--mei2-->
				<DataGridTemplateColumn Header="ｻｲｽﾞ名" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBox Text="{Binding SizName}"
								 IsReadOnly="{Binding SizNameRO}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!--Line4-->
				<DataGridTemplateColumn Header="上代" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBox Text="{Binding Retail}" 
									 HorizontalContentAlignment="Right" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!--Line8-->
				<DataGridTemplateColumn Header="中止" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ComboBox VerticalAlignment="Top"
									  VerticalContentAlignment="Center"
									  ItemsSource="{Binding DataContext.StatusList, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									  DisplayMemberPath="Value"
									  SelectedValuePath="Key"
									  SelectedValue="{Binding IsUse}"
									  Style="{StaticResource SearchableComboBox1}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!--Line3-->
				<DataGridTemplateColumn Header="自動補充" Width="1.5*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ComboBox VerticalAlignment="Top"
									  VerticalContentAlignment="Center"
									  ItemsSource="{Binding DataContext.AutoDistList, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									  DisplayMemberPath="Value"
									  SelectedValuePath="Key"
									  SelectedValue="{Binding AutoDist}"
									  Style="{StaticResource SearchableComboBox1}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!--Line21-->
				<DataGridTextColumn Header="JAN1段目" 
									Binding="{Binding Jancode1}" 
									Width="1.2*" 
									IsReadOnly="{Binding Jancode1RO}" />
				<!--Line22-->
				<DataGridTextColumn Header="JAN2段目" 
									Binding="{Binding Jancode2}" 
									Width="1.2*" 
									IsReadOnly="{Binding Jancode2RO}" />
				<!--Line23-->
				<DataGridTemplateColumn Header="JAN3段目" Width="1.2*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBox Text="{Binding Jancode3}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn> 
			</uc:CvnetFlexView.Columns>
		</uc:CvnetFlexView>

		<Grid Grid.Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Label Grid.Column="0"
				   Content="作成日"
				   HorizontalContentAlignment="Left"/>
			<TextBox Grid.Column="1" 
					 Text="{Binding ShoSh5SearchOpt.VDateCreate}"/>

			<Label Grid.Column="2" Grid.ColumnSpan="3"  />

			<Button Grid.Column="5"
					Margin="5,0,5,0"
					Visibility="{Binding ShoSh5SearchOpt.DesideVis}"
					Command="{Binding DoConfirmCommand}"
					Content="確定(F6)" />

			<Button Grid.Column="6"
					Margin="5,0,5,0"
					Command="{Binding DoExitCommand}"
					Content="戻る(ESC)" />

		</Grid>
		
    </Grid>
</Window>
