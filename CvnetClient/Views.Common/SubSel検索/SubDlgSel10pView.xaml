<Window x:Class="CvnetClient.Views.SubDlgSel10pView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
		xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}"
		Height="450" 
		Width="510"
		Style="{StaticResource MasterWindowStyle}">
	<Window.DataContext>
		<vm:SubDlgSel10pViewModel />
	</Window.DataContext>
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="10" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="10" />
			<ColumnDefinition Width="*"  />
			<ColumnDefinition Width="10" />
		</Grid.ColumnDefinitions>
 
		<DataGrid Grid.Row="0" Grid.Column="1" 
				  IsReadOnly="True" 
				  AutoGenerateColumns="False" 
				  CanUserAddRows="False" 
				  ItemsSource="{Binding ListSel10p}"
				  SelectedItem="{Binding SelectedSel10p}"
				  HeadersVisibility="Column"
				  Style="{StaticResource WinGridData}"
				  SelectionMode="Single">
			<DataGrid.Columns>
				<DataGridTextColumn Header="ｺｰﾄ" Binding="{Binding Code}" Width="*"/>
				<DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
			</DataGrid.Columns>
		</DataGrid>

		<Grid Grid.Row="1" Grid.Column="1" >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0"
					Content="&gt;&gt;" 
					Width="40"
					Command="{Binding NextListCommand}"
					Margin="0,5,5,0"/>
			<Button Grid.Column="1" 
					Width="40"
					Content="Top"
					Command="{Binding TopListCommand}"
					Margin="0,5,15,0"/>
			<Button Grid.Column="3" 
					Width="100"  
					Content="選択実行 (Enter)" 
					Margin="0,5,5,0"
					Command="{Binding DoSearchCommand}"
					Style="{StaticResource ExecButton}"/>
			<Button Grid.Column="4" 
					Width="100"
					Margin="0,5,5,0"
					Command="{Binding DoExitCommand}"
					Content="戻る (ESC)" /> 
		</Grid> 
	</Grid>
</Window>
