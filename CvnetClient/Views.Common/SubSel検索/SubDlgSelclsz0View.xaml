<Window x:Class="CvnetClient.Views.SubDlgSelclsz0View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" 
		Height="450" 
        Width="540">
	<Window.DataContext>
		<vm:SubDlgSelclsz0ViewModel />
	</Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="5">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="3*" />
			</Grid.ColumnDefinitions> 
			<TextBox Grid.Column="0"  
					 Margin="0,0,10,0"
					 Text="{Binding Dsp1}"/>
			<TextBox Grid.Column="1"  
					 Margin="0,0,2,0"
					 Text="{Binding Dsp2}"
					 Visibility="{Binding Dsp2Visible}" />
			<TextBox Grid.Column="2" 
					 Margin="0,0,2,0"
					 Text="{Binding Dsp3}"
					 Visibility="{Binding Dsp3Visible}" />
		</Grid>

		<DataGrid Grid.Row="1" Margin="5"
				  d:ItemsSource="{d:SampleData ItemCount=5}"
				  IsReadOnly="True"
				  AutoGenerateColumns="False"
				  SelectionMode="Single"
				  ItemsSource="{Binding ListSelclsz0}"
				  SelectedItem="{Binding SelectedSelclsz0}"
				  Style="{StaticResource WinGridData}" 
				  IsSynchronizedWithCurrentItem="True">
			<DataGrid.Columns>
				<DataGridTextColumn Width="*" 
									Header="色CD" 
									Binding="{Binding ColorCD}"/>
				<DataGridTextColumn Width="*" 
									Header="色名" 
									Binding="{Binding ColorName}"/>
				<DataGridTextColumn Width="*" 
									Header="サイズCD" 
									Binding="{Binding SizeCD}"/>
				<DataGridTextColumn Width="*" 
									Header="サイズ名"
									Binding="{Binding SizeName}"/>
				<DataGridTextColumn Width="*" 
									Header="上代"
									Binding="{Binding Retail}"/>
				<DataGridTextColumn Width="*" 
									Header="JANコード"
									Binding="{Binding JanCode}"/>
			</DataGrid.Columns>
		</DataGrid>

		<StackPanel Grid.Row="2" 
					Margin="0,0,0,5" 
					HorizontalAlignment="Right">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" 
						Margin="0,0,5,0"
						Content="選択実行(Enter)"
						Command="{Binding DoExecuteCommand}"
						Style="{DynamicResource BackBtn}"/>
				<Button Grid.Column="1" 
						Margin="0,0,5,0"
						Content="戻る(ESC)"
						Command="{Binding DoExitCommand}"
						Style="{DynamicResource BackBtn}"/>
			</Grid>
		</StackPanel>

	</Grid>
</Window>
