<UserControl x:Class="CvnetClient.AdvancedSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <Grid Background="#F9F9F9" >

        <StackPanel>
            <!-- Title -->
            <TextBlock Text="Advanced search" 
                       FontSize="16" 
                       FontWeight="Bold"
                       Margin="0 0 0 8"/>

            <!-- DataGrid -->
            <DataGrid x:Name="SearchGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      Background="White"
                      Margin="0 0 0 8"
                      >

                <DataGrid.Resources>
                    <!-- Remove borders in DataGrid -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4"/>
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Background" Value="#f5f5f5"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Operator Dropdown -->
                    <DataGridTemplateColumn Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="70" 
                                          ItemsSource="{Binding Operators}" 
                                          SelectedItem="{Binding Operator}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Field Dropdown -->
                    <DataGridTemplateColumn Header="Field">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="120" 
                                          ItemsSource="{Binding Fields}" 
                                          SelectedItem="{Binding SelectedField}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Value TextBox -->
                    <DataGridTemplateColumn Header="Value">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Width="200" 
                                         Text="{Binding Value}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Delete Button -->
                    <DataGridTemplateColumn Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="DarkRed"
                                        Width="30"
                                        Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Add Row Button -->
            <Button Content="+ Add new row"
                    Width="150"
                    Height="32"
                    HorizontalAlignment="Left"
                    Background="#e9f2ff"
                    Foreground="#0078D4"
                    BorderBrush="#0078D4"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Command="{Binding AddRowCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
