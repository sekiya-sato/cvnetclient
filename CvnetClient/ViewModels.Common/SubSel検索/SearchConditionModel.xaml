<Window x:Class="CvnetClient.SearchConditionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="検索条件" Height="600" Width="900"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 検索条件 Card -->
        <materialDesign:Card Padding="16" Margin="0 0 0 16" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="検索条件"
                           Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                           Margin="0 0 0 12"/>

                <!-- 商品CD & 商品名 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="商品CD" Margin="0 8" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="8"/>
                    <TextBlock Text="～" Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Margin="8"/>

                    <TextBlock Text="商品名" Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="8"/>
                </Grid>

                <!-- 日付 + CheckBox -->
                <StackPanel Orientation="Horizontal" Margin="0 8">
                    <TextBlock Text="店頭投入日" VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <DatePicker Width="160"/>
                    <CheckBox Content="在庫" Margin="24 0"/>
                </StackPanel>

                <!-- 条件結合 -->
                <StackPanel Orientation="Horizontal" Margin="0 8">
                    <TextBlock Text="条件結合" VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <RadioButton Content="AND" IsChecked="True" Margin="0 0 16 0"/>
                    <RadioButton Content="OR"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- 条件リスト DataGrid -->
        <Grid Background="#F9F9F9" Grid.Row="1" >

            <StackPanel>
                <!-- Title -->
                <TextBlock Text="Advanced search" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Margin="0 0 0 8"/>

                <!-- DataGrid -->
                <DataGrid x:Name="SearchGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  BorderThickness="0"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  Background="White"
                  Margin="0 0 0 8"
                  >

                    <DataGrid.Resources>
                        <!-- Remove borders in DataGrid -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4"/>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Background" Value="#f5f5f5"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Operator Dropdown -->
                        <DataGridTemplateColumn Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Width="70" 
                                      ItemsSource="{Binding Operators}" 
                                      SelectedItem="{Binding Operator}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Field Dropdown -->
                        <DataGridTemplateColumn Header="Field">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Width="120" 
                                      ItemsSource="{Binding Fields}" 
                                      SelectedItem="{Binding SelectedField}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Value TextBox -->
                        <DataGridTemplateColumn Header="Value">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Width="200" 
                                     Text="{Binding Value}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Delete Button -->
                        <DataGridTemplateColumn Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="DarkRed"
                                    Width="30"
                                    Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add Row Button -->
                <Button Content="+行追加"
                Width="150"
                Height="32"
                HorizontalAlignment="Left"
                Background="#e9f2ff"
                Foreground="#0078D4"
                BorderBrush="#0078D4"
                BorderThickness="1"
                FontWeight="SemiBold"
                Command="{Binding AddRowCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
            <Button Content="🔍 検索" Style="{DynamicResource MaterialDesignContainedButton}" Margin="4"/>
            <Button Content="♻ リセット" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="4"/>
            <Button Content="❌ 閉じる" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>
