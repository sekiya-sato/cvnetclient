<UserControl x:Class="CvnetClient.ViewModels.Common.SubSel検索.SearchBuilderDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--Title="Advanced Search" Height="400" Width="600">-->

    <StackPanel Margin="20">

        <!-- Search Box -->
        <TextBox  Height="32" Margin="0 0 0 10"/>

        <!-- ItemsControl meniru row table -->
        <ItemsControl x:Name="SearchRows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0 5">
                        <!-- Operator dropdown (And/Or/Not) -->
                        <ComboBox Width="60" SelectedIndex="0" Margin="0 0 5 0">
                            <ComboBoxItem>And</ComboBoxItem>
                            <ComboBoxItem>Or</ComboBoxItem>
                            <ComboBoxItem>Not</ComboBoxItem>
                        </ComboBox>

                        <!-- Field dropdown -->
                        <ComboBox Width="120" Margin="0 0 5 0">
                            <ComboBoxItem>Any field</ComboBoxItem>
                            <ComboBoxItem>Date</ComboBoxItem>
                            <ComboBoxItem>Title</ComboBoxItem>
                        </ComboBox>

                        <!-- Value textbox -->
                        <TextBox Width="200" Margin="0 0 5 0"/>

                        <!-- Delete button -->
                        <Button Content="🗑" Width="30" Height="30" Background="Transparent"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Add new row button -->
        <Button Content="➕ Add new row" Margin="0 10 0 0" 
                Background="Transparent" Foreground="Blue"
                BorderBrush="Transparent" HorizontalAlignment="Left"/>

    </StackPanel>
</UserControl>
