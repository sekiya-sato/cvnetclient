<Window x:Class="CvnetClient.Views.SubDlg08PrnHhtlist06View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="即時移動明細書印刷" Style="{StaticResource PrintWindowStyle}">
    <Window.Resources>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg08PrnHhtlist06ViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoPrintCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!--<RowDefinition Height="Auto"/>-->
            <!-- Title -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Content -->
        <Border Grid.Row="0"
        Background="White"
        CornerRadius="12"
        Padding="30"
        BorderBrush="#dcdde1"
        BorderThickness="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Label column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Input column -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Text="移動明細書を印字します(NW7)"></TextBlock>

                <!-- バーコード -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="印刷区分:" 
               VerticalAlignment="Center" 
               Margin="0,0,20,0"/>

                    <RadioButton Grid.Column="1" Content="通常発行" 
GroupName="PrintType"
        IsChecked="{Binding Condition.SelectedPrint, 
                            Converter={StaticResource StringToBoolConverter}, 
                            ConverterParameter=通常発行, Mode=TwoWay}"
Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="2" Content="再発行" 
                 GroupName="PrintType"
                         IsChecked="{Binding Condition.SelectedPrint, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=再発行, Mode=TwoWay}"
                 Margin="0,0,20,0"/>
                </Grid>


                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0" Text="出庫元" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBox Width="150"
                                d:Text="出庫元：Data"  
                                TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="Condition.ShipmentFrom" />
                                    <Binding Path="Condition.ShipmentFromName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView MstName="移動倉庫" StyleDesign="2" 
                                            SelectedValue ="{Binding Condition.ShipmentFrom}"
                                            Command="{Binding SelShipment1Command}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBox Width="150"
                            d:Text="出庫元：Data"  
                            TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="Condition.ShipmentTo" />
                                    <Binding Path="Condition.ShipmentToName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView MstName="移動倉庫" StyleDesign="2" 
                    SelectedValue ="{Binding Condition.ShipmentTo}"
                    Command="{Binding SelShipment2Command}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0" Text="入庫先" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBox Width="150"
                                d:Text="入庫先：Data"  
                                TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="Condition.ReceiptFrom" />
                                    <Binding Path="Condition.ReceiptFromName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView MstName="移動倉庫" StyleDesign="2" 
                            SelectedValue ="{Binding Condition.ReceiptFrom}"
                            Command="{Binding SelReceipt1Command}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBox Width="150"
                                d:Text="入庫先：Data"  
                                TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="Condition.ReceiptTo" />
                                    <Binding Path="Condition.ReceiptToName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView MstName="移動倉庫" StyleDesign="2" 
                            SelectedValue ="{Binding Condition.ReceiptTo}"
                            Command="{Binding SelReceipt2Command}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0" Text="移動日" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <DatePicker Grid.Column="1" Width="180" SelectedDate="{Binding Condition.DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></DatePicker>
                    </StackPanel>
                    

                    <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,10,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0">
                        <DatePicker Grid.Column="1" Width="180" SelectedDate="{Binding Condition.DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></DatePicker>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0" Text="伝票NO" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBox Width="180"
                                 d:Text="伝票：Data" 
                                 Text="{Binding Condition.NumberFrom}"
                                 TextWrapping="Wrap">
                        </TextBox> 
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBox Width="180"
                                 d:Text="伝票：Data"  
                                 Text="{Binding Condition.NumberTo}"
                                 TextWrapping="Wrap">
                        </TextBox>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- Buttons -->

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="移動入力(即時)のデータを印刷します" VerticalAlignment="Center"></TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                   <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoPrintCommand}"/>
                    <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/> 
                </StackPanel>
            </Grid>
            
    </Grid>
</Window>
