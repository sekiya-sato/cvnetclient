<Window x:Class="CvnetClient.Views.v08HHT.SubDlg08HhtDelView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="HHT未更新データ一括削除" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="削除範囲指定" VerticalAlignment="Bottom" Margin="10,0"/>
        <Border Grid.Row="1" Grid.Column="1" BorderThickness="1" CornerRadius="8" BorderBrush="Gray" />
        <Grid Grid.Row="1"  Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="30.69"/>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="153*"/>
                <RowDefinition Height="15*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="1" Grid.Column="1" Content="処理区分"/>
            <Label Grid.Row="3" Grid.Column="1" Content="計上日"/>
            <Label Grid.Row="5" Grid.Column="1" Content="倉庫"/>

            <ComboBox Grid.Row="1" Grid.Column="2" Style="{StaticResource SearchableComboBox1}" ItemsSource="{Binding SelectKubun}" SelectedValue="{Binding Category}"/>
            <ComboBox Grid.Row="1" Grid.Column="4" Visibility="Hidden"/>

            <!--<DatePicker Grid.Row="3" Grid.Column="2" />-->
            <xctk:DateTimePicker 
                Grid.Row="3" Grid.Column="2"
                Format="Custom"
                FormatString="yyyy/MM/dd" 
                Width="180" 
                ShowButtonSpinner="True" 
                TimePickerVisibility="Collapsed" 
                AllowTextInput="False"
                Value="{Binding CreditDate1}" 
                Height="34"/>
            <Label Grid.Row="3" Grid.Column="3" Content="~" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <!--<DatePicker Grid.Row="3" Grid.Column="4"/>-->
            <xctk:DateTimePicker 
                Grid.Row="3" Grid.Column="4"
                Format="Custom"
                FormatString="yyyy/MM/dd" 
                Width="180" 
                ShowButtonSpinner="True" 
                TimePickerVisibility="Collapsed" 
                AllowTextInput="False"
                Value="{Binding CreditDate2}" 
                Height="34"/>

            <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal">
                <TextBox Width="auto" 
        TextWrapping="Wrap">
                    <TextBox.Text>
                        <MultiBinding StringFormat='{}{0} {1}'>
                            <Binding Path="WorkerTo.WorkerCD" />
                            <Binding Path="WorkerTo.Name" />
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>
                <uc:CvnetBtListView MstName="移動倉庫" StyleDesign="2" 
SelectedValue ="{Binding FindWarehouseCd1}"
Command="{Binding SelectWarehouse1Command}"/>
            </StackPanel>
            <Label Grid.Row="5" Grid.Column="3" Content="~" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="5" Grid.Column="4" Orientation="Horizontal">
                <TextBox  
        TextWrapping="Wrap">
                    <TextBox.Text>
                        <MultiBinding StringFormat='{}{0} {1}'>
                            <Binding Path="WorkerTo.WorkerCD" />
                            <Binding Path="WorkerTo.Name" />
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>
                <uc:CvnetBtListView MstName="移動倉庫" StyleDesign="2" 
SelectedValue ="{Binding FindWarehouseCd2}"
Command="{Binding SelectWarehouse2Command}"/>
            </StackPanel>

            <Grid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="0.5*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.RowSpan="5" Grid.ColumnSpan="4" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8"/>
                <Label Grid.Row="1" Grid.Column="1" Content="対象件数"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Amount}"/>
                <Label Grid.Row="2" Grid.Column="1" Content="全件数" />
                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding TotalAmount}"/>
                <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Content="削除件数確認(F5)" Command="{Binding OnBtnCheckCommand}"/>


            </Grid>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="不正データ削除" Command="{Binding DelUncorrectCommand}"/>
            <Button Grid.Column="2" Content="削除実行(F8)"  Command="{Binding AllDelCommand}" IsEnabled="{Binding CanDelete}"/>
            <Button Grid.Column="3" Style="{StaticResource BackBtn}" 
                    Command="{Binding ExitCommand}"/>
        </Grid>

    </Grid>
</Window>
