<Window x:Class="CvnetClient.Views.SubDlg08Hht1View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="HHT用マスタデータ作成(cvnetcom)" Style="{StaticResource SmallWindow}">
    <Window.Resources>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg08Hht1ViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoExecuteCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid Margin="20" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="HHT用マスタデータを作成します" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold"/>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="出力先:" HorizontalAlignment="Left" />

            <RadioButton Grid.Column="1" Content="ローカル" 
                 GroupName="OutPutType"
                 IsChecked="{Binding Condition.SelectedOutPut, 
                             Converter={StaticResource StringToBoolConverter}, 
                             ConverterParameter=Local, Mode=TwoWay}"
                 Margin="0,0,20,0"/>
            <RadioButton Grid.Column="2" Content="ハンディサーバ" 
                 GroupName="OutPutType"
                 IsChecked="{Binding Condition.SelectedOutPut, 
                              Converter={StaticResource StringToBoolConverter}, 
                              ConverterParameter=HandyServer, Mode=TwoWay}"
                 Margin="0,0,20,0"/>
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="出力方法" Visibility="{Binding Condition.ShowOrNot}" VerticalAlignment="Center"/>

            <RadioButton Grid.Column="1" Content="全件" Visibility="{Binding Condition.ShowOrNot}"
                 GroupName="OutPutHowType"
                 IsChecked="{Binding Condition.SelectedOutPutHow, 
                             Converter={StaticResource StringToBoolConverter}, 
                             ConverterParameter=All, Mode=TwoWay}"
                 Margin="0,0,20,0"/>
            <RadioButton Grid.Column="2" Content="法人縛り" Visibility="{Binding Condition.ShowOrNot}"
                 GroupName="OutPutHowType"
                 IsChecked="{Binding Condition.SelectedOutPutHow, 
                              Converter={StaticResource StringToBoolConverter}, 
                              ConverterParameter=Corporate, Mode=TwoWay}"
                 Margin="0,0,20,0"/>
        </Grid>

        <Grid Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="550">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label   Grid.Row="0"  Grid.Column="0" Content="ファイル名" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Condition.File}"/>
        </Grid>

        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding Condition.Result}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoExecuteCommand}" Content="実行(Enter)"/>
            <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
        </StackPanel>
    </Grid>
</Window>
