<Window x:Class="CvnetClient.Views.SubDlg08Hht0View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="外部連携 : HHT用PATH設定" Height="450" Width="800">

    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg08Hht0ViewModel/>
    </Window.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="ContentRendered">
            <behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="ハンディシステムのインストールフォルダを指定して、設定ボタンを押して下さい。" Foreground="Red" FontSize="16" FontWeight="Bold"/>
        <TextBox Grid.Row="2" Grid.Column="1"  Text="{Binding PathStr}"  />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Message}" Foreground="Red"/>
        <TextBox Grid.Row="4" Grid.Column="1" Grid.RowSpan="4" Height="auto" Style="{StaticResource ReadOnlyTextBox}" IsReadOnly="True" Text="{Binding HhtPath}"/>
        <Grid Grid.Row="8" Grid.Column="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button  Grid.Column="1" Content="設定" Width="90" Command="{Binding OnSetCommand}"/>
            <Button  Grid.Column="3" Style="{StaticResource BackBtn}" Command="{Binding ExitCommand}" />
        </Grid>
        
    </Grid>
</Window>
