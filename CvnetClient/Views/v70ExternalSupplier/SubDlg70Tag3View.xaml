<Window x:Class="CvnetClient.Views.SubDlg70Tag3View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:CvnetClient.ViewModels"
		xmlns:uc="clr-namespace:CvnetClient.Views"
		xmlns:util="clr-namespace:CvnetClient.Utils"
		xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="SubDlg70Tag3View" 
		Style="{StaticResource MasterWindowStyle}">
	<Window.DataContext>
		<vm:SubDlg70Tag3ViewModel />
	</Window.DataContext>
	<Window.Resources>
		<util:RdIntToBoolConverter x:Key="RdIntToBoolConverter" />
	</Window.Resources>
	<Grid Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="4*" />
			</Grid.ColumnDefinitions>
			<Label Grid.Row="0" Grid.Column="0"   
				   VerticalContentAlignment="Center"
				   Content="札種" />
			<ComboBox Grid.Row="0" Grid.Column="1"
					  VerticalAlignment="Top"
					  VerticalContentAlignment="Center"
					  ItemsSource="{Binding BillList}"
					  DisplayMemberPath="Key"
					  SelectedValuePath="Value"
					  SelectedValue="{Binding TagSearchOpt.SelBill}"
					  Style="{StaticResource SearchableComboBox1}"/>
			<Label Grid.Row="0" Grid.Column="2"   
				   VerticalContentAlignment="Center"
				   Content="伝票処理区分" />
			<ComboBox Grid.Row="0" Grid.Column="3"
					  VerticalAlignment="Top"
					  VerticalContentAlignment="Center"
					  ItemsSource="{Binding SlipCatList}"
					  DisplayMemberPath="Key"
					  SelectedValuePath="Value"
					  SelectedValue="{Binding TagSearchOpt.SelSlipCat}"
					  Style="{StaticResource SearchableComboBox1}"/>
		</Grid>

		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Label Grid.Row="0" Grid.Column="0"   
				   VerticalContentAlignment="Center"
				   Content="商品CD" />
			<TextBox Grid.Row="0" Grid.Column="1" 
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"
					 Text="{Binding TagSearchOpt.SelProdStart.Display}"/>
			<Button Grid.Row="0" Grid.Column="2" 
					Command="{Binding SelProd01Command}"
					Style="{StaticResource ComboButton}" />
			<TextBlock Grid.Row="0" Grid.Column="3" 
					   Text="～"
					   VerticalAlignment="Center"/>
			<TextBox Grid.Row="0" Grid.Column="4" 
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"
					 Text="{Binding TagSearchOpt.SelProdEnd.Display}"/>
			<Button Grid.Row="0" Grid.Column="5"
					Command="{Binding SelProd02Command}"
					Style="{StaticResource ComboButton}"/>

			<Label Grid.Row="1" Grid.Column="0"   
				   VerticalContentAlignment="Center"
				   Content="得意先" />
			<TextBox Grid.Row="1" Grid.Column="1" 
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"
					 Text="{Binding TagSearchOpt.SelCustStart.Display}"/>
			<uc:CvnetBtListView Grid.Row="1" Grid.Column="2" 
								MstName="{Binding TagSearchOpt.SelMstCust}"
								StyleDesign="2"
								SelectedValue="{Binding TagSearchOpt.SelCustStart.Code}"
								Command="{Binding SelCust01Command}"/>
			<TextBlock Grid.Row="1" Grid.Column="3" 
					   Text="～"
					   VerticalAlignment="Center"/>
			<TextBox Grid.Row="1" Grid.Column="4" 
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"
					 Text="{Binding TagSearchOpt.SelCustEnd.Display}"/>
			<uc:CvnetBtListView Grid.Row="1" Grid.Column="5" 
								MstName="{Binding TagSearchOpt.SelMstCust}"
								StyleDesign="2"
								SelectedValue="{Binding TagSearchOpt.SelCustEnd.Code}"
								Command="{Binding SelCust02Command}"/>

			<Label Grid.Row="2" Grid.Column="0"   
				   VerticalContentAlignment="Center"
				   Content="倉庫" />
			<TextBox Grid.Row="2" Grid.Column="1" 
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"
					 Text="{Binding TagSearchOpt.SelStoreStart.Display}"/>
			<uc:CvnetBtListView Grid.Row="2" Grid.Column="2" 
								MstName="{Binding TagSearchOpt.SelMstStore}"
								StyleDesign="2"
								SelectedValue="{Binding TagSearchOpt.SelStoreStart.Code}"
								Command="{Binding SelStore01Command}"/>
			<TextBlock Grid.Row="2" Grid.Column="3" 
					   Text="～"
					   VerticalAlignment="Center"/>
			<TextBox Grid.Row="2" Grid.Column="4" 					 
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"
					 Text="{Binding TagSearchOpt.SelStoreEnd.Display}"/>
			<uc:CvnetBtListView Grid.Row="2" Grid.Column="5" 
								MstName="{Binding TagSearchOpt.SelMstStore}"
								StyleDesign="2"
								SelectedValue="{Binding TagSearchOpt.SelStoreEnd.Code}"
								Command="{Binding SelStore02Command}"/>
		</Grid>

		<Grid Grid.Row="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Label Grid.Row="0" Grid.Column="0"
				   VerticalContentAlignment="Center"
				   Content="伝票NO" />
			<TextBox Grid.Row="0" Grid.Column="1"
					 TextWrapping="Wrap" />
			<TextBlock Grid.Row="0" Grid.Column="2"
					   Text="～"
					   VerticalAlignment="Center"/>
			<TextBox Grid.Row="0" Grid.Column="3"
					 TextWrapping="Wrap" />
			<Label Grid.Row="0" Grid.Column="4"   
				   VerticalContentAlignment="Center"
				   Content="在庫計上日" />
			<xctk:DateTimePicker Grid.Row="0" Grid.Column="5"
								 Value="{Binding TagSearchOpt.SelInvStartDate, Mode=TwoWay}"
								 Format="Custom"
								 FormatString="yyyy/MM/dd" />
			<TextBlock Grid.Row="0" Grid.Column="6" 
					   Text="～"
					   VerticalAlignment="Center"/>
			<xctk:DateTimePicker Grid.Row="0" Grid.Column="7"
								 Value="{Binding TagSearchOpt.SelInvEndDate, Mode=TwoWay}"
								 Format="Custom"
								 FormatString="yyyy/MM/dd" />
			<Label Grid.Row="0" Grid.Column="8"   
				   VerticalContentAlignment="Center"
				   Content="行" />
			<RadioButton Grid.Row="0" Grid.Column="9"
						 GroupName="LineOption"
						 IsChecked="{Binding TagSearchOpt.SelLineCond, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=0}"
						 Margin="0,0,5,0"
						 Content="追加" />
			<RadioButton Grid.Row="0" Grid.Column="10"
						 GroupName="LineOption"
						 IsChecked="{Binding TagSearchOpt.SelLineCond, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=1}"
						 Margin="0,0,5,0"
						 Content="新規" />
			<Button Grid.Row="0" Grid.Column="11" 
					Content="品番検索実行(F5)"
					Command="{Binding DoSearchCommand}"
					Style="{DynamicResource ExecButton}" />
		</Grid>

		<GroupBox Grid.Row="3"
				  Background="White"
				  BorderBrush="Transparent" 
				  BorderThickness="2">
			<GroupBox.Header>
				<Label FlowDirection="RightToLeft" Content="一括変更用 ※列タイトルをダブルクリック" />
			</GroupBox.Header>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Label Grid.Row="0" Grid.Column="0"   
					   VerticalContentAlignment="Center"
					   Content="変更タイトル" />
				<TextBox Grid.Row="0" Grid.Column="1"  
						 TextWrapping="Wrap" 
						 Text="{Binding TagSearchOpt.ChgTitle}"/>
				<Label Grid.Row="0" Grid.Column="2"   
					   VerticalContentAlignment="Center"
					   Content="変更内容(文字列用)" />
				<TextBox Grid.Row="0" Grid.Column="3"  
						 TextWrapping="Wrap" 
						 Text="{Binding TagSearchOpt.ChgWordCnt}"/>
				<Label Grid.Row="0" Grid.Column="4"   
					   VerticalContentAlignment="Center"
					   Content="変更内容(数値用)" />
				<TextBox Grid.Row="0" Grid.Column="5"  
						 TextWrapping="Wrap" 
						 Text="{Binding TagSearchOpt.ChgNumCnt}"/>
				<Button Grid.Row="0" Grid.Column="6"  
						Content="割合加算"
						Command="{Binding DoPercentAddCommand}"
						Style="{DynamicResource BackBtn}"/>
				<TextBox Grid.Row="0" Grid.Column="7"  
						 TextWrapping="Wrap" 
						 Text="{Binding TagSearchOpt.PercentAdd}"/>
				<Button Grid.Row="0" Grid.Column="8"  
						Content="枚数加算"
						Command="{Binding DoSheetNumCommand}"
						Style="{DynamicResource BackBtn}"/>
				<TextBox Grid.Row="0" Grid.Column="9"  
						 TextWrapping="Wrap"
						 Text="{Binding TagSearchOpt.SheetAdd}"/>
			</Grid>
		</GroupBox>

		<uc:CvnetFlexView Grid.Row="4">
			<uc:CvnetFlexView.Columns>
			</uc:CvnetFlexView.Columns>
		</uc:CvnetFlexView>

		<TextBlock Grid.Row="5"
				   Text="下札発行用CSVﾃﾞｰﾀを作成します"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>

		<Grid Grid.Row="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Label Grid.Row="0" Grid.Column="0"
				   VerticalContentAlignment="Center"
				   Content="出力先" />
			<TextBox Grid.Column="1"
					 Margin="0,0,5,0"
					 TextWrapping="Wrap"
					 Text="{Binding TagSearchOpt.OutputDest}"/>
			<TextBlock Grid.Column="2"  
					   Margin="0,0,5,0"
					   VerticalAlignment="Center"
					   Text="{Binding TagSearchOpt.OutputMess}"/>
			<Button Grid.Column="3"  
					Margin="0,0,5,0"
					Content="データ作成(Enter)"
					Command="{Binding DoExecuteCommand}"/>
			<Button Grid.Column="4"
					Margin="0,0,5,0"
					Content="戻る(ESC)"
					Command="{Binding DoCancelCommand}"/>
		</Grid>
	</Grid>
</Window>
