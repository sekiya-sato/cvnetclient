<Window x:Class="CvnetClient.Views.SubDlg70Tag3View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:CvnetClient.ViewModels"
		xmlns:uc="clr-namespace:CvnetClient.Views"
		xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="SubDlg70Tag3View" 
		Style="{StaticResource MasterWindowStyle}">
	<Window.DataContext>
		<vm:SubDlg70Tag3ViewModel />
	</Window.DataContext>
	<Grid Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="4*" />
			</Grid.ColumnDefinitions>
			<Label Grid.Row="0" Grid.Column="0"   
				   VerticalContentAlignment="Center"
				   Content="札種" />
			<ComboBox Grid.Row="0" Grid.Column="1"
					  VerticalAlignment="Top"
					  VerticalContentAlignment="Center"
					  DisplayMemberPath="Value"
					  SelectedValuePath="Key"
					  Style="{StaticResource SearchableComboBox1}"/>
			<Label Grid.Row="0" Grid.Column="2"   
				   VerticalContentAlignment="Center"
				   Content="伝票処理区分" />
			<ComboBox Grid.Row="0" Grid.Column="3"
					  VerticalAlignment="Top"
					  VerticalContentAlignment="Center"
					  DisplayMemberPath="Value"
					  SelectedValuePath="Key"
					  Style="{StaticResource SearchableComboBox1}"/>
		</Grid>

		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Label Grid.Row="0" Grid.Column="0"   
				   VerticalContentAlignment="Center"
				   Content="商品CD" />
			<TextBox Grid.Row="0" Grid.Column="1" />
			<uc:CvnetBtListView Grid.Row="0" Grid.Column="2" 
								MstName="商品"
								StyleDesign="2"/>
			<TextBlock Grid.Row="0" Grid.Column="3" 
					   Text="～"
					   VerticalAlignment="Center"/>
			<TextBox Grid.Row="0" Grid.Column="4" />
			<uc:CvnetBtListView Grid.Row="0" Grid.Column="5" 
								MstName="商品"
								StyleDesign="2"/>

			<Label Grid.Row="1" Grid.Column="0"   
				   VerticalContentAlignment="Center"
				   Content="得意先" />
			<TextBox Grid.Row="1" Grid.Column="1" />
			<uc:CvnetBtListView Grid.Row="1" Grid.Column="2" 
								MstName="店舗"
								StyleDesign="2"/>
			<TextBlock Grid.Row="1" Grid.Column="3" 
					   Text="～"
					   VerticalAlignment="Center"/>
			<TextBox Grid.Row="1" Grid.Column="4" />
			<uc:CvnetBtListView Grid.Row="1" Grid.Column="5" 
								MstName="店舗"
								StyleDesign="2"/>

			<Label Grid.Row="2" Grid.Column="0"   
				   VerticalContentAlignment="Center"
				   Content="倉庫" />
			<TextBox Grid.Row="2" Grid.Column="1" />
			<uc:CvnetBtListView Grid.Row="2" Grid.Column="2" 
								MstName="店舗"
								StyleDesign="2"/>
			<TextBlock Grid.Row="2" Grid.Column="3" 
					   Text="～"
					   VerticalAlignment="Center"/>
			<TextBox Grid.Row="2" Grid.Column="4" />
			<uc:CvnetBtListView Grid.Row="2" Grid.Column="5" 
								MstName="店舗"
								StyleDesign="2"/>
		</Grid>

		<Grid Grid.Row="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Label Grid.Row="0" Grid.Column="0"
				   VerticalContentAlignment="Center"
				   Content="伝票NO" />
			<TextBox Grid.Row="0" Grid.Column="1"
					 TextWrapping="Wrap" />
			<TextBlock Grid.Row="0" Grid.Column="2"
					   Text="～"
					   VerticalAlignment="Center"/>
			<TextBox Grid.Row="0" Grid.Column="3"
					 TextWrapping="Wrap" />
			<Label Grid.Row="0" Grid.Column="4"   
				   VerticalContentAlignment="Center"
				   Content="在庫計上日" />
			<xctk:DateTimePicker Grid.Row="0" Grid.Column="5"
								 Format="Custom"
								 FormatString="yyyy/MM/dd" />
			<TextBlock Grid.Row="0" Grid.Column="6" 
					   Text="～"
					   VerticalAlignment="Center"/>
			<xctk:DateTimePicker Grid.Row="0" Grid.Column="7"
								 Format="Custom"
								 FormatString="yyyy/MM/dd" />
			<Label Grid.Row="0" Grid.Column="8"   
				   VerticalContentAlignment="Center"
				   Content="行" />
			<RadioButton Grid.Row="0" Grid.Column="9"
						 GroupName="LineOption"
						 Margin="0,0,5,0"
						 Content="追加" />
			<RadioButton Grid.Row="0" Grid.Column="10"
						 GroupName="LineOption"
						 Margin="0,0,5,0"
						 Content="新規" />
			<Button Grid.Row="0" Grid.Column="11" 
					Content="品番検索実行(F5)"
					Style="{DynamicResource ExecButton}" />
		</Grid>

		<GroupBox Grid.Row="3"
				  Background="White"
				  BorderBrush="Transparent" 
				  BorderThickness="2">
			<GroupBox.Header>
				<Label FlowDirection="RightToLeft" Content="一括変更用 ※列タイトルをダブルクリック" />
			</GroupBox.Header>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Label Grid.Row="0" Grid.Column="0"   
					   VerticalContentAlignment="Center"
					   Content="変更タイトル" />
				<TextBox Grid.Row="0" Grid.Column="1"  
						 TextWrapping="Wrap" />
				<Label Grid.Row="0" Grid.Column="2"   
					   VerticalContentAlignment="Center"
					   Content="変更内容(文字列用)" />
				<TextBox Grid.Row="0" Grid.Column="3"  
						 TextWrapping="Wrap" />
				<Label Grid.Row="0" Grid.Column="4"   
					   VerticalContentAlignment="Center"
					   Content="変更内容(数値用)" />
				<TextBox Grid.Row="0" Grid.Column="5"  
						 TextWrapping="Wrap" />
				<Button Grid.Row="0" Grid.Column="6"  
						Content="割合加算"
						Style="{DynamicResource BackBtn}"/>
				<TextBox Grid.Row="0" Grid.Column="7"  
						 TextWrapping="Wrap" />
				<Button Grid.Row="0" Grid.Column="8"  
						Content="枚数加算"
						Style="{DynamicResource BackBtn}"/>
				<TextBox Grid.Row="0" Grid.Column="9"  
						 TextWrapping="Wrap" />
			</Grid>
		</GroupBox>

		<uc:CvnetFlexView Grid.Row="4">
			<uc:CvnetFlexView.Columns> 
			</uc:CvnetFlexView.Columns>
		</uc:CvnetFlexView>

		<TextBlock Grid.Row="5"
				   Text="下札発行用CSVﾃﾞｰﾀを作成します"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>

		<Grid Grid.Row="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Label Grid.Row="0" Grid.Column="0"   
				   VerticalContentAlignment="Center"
				   Content="出力先" />
			<TextBox Grid.Column="1"  
					 Margin="0,0,5,0"
					 TextWrapping="Wrap" />
			<TextBlock Grid.Column="2"  
					   Margin="0,0,5,0"
					   VerticalAlignment="Center"/>
			<Button Grid.Column="3"  
					Margin="0,0,5,0"
					Content="データ作成(Enter)" />
			<Button Grid.Column="4"
					Margin="0,0,5,0"
					Content="戻る(ESC)" />
		</Grid>
	</Grid>
</Window>
