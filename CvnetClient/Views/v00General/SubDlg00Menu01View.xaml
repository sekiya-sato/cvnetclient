<Window x:Class="CvnetClient.Views.SubDlg00Menu01View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="システムメンテナンス" Style="{StaticResource SmallWindow}">
    <Window.DataContext>
        <vm:SubDlg00Menu01ViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid Margin="80,30">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Content="タイマー起動確認"   Grid.Row="0" Style="{StaticResource FlexButton}" Margin="5" Command="{Binding OpenAutorunCommand}"/>
            <Button Content="ハンディ実行確認"   Grid.Row="1" Style="{StaticResource FlexButton}" Margin="5" Command="{Binding OpenRunHandyCommand}"/>
            <Button Content="ロック情報強制削除" Grid.Row="2" Style="{StaticResource FlexButton}" Margin="5" Command="{Binding OpenSubDlg13Nohin2Command}"/>
            <Button Content="データ件数確認"     Grid.Row="3" Style="{StaticResource FlexButton}" Margin="5" Command="{Binding OpenSubDlg13Nohin2Command}"/>
            <Button Content="データ初期化"      Grid.Row="4" Style="{StaticResource FlexButton}" Margin="5" Command="{Binding OpenSubDlg13Nohin2Command}"/>
            <Button Content="倉庫指定在庫再更新" Grid.Row="5" Style="{StaticResource FlexButton}" Margin="5" Command="{Binding OpenSubDlg13Nohin2Command}"/>
            <Button Content="初期投入数更新"     Grid.Row="6" Style="{StaticResource FlexButton}" Margin="5" Command="{Binding OpenUpdateSupplyCommand}"/>
            <Button Content="一時処理用"        Grid.Row="7" Style="{StaticResource FlexButton}" Margin="5" Command="{Binding OpenSubDlg13Nohin2Command}"/>
            <Button Style="{StaticResource BackBtn}" Grid.Row="8" HorizontalAlignment="Right" Command="{Binding ExitCommand}"/>
        </Grid>
            
    </Grid>
</Window>
