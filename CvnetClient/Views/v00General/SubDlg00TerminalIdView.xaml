<Window x:Class="CvnetClient.Views.SubDlg00TerminalIdView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:CvnetClient.Views"
	xmlns:vm="clr-namespace:CvnetClient.ViewModels"
    xmlns:utils="clr-namespace:CvnetClient.Utils"
    xmlns:uc="clr-namespace:CvnetClient.Views"
    mc:Ignorable="d"
	WindowStartupLocation="CenterScreen"
    Title="端末UUID設定(Felica用)" Style="{StaticResource SmallWindow}">
	<Window.Resources>
		<utils:VdateConverter x:Key="VdateConverter" />
	</Window.Resources>
	<Window.DataContext>
		<!-- where to look for those properties -->
		<vm:SubDlg00TerminalIdViewModel />
	</Window.DataContext>
	<Grid Margin="0,8,0,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="9*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="White"
		CornerRadius="12"
		Padding="10"
		BorderBrush="#dcdde1"
		BorderThickness="1"
		Margin="11,0,9,10" >
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="14*" />
					<RowDefinition />
				</Grid.RowDefinitions>

					<!-- Inner layout of the dialog -->
				<Grid Row="1" Margin="20,10,20,5">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="40"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition />
						<RowDefinition Height="20"/>
						<RowDefinition Height="Auto"/>
						
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="140"/>
						<ColumnDefinition Width="4*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<uc:CvnetBtListView Grid.Row="0" Grid.Column="0" Margin="5"
										Title="店舗CD"
											MstName="{Binding MstName}"
											StyleDesign="1"
											SelectedValue="{Binding FindShopCd}"
											Command="{Binding FindShopCommand}"/>
					<TextBox Grid.Row="0" Grid.Column="1" >
						<TextBox.Text>
							<MultiBinding StringFormat='{}{0} {1}'>
								<Binding Path="SelectCodeSetting.ShopCd"/>
								<Binding Path="SelectCodeSetting.ShopName"/>
							</MultiBinding>
						</TextBox.Text>
					</TextBox>
					<Label Grid.Row="1" Grid.Column="0" Margin="5"
										Content="新規端末ID"/>
					<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CodeLabel}" />
					<!--<uc:CvnetBtListView Grid.Row="2" Grid.Column="0" Margin="5"
								Title="登録済み端末ＩＤ"
									MstName="{Binding MstName}"
									StyleDesign="1"
									SelectedValue="{Binding SelectWorkerShop.FromWorkerShopCd}"
									Command="{Binding FindToWorkerShopCommand}"/>-->
					<uc:CvnetBtListView Grid.Row="2" Grid.Column="0" Margin="5"
						Title="標準倉庫CD"
							MstName="倉庫"
							StyleDesign="1"
							SelectedValue="{Binding FindStockCd}"
							Command="{Binding FindStockCommand }"/>
					<TextBox Grid.Row="2" Grid.Column="1" >
						<TextBox.Text>
							<MultiBinding StringFormat='{}{0} {1}'>
								<Binding Path="SelectCodeSetting.StockCd"/>
								<Binding Path="SelectCodeSetting.StockName"/>
							</MultiBinding>
						</TextBox.Text>
					</TextBox>
					<uc:CvnetBtListView Grid.Row="3" Grid.Column="0" Margin="5"
						Title="所属店舗CD"
							MstName="{Binding MstName}"
							StyleDesign="1"
							SelectedValue="{Binding SelectWorkerShop.FromWorkerShopCd}"
							Command="{Binding FindToWorkerShopCommand}" Visibility="Collapsed"/>
					<TextBox Grid.Row="3" Grid.Column="1" Visibility="Collapsed"/>
					<Grid Grid.Row="7" Grid.Column="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Margin="5" TextAlignment="Right" Text="0" Background="AliceBlue" Visibility="Hidden"/>
						<TextBlock Grid.Column="1" Margin="5" TextAlignment="Right" Text="0" Background="AliceBlue" Visibility="Hidden"/>
					</Grid>
					<Grid Grid.Row="7" Grid.Column="1">
						<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
							<Button Content="GET UUID" Style="{DynamicResource ExecButton}" Command="{Binding DoGenerateIIUDCommand}" HorizontalAlignment="Center" Margin="0,0,10,0"/>
							<Button Content="登録" Style="{DynamicResource BackBtn}" Command="{Binding DoAssignIIUDCommand}" HorizontalAlignment="Center" Margin="0,0,0,0"/>
						</StackPanel>
					</Grid>
				</Grid>
			</Grid>
		</Border>


		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="戻る(ESC)" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" HorizontalAlignment="Center" Margin="0,0,40,0"/>
		</StackPanel>


	</Grid>
</Window>
