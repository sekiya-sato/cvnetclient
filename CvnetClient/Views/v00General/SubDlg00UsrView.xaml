<Window x:Class="CvnetClient.Views.SubDlg00UsrView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
		xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
		WindowStartupLocation="CenterScreen"
        Title="社員LOGINマスタ(管理者用)" Style="{StaticResource MasterWindowStyle2}">
	<Window.Resources>
		<utils:VdateConverter x:Key="VdateConverter" />
	</Window.Resources>
	<Window.DataContext>
		<!-- where to look for those properties -->
		<vm:SubDlg01UsrViewModel />
	</Window.DataContext>
	<Window.InputBindings>
		<KeyBinding Key="F5" Command="{Binding DoListCommand}" />
		<KeyBinding Key="F6" Command="{Binding DoUpdateCommand}" />
		<KeyBinding Key="F7" Command="{Binding DoDeleteCommand}" />
		<KeyBinding Key="F8" Command="{Binding DoInsertCommand}" />
		<KeyBinding Key="F9" Command="{Binding DoPrintCommand}" />
	</Window.InputBindings>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="4*" />
			<ColumnDefinition Width="5*" />
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="1*" />
					<RowDefinition Height="1*"/>
					<RowDefinition Height="13*"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="70" />
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Label  Grid.Column="0" 
								Content="社員CD" 
								VerticalAlignment="Bottom" 
								HorizontalAlignment="Left"
								Margin="0,0,0,0"
								Visibility="Hidden"/>
						<TextBox Grid.Column="1" 
								 Margin="0,0,10,0" 
								 VerticalAlignment="Bottom"
								 Visibility="Hidden"/>

					</Grid>

				</Border>
				<Border Grid.Row="1">
					<Button Margin="10,10,10,10" 
							Style="{DynamicResource ExecButton}" 
							Command="{Binding SelDspUpdateCommand}" 
							CommandParameter="0" HorizontalAlignment="Right" 
							BorderBrush="Black" BorderThickness="10" />
				</Border>
				<Border Grid.Row="2">
					<DataGrid Grid.Row="0" x:Name="ProductGrid"
								AutoGenerateColumns="False" d:ItemsSource="{d:SampleData ItemCount=5}"
								IsReadOnly="True" GridLinesVisibility="All" 
								RowHeaderWidth="0" RowHeight="24" ColumnHeaderHeight="24"
								FontSize="12" ItemsSource="{Binding ListShohinJan}"
								SelectedItem="{Binding SelectedProduct}"
								Style="{DynamicResource WinGridData}">
						<DataGrid.Columns>
							<DataGridTextColumn Header="社員CD" 
												Binding="{Binding WorkerCD}" 
												Width="1*"/>
							<DataGridTextColumn Header="名前" 
												Binding="{Binding WorkerName}" 
												Width="2*"/>
						</DataGrid.Columns>
					</DataGrid>
				</Border>
			</Grid>
		</Border>

		<Border Grid.Column="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="10*"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Right box -->
				<GroupBox Grid.Row="0" Header="詳細">
					<Grid>
						<!-- top = form (scrollable), bottom = fillable box -->
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<!-- form -->
							<RowDefinition Height="*"/>
							<!-- box -->
						</Grid.RowDefinitions>

						<!-- === form section === -->
						<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="5">
							<StackPanel Orientation="Vertical">
								<!-- === LOGIN ID & 前回変更日 === -->
								<Grid Margin="0,5,0,0">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="4*"/>
										<ColumnDefinition Width="10"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="2*"/>
									</Grid.ColumnDefinitions>

									<Label  Grid.Row="0" Grid.Column="0" Content="LOGIN ID" />
									<TextBox Grid.Row="0" Grid.Column="1" Margin="0"/>
									<Label  Grid.Row="0" Grid.Column="3" Content="前回変更日" />
									<TextBox Grid.Row="0" Grid.Column="4" Margin="0"/>

									<Label  Grid.Row="1" Grid.Column="0" Content="LOGIN PASS" />
									<TextBox Grid.Row="1" Grid.Column="1" Margin="0"/>

									<StackPanel Grid.Row="1"
                                        Grid.Column="3"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left">
										<Button Content="ID,PASS簡易設定"
                                        Margin="10,5,5,5"
                                        Width="110" />
										<Button Content="Felica"
                                        Margin="0,5,5,5"
                                        Width="60" />
									</StackPanel>
								</Grid>

								<!-- === 有効期限 & メッセージ === -->
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="2*"/>
										<ColumnDefinition Width="10"/>
										<ColumnDefinition Width="3*"/>
									</Grid.ColumnDefinitions>
									<Label Grid.Column="0" Content="有効期限"/>
									<TextBox Grid.Column="1"/>
									<StackPanel Grid.Column="3" Margin="0,1,0,0" Orientation="Vertical">
										<TextBlock Text="※指定日時以降はLOGIN不可"/>
										<TextBlock Text="書式: YYYY/MM/DD HH24:MI:SS"/>
									</StackPanel>
								</Grid>

								<!-- === Felica初期値 & Test === -->
								<Grid Margin="0,5,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="2*"/>
										<ColumnDefinition Width="10"/>
										<ColumnDefinition Width="1*"/>
										<ColumnDefinition Width="50"/>
									</Grid.ColumnDefinitions>

									<Label Grid.Column="0" Content="Felica初期値"/>
									<ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Notyet}"
                                      DisplayMemberPath="Value"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding EditProduct.UseFlag}"
                                      Style="{StaticResource SearchableComboBox1}"/>
									<TextBox Grid.Column="3" />
									<Button Grid.Column="4" Content="Test" Margin="5,0,0,0" />
								</Grid>

								<!-- === グループCD === -->
								<Grid Margin="0,5,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="2*"/>
										<ColumnDefinition Width="10"/>
										<ColumnDefinition Width="1*"/>
										<ColumnDefinition Width="50"/>
									</Grid.ColumnDefinitions>

									<uc:CvnetBtListView Width="100"
                                                Title="グループCD" 
                                                MstName="グループ"
                                                StyleDesign="1"
                                                SelectedValue="{Binding EditSizeCd}"
                                                Command="{Binding SelSizeCommand}" />
									<TextBox Grid.Column="1" />
								</Grid>

								<!-- === アプリ管理・LCWEB管理・buttons === -->
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="100"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<!-- アプリ管理 -->
									<Label Grid.Row="0" Grid.Column="0" 
										   Content="アプリ管理"
										   Padding="3,0" 
										   VerticalAlignment="Center"/>
									<RadioButton Grid.Row="0" Grid.Column="1" 
												 GroupName="AppLogin"
												 Content="ログイン可" 
												 Margin="10,0,10,0"
												 FontStyle="Normal"/>
									<RadioButton Grid.Row="0" Grid.Column="2" 
												 GroupName="AppLogin"
												 Content="ログイン不可"
												 FontStyle="Normal"/>

									<!-- LCWEB管理 -->
									<Label Grid.Row="1" Grid.Column="0" 
										   Content="LCWEB管理"
										   Padding="3,0" 
										   VerticalAlignment="Center"/>
									<RadioButton Grid.Row="1" Grid.Column="1" 
												 GroupName="LCWebLogin"
												 Content="ログイン可" 
												 Margin="10,0,10,0"
												 FontStyle="Normal"/>
									<RadioButton Grid.Row="1" Grid.Column="2" 
												 GroupName="LCWebLogin"
												 Content="ログイン不可"
												 FontStyle="Normal"/>

									<!-- Buttons row -->
									<Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,5,0,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<Button Grid.Column="0" Content="店舗用" Margin="3,0"/>
										<Button Grid.Column="1" Content="倉庫メニュー" Margin="3,0"/>
										<Button Grid.Column="3" Content="全メニュー可" Margin="3,0"/>
										<Button Grid.Column="4" Content="全Userメニュー可" Margin="3,0"/>
										<Button Grid.Column="5" Content="全メニュー不可" Margin="3,0"/>
									</Grid>
								</Grid>
							</StackPanel>
						</ScrollViewer>

						<!-- === FILLING BOX (bottom inside GroupBox) === -->
						<Border Grid.Row="1"
                        Margin="0,8,0,0"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="3"
                        Background="#F9F9F9">
							<TextBlock Text="ここにボックスの中身"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"
                               Foreground="Gray"/>
						</Border>
					</Grid>
				</GroupBox>
				<Grid Grid.Row="1" Margin="8,8,15,8" HorizontalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="90"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="90"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="90"/>
						<ColumnDefinition Width="100"/>
						<ColumnDefinition Width="90"/>
					</Grid.ColumnDefinitions>
					<Button Content="内容修正" BorderThickness="10" Command="{Binding DoInsertCommand}"/>
					<Button Content="LOGIN不可に" Grid.Column="2" Command="{Binding DoUpdateCommand}"/>
					<Button Content="LOGIN可能に" Grid.Column="4" Command="{Binding DoDeleteCommand}"/>
					<Button Content="戻る" Grid.Column="6" Command="{Binding DoPrintCommand}"/>
				</Grid>
			</Grid>
			
		</Border>
		



	</Grid>
</Window>
