<Window
    x:Class="CvnetClient.Views.SubDlg00HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:CvnetClient.Views"
    xmlns:vm="clr-namespace:CvnetClient.ViewModels"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="{Binding Title}"
    Style="{StaticResource MasterWindowStyle}"
    mc:Ignorable="d">
    <Window.DataContext>
        <vm:SubDlg00HistoryViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <uc:CvnetFlexView
            d:ItemsSource="{d:SampleData ItemCount=5}"
            HorizontalScrollBarVisibility="Visible"
            ItemsSource="{Binding RirekiList}"
            ScrollViewer.CanContentScroll="True"
            SelectedItem="{Binding SelectedRireki}"
            VerticalScrollBarVisibility="Auto">

            <uc:CvnetFlexView.Columns>
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding LoginTime}"
                    Header="LOGIN時間" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding EmployeeCD}"
                    Header="CD" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding EmployeeName}"
                    Header="社員名" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding RemoteADDR}"
                    Header="REMOTE ADDRESS" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding LastAccessTime}"
                    Header="最終ACCESS" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Crs}"
                    Header="CRS" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Shop}"
                    Header="店" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding Bizver}"
                    Header="BizVer" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Winusername}"
                    Header="Winユーザ名" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Winmachinename}"
                    Header="Winマシン名" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Cpu}"
                    Header="CPU" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Os}"
                    Header="OS" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Mess}"
                    Header="MESS" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Httpuseragent}"
                    Header="HTTP USER AGENT" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding UserID}"
                    Header="USER ID" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding RandID}"
                    Header="RAND ID" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding SeqNo}"
                    Header="SEQ NO" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding GetKubun}"
                    Header="区分" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding StoreCD}"
                    Header="店舗CD" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding StoreName}"
                    Header="店舗名" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Tel}"
                    Header="店舗TEL" />
            </uc:CvnetFlexView.Columns>
        </uc:CvnetFlexView>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="LOGIN履歴を最新日付順に表示。" />
            <TextBox
                Grid.Column="1"
                IsEnabled="False"
                MaxLength="4"
                Text="{Binding SelectedRireki.Tel}" />
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="35"
                    Margin="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding BackPageCommand}"
                    Content="&lt;&lt;" />
                <Button
                    Width="80"
                    Margin="5"
                    Command="{Binding DoSearchCommand}"
                    Content="表示更新(F5)" />
                <Button
                    Width="35"
                    Margin="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding NextPageCommand}"
                    Content="&gt;&gt;" />
            </StackPanel>
            <Button
                Grid.Column="3"
                Width="100"
                Margin="5,0,5,0"
                HorizontalAlignment="right"
                VerticalAlignment="Center"
                Command="{Binding ToggleChkDateCommand}">

                <Button.Style>
                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                        <Setter Property="Content" Value="基準週" />

                        <Style.Triggers>
                            <!--  When ChkDate = False  -->
                            <DataTrigger Binding="{Binding SearchOpt.ChkDate}" Value="False">
                                <Setter Property="Background" Value="#FF5F5F5F" />
                            </DataTrigger>

                            <!--  When ChkDate = True  -->
                            <DataTrigger Binding="{Binding SearchOpt.ChkDate}" Value="True">
                                <Setter Property="Background" Value="#FFD0D3D4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <DatePicker
                Grid.Column="4"
                Width="180"
                Height="30"
                Margin="5,0,15,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding SearchOpt.SearchDate}" />
        </Grid>
        <Grid Grid.Row="2" Margin="10,10,10,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <CheckBox
                Grid.Column="0"
                VerticalContentAlignment="Center"
                Content="LOGIN失敗は除く"
                IsChecked="{Binding SearchOpt.ChkUserOnly}" />
            <CheckBox
                Grid.Column="1"
                VerticalContentAlignment="Center"
                Content="勤怠は除く"
                IsChecked="{Binding SearchOpt.ChkNotTN}" />
            <CheckBox
                Grid.Column="2"
                VerticalContentAlignment="Center"
                Content="Ver空白は除く"
                IsChecked="{Binding SearchOpt.ChkBizBrowser}" />
            <Button
                Grid.Column="3"
                Width="100"
                HorizontalAlignment="Left"
                Margin="20,0,0,0"
                Content="補助メニュー"/>
            <Button
                Grid.Column="4"
                Width="80"
                Margin="0,0,15,0"
                HorizontalAlignment="Right"
                Command="{Binding DoExitCommand}"
                Content="戻る(ESC)" />
        </Grid>
    </Grid>
</Window>
