<Window x:Class="CvnetClient.Views.SubDlg00CsvBaihenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
        xmlns:ie="clr-namespace:CvnetClient.Behaviors"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="上代一括変更取込" Style="{StaticResource MasterWindowStyle2}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg00CsvBaihenViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="4" Margin="10,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="店舗条件" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton Grid.Column="1" Content="AND" GroupName="List1Type"
                Margin="0,0,20,0"/>
                <RadioButton Grid.Column="2" Content="OR" GroupName="List1Type"/>
            </Grid>
            <local:ListFlexView Grid.Row="1" Margin="0" DataSource="{Binding ListFlexData}"/>

            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button Margin="1,1,6,1" Command="{Binding SearchShopCommand}" Style="{DynamicResource BackBtn}" Content="店舗検索" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="セールCD" />
                    <StackPanel  Grid.Column="1" Orientation="Horizontal" Margin="0">
                        <TextBox d:Text="セール：Data" TextWrapping="Wrap" Text="{Binding SearchCond.ItemFrom.Display}" MinWidth="180">
                        </TextBox>
                        <uc:CvnetBtListView MstName="アイテム" StyleDesign="2" 
                        SelectedValue ="{Binding SearchCond.ItemFrom.Code}"
                        Command="{Binding SelItem1Command}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker></DatePicker>
                    <Button Grid.Column="1" Margin="1,1,6,1" Command="{Binding SearchShopCommand}" Style="{DynamicResource BackBtn}" Content="店舗検索" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                    <Button Grid.Column="2" Margin="1,1,6,1" Command="{Binding SearchShopCommand}" Style="{DynamicResource BackBtn}" Content="店舗検索" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                </Grid>
                
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="プロパーセール区分:" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="1" Content="プロパー" GroupName="List3Type" Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="2" Content="セール" GroupName="List3Type"/>
                </Grid>
            </Grid>
            <DataGrid Grid.Row="1"
		     Margin="10,5,10,5" 
		     AutoGenerateColumns="False"
		     CanUserAddRows="False"
		     HeadersVisibility="Column" 
		     IsSynchronizedWithCurrentItem="True"
		     d:ItemsSource="{d:SampleData ItemCount=20}"
		     ItemsSource="{Binding InputShopList}"
		     Style="{StaticResource WinGridData}">

                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDoubleClick">
                        <ie:HeaderDoubleClickCommandAction Command="{Binding DoChkAllCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="全店" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							  VerticalAlignment="Center"
							  HorizontalAlignment="Center">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="White" />
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="店舗CD" Binding="{Binding Line1}" Width="2*" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="{x:Null}"/>
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="店舗名" Binding="{Binding Line2}" Width="2*" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="{x:Null}"/>
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="開始日" Width="3*">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsEnabled" Value="True" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Grid.Column="0" TextAlignment="Center" Text="{Binding Line3}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="終了日" Width="3*">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsEnabled" Value="True" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox TextAlignment="Center" Text="{Binding Line4}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal"
            HorizontalAlignment="Right" Margin="0,0,8,0">
                <Button Style="{DynamicResource ExecButton}" Content="実行" Margin="0,0,8,0" Command="{Binding DoPrintCommand}"/>
                <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
