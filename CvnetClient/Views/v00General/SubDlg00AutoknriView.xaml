<Window
    x:Class="CvnetClient.Views.SubDlg00AutoknriView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CvnetClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:CvnetClient.Views"
    xmlns:utils="clr-namespace:CvnetClient.Utils"
    xmlns:vm="clr-namespace:CvnetClient.ViewModels"
    Title="マスタ : 自動実行管理マスタ"
    Width="1100"
    Height="850"
    Style="{StaticResource MasterWindowStyle2}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg00AutoknriViewModel />
    </Window.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="ContentRendered">
            <behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding DoListCommand}" />
        <KeyBinding Key="F6" Command="{Binding DoUpdateCommand}" />
        <KeyBinding Key="F7" Command="{Binding DoDeleteCommand}" />
        <KeyBinding Key="F8" Command="{Binding DoInsertCommand}" />
        <KeyBinding Key="F9" Command="{Binding DoPrintCommand}" />
    </Window.InputBindings>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="10*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Margin="3"
                Padding="3"
                Background="AliceBlue"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="40" />
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>
                    <!--  Processing Number  -->
                    <Label Content="処理番号" />
                    <TextBox
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="10,0,30,0"
                        Text="{Binding ProcessingNumber}" />
                    <!--  Startup category  -->
                    <Label Grid.Row="1" Content="起動区分" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="10,0,30,0"
                        Style="{DynamicResource SearchableComboBox1}"
                        Text="{Binding StartupCategory}" />
                    <!--  Display order  -->
                    <Label Grid.Row="2" Content="表示順" />
                    <!--  Processing number order  -->
                    <RadioButton
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        Content="処理番号順"
                        FontStyle="Normal"
                        IsChecked="{Binding ProcessingNumberOrder}" />
                    <!--  Startup time order  -->
                    <RadioButton
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        Content="起動時間順"
                        FontStyle="Normal"
                        IsChecked="{Binding StartupTimeOrder}" />
                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="1,6"
                            HorizontalAlignment="Right"
                            BorderBrush="Black"
                            BorderThickness="10"
                            Command="{Binding BackListCommand}"
                            IsEnabled="{Binding CanBack}"
                            Style="{DynamicResource PrevPageBtn}" />
                        <Button
                            Margin="13,0"
                            HorizontalAlignment="Right"
                            BorderBrush="Black"
                            BorderThickness="10"
                            Command="{Binding DoListCommand}"
                            Style="{DynamicResource ExecButton}" />
                        <Button
                            Margin="1,1,6,1"
                            HorizontalAlignment="Right"
                            BorderBrush="Black"
                            BorderThickness="10"
                            Command="{Binding NextListCommand}"
                            IsEnabled="{Binding CanNext}"
                            Style="{DynamicResource NextPageBtn}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid
                Grid.Row="1"
                Margin="8"
                d:ItemsSource="{d:SampleData ItemCount=5}"
                AutoGenerateColumns="False"
                Background="#FFFFFF"
                IsReadOnly="True"
                ItemsSource="{Binding ListPrt}"
                SelectedItem="{Binding SelectedPrt}"
                SelectionMode="Single"
                Style="{DynamicResource WinGridData}">
                <DataGrid.Columns>
                    <!--  Processing number  -->
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding ProcessingNumber}"
                        Header="処理番号" />
                    <!--  Processing name  -->
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding ProcessingName}"
                        Header="処理名" />
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <Grid Grid.Column="2" Margin="10,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="9.5*" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Background="White"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <!--  Processing number  -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="処理番号" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="10,0,30,0"
                            Text="{Binding EditJidoKanri.ProcessingNumber}" />
                        <!--  priority number  -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Content="優先番号" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="10,0,30,0"
                            Text="{Binding EditJidoKanri.PriorityNumber}" />
                        <!--  Processing name  -->
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="処理名" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Margin="10,0,30,0"
                            Text="{Binding EditJidoKanri.ProcessingName}" />
                        <!--  remarks  -->
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Content="備考" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Height="80"
                            Margin="10,0,30,0"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Style="{DynamicResource NotesTextBoxPlaceholder}"
                            Text="{Binding EditJidoKanri.Remarks}"
                            TextWrapping="Wrap" />
                        <!--  Startup category  -->
                        <Label Grid.Row="3" Content="起動区分" />
                        <ComboBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="10,0,30,0"
                            Style="{DynamicResource SearchableComboBox1}"
                            Text="{Binding StartupCategory}" />
                        <!--  startup unit  -->
                        <Label
                            Grid.Row="3"
                            Grid.Column="2"
                            Content="起動単位" />
                        <ComboBox
                            Grid.Row="3"
                            Grid.Column="3"
                            Margin="10,0,30,0"
                            Style="{DynamicResource SearchableComboBox1}"
                            Text="{Binding StartupUnit}" />
                        <!--  specified date  -->
                        <Label Grid.Row="4" Content="指定日" />
                        <ComboBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="10,0,30,0"
                            Style="{DynamicResource SearchableComboBox1}"
                            Text="{Binding SpecifiedDate}" />
                        <!--  When specified  -->
                        <Label
                            Grid.Row="4"
                            Grid.Column="2"
                            Content="指定時" />
                        <ComboBox
                            Grid.Row="4"
                            Grid.Column="3"
                            Margin="10,0,30,0"
                            Style="{DynamicResource SearchableComboBox1}"
                            Text="{Binding WhenSpecified}" />
                        <!--  specified amount  -->
                        <Label
                            Grid.Row="4"
                            Grid.Column="4"
                            Content="指定分" />
                        <ComboBox
                            Grid.Row="4"
                            Grid.Column="5"
                            Margin="10,0,30,0"
                            Style="{DynamicResource SearchableComboBox1}"
                            Text="{Binding SpecifiedAmount}" />
                        <!--  start date  -->
                        <Label
                            Grid.Row="5"
                            Grid.Column="0"
                            Content="開始日" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="10,0,30,0"
                            Text="{Binding EditJidoKanri.StartDate}" />
                        <!--  end date  -->
                        <Label
                            Grid.Row="5"
                            Grid.Column="2"
                            Content="終了日" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="3"
                            Margin="10,0,30,0"
                            Text="{Binding EditJidoKanri.EndDate}" />
                        <!--  execution date  -->
                        <Label
                            Grid.Row="5"
                            Grid.Column="4"
                            Content="実行日" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="5"
                            Margin="10,0,30,0"
                            Text="{Binding EditJidoKanri.ExecutionDate}" />
                        <Border
                            Grid.Row="6"
                            Grid.ColumnSpan="6"
                            Margin="5"
                            Background="AliceBlue"
                            BorderBrush="#FFE0E0E0"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="9*" />
                                </Grid.RowDefinitions>
                                <!--  execution arguments  -->
                                <Label HorizontalAlignment="Center" Content="実行引数パラメータ設定" />
                                <Grid Grid.Row="1" Margin="20,0,20,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <!--  Parameter 1 - 10  -->
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ1" />
                                        <TextBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter01}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ2" />
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter02}" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ3" />
                                        <TextBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter03}" />
                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ4" />
                                        <TextBox
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter04}" />
                                        <Label
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ5" />
                                        <TextBox
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter05}" />
                                        <Label
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ6" />
                                        <TextBox
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter06}" />
                                        <Label
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ7" />
                                        <TextBox
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter07}" />
                                        <Label
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ8" />
                                        <TextBox
                                            Grid.Row="7"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter08}" />
                                        <Label
                                            Grid.Row="8"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ9" />
                                        <TextBox
                                            Grid.Row="8"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter09}" />
                                        <Label
                                            Grid.Row="9"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ10" />
                                        <TextBox
                                            Grid.Row="9"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            Text="{Binding EditJidoKanri.Parameter10}" />
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ11" />
                                        <TextBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter11}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ12" />
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter12}" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ13" />
                                        <TextBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter13}" />
                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ14" />
                                        <TextBox
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter14}" />
                                        <Label
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ15" />
                                        <TextBox
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter15}" />
                                        <Label
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ16" />
                                        <TextBox
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter16}" />
                                        <Label
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ17" />
                                        <TextBox
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter17}" />
                                        <Label
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ18" />
                                        <TextBox
                                            Grid.Row="7"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter18}" />
                                        <Label
                                            Grid.Row="8"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ19" />
                                        <TextBox
                                            Grid.Row="8"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter19}" />
                                        <Label
                                            Grid.Row="9"
                                            Grid.Column="0"
                                            Content="ﾊﾟﾗﾒｰﾀ20" />
                                        <TextBox
                                            Grid.Row="9"
                                            Grid.Column="1"
                                            Text="{Binding EditJidoKanri.Parameter20}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid
                            Grid.Row="7"
                            Grid.ColumnSpan="6"
                            Margin="0,0,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2.5*" />
                            </Grid.ColumnDefinitions>

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Content="作成日" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{DynamicResource ReadOnlyTextBox}"
                                Text="{Binding EditJidoKanri.VdateCreate}" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="2"
                                Content="修正日" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="3"
                                Style="{DynamicResource ReadOnlyTextBox}"
                                Text="{Binding EditJidoKanri.VdateUpdate}" />
                            <!--  Import from generic SQL  -->
                            <Button
                                Grid.Row="0"
                                Grid.Column="4"
                                Grid.ColumnSpan="2"
                                Width="150"
                                Margin="0,0,20,0"
                                HorizontalAlignment="right"
                                Content="汎用SQLから取込(F9)" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid Margin="0,0,0,0" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Button Command="{Binding DoInsertCommand}" Style="{DynamicResource AddIconBtn}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding DoUpdateCommand}"
                                Style="{DynamicResource UpdateIconBtn}" />
                            <Button
                                Grid.Column="4"
                                Command="{Binding DoDeleteCommand}"
                                Style="{DynamicResource DeleteIconBtn}" />
                            <Button
                                Grid.Column="6"
                                Command="{Binding DoPrintCommand}"
                                Style="{DynamicResource PrintIconBtn}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Button
                Grid.Row="1"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                Command="{Binding ExitCommand}"
                IsCancel="True"
                Style="{DynamicResource BackBtn}" />
        </Grid>


    </Grid>
</Window>

