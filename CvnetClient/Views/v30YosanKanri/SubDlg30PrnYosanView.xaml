<Window x:Class="CvnetClient.Views.SubDlg30PrnYosanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PrintWindowStyle}"
        Title="SubDlg30PrnYosanView">
    <Window.Resources>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg30PrnYosanViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoPrintCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid  Margin="20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.10*"/>
            <RowDefinition Height="0.65*"/>
            <RowDefinition Height="0.15*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="印刷範囲指定　(※システム設定にかかわらず対象データ範囲を印刷します)" VerticalAlignment="Bottom" Margin="10,5,5,5" />

        <Border Grid.Row="1"
        Background="White"
        CornerRadius="12"
        Padding="20,10"
        BorderBrush="#dcdde1"
        BorderThickness="1">

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.8*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.1*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"  Grid.Column="0" Text="変更日時" VerticalAlignment="Bottom" />
                <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.1*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.1*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DatePicker Grid.Column="0" Height="30" SelectedDate="{Binding SelectedDate}"/>

                    <DatePicker Grid.Column="2" Height="30" SelectedDate="{Binding StartDate}" IsEnabled="False" />
                    <TextBlock Grid.Column="3" Text="~" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <DatePicker Grid.Column="4" Height="30" SelectedDate="{Binding EndDate}" IsEnabled="False" />
                    
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.1*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.1*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock  Grid.Column="2" Grid.ColumnSpan="3" Text="（指定日が含まれる月を自動計算）" VerticalAlignment="Top" HorizontalAlignment="Right"/>

                </Grid>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="店舗" VerticalAlignment="Center" />
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.1*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
                        <TextBox MinWidth="260"  TextWrapping="Wrap" Text="{Binding SelectedShop1.Name}" IsEnabled="{Binding IsTenpo1Enabled}"/>
                        <uc:CvnetBtListView MstName="移動倉庫" StyleDesign="2" IsEnabled="{Binding IsTenpo1BtListEnabled}"
SelectedValue ="{Binding SelectedShop1.Code}"
Command="{Binding SelTenpo1Command}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBox MinWidth="260"  TextWrapping="Wrap" Text="{Binding SelectedShop2.Name}" IsEnabled="{Binding IsTenpo2Enabled}"/>
                        <uc:CvnetBtListView MstName="移動倉庫" StyleDesign="2" IsEnabled="{Binding IsTenpo2BtListEnabled}"
                SelectedValue ="{Binding SelectedShop2.Code}"
                Command="{Binding SelTenpo2Command}"/>
                    </StackPanel>
                </Grid>


                <TextBlock Grid.Row="3" Grid.Column="0" Text="ブランド" VerticalAlignment="Center" Visibility="{Binding ShowSelectBrandTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Grid Grid.Row="3" Grid.Column="1" Visibility="{Binding ShowSelectBrand, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.1*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBox MinWidth="260"  TextWrapping="Wrap" Text="{Binding SelectedBrand1.Name}"/>
                        <uc:CvnetBtListView MstName="ブランド" StyleDesign="2" 
                                            SelectedValue ="{Binding SelectedBrand1.Code}"
                                            Command="{Binding SelBrand1Command}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBox MinWidth="260"  TextWrapping="Wrap" Text="{Binding SelectedBrand2.Name}"/>
                        <uc:CvnetBtListView MstName="ブランド" StyleDesign="2" 
                                            SelectedValue ="{Binding SelectedBrand2.Code}"
                                            Command="{Binding SelBrand2Command}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="出力区分" VerticalAlignment="Center" />
                <Grid Grid.Row="4" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <!--<ColumnDefinition Width="0.5*"/>-->
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="4" BorderThickness="1" BorderBrush="#ccc" CornerRadius="3" Height="30"/>

                    <RadioButton Grid.Column="0" 
                                 Content="店舗別" 
                                 Margin="10,0,70,0"
                                 GroupName="OutputCategory" 
                                 FontStyle="Normal"
                                 Visibility="{Binding ShowShops, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsEnabled="{Binding IsShopsEnabled}"
                                 IsChecked="{Binding SelectedOutput, 
                                 Converter={StaticResource StringToBoolConverter}, 
                                 ConverterParameter=Shops, Mode=TwoWay}"/>
                    <RadioButton Grid.Column="1" 
                                 Content="ﾌﾞﾗﾝﾄﾞ別" 
                                 Margin="10,0,70,0"
                                 GroupName="OutputCategory" FontStyle="Normal"
                                 Visibility="{Binding ShowBrand, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsEnabled="{Binding IsBrandEnabled}"
                                 IsChecked="{Binding SelectedOutput, 
                                 Converter={StaticResource StringToBoolConverter}, 
                                 ConverterParameter=Brand, Mode=TwoWay}"/>
                    <RadioButton Grid.Column="2"
                                 Content="既存・新店別"  
                                 Margin="10,0,80,0"
                                 GroupName="OutputCategory" 
                                 FontStyle="Normal"
                                 Visibility="{Binding ShowExistingNewShop, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsEnabled="{Binding IsExistingNewShopEnabled}"
                                 IsChecked="{Binding SelectedOutput, 
                                 Converter={StaticResource StringToBoolConverter}, 
                                 ConverterParameter=ExistingNewShop, Mode=TwoWay}"/>
                    <RadioButton Grid.Column="3"
                                 Content="全店"  
                                 Margin="40,0,75,0"
                                 GroupName="OutputCategory" FontStyle="Normal"
                                 Visibility="{Binding ShowAllShops, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsEnabled="{Binding IsAllShopsEnabled}"
                                 IsChecked="{Binding SelectedOutput, 
                                 Converter={StaticResource StringToBoolConverter}, 
                                 ConverterParameter=AllShops, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="前年比" VerticalAlignment="Center" />
                <Grid Grid.Row="5" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="#ccc" CornerRadius="3" Height="30"/>
                    <Border Grid.Column="3" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="#ccc" CornerRadius="3" Height="30"/>

                    <RadioButton Grid.Column="0" Content="日付対比" 
GroupName="YearToYearComparison" FontStyle="Normal" Margin="10,0,0,0"
        IsChecked="{Binding SelectedYoY, 
                            Converter={StaticResource StringToBoolConverter}, 
                            ConverterParameter=Date, Mode=TwoWay}"/>
                    <RadioButton Grid.Column="1" Content="曜日対比" 
                 GroupName="YearToYearComparison" FontStyle="Normal"
                         IsChecked="{Binding SelectedYoY, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=Day, Mode=TwoWay}"/>

                    <RadioButton Grid.Column="3" Content="CSV" 
GroupName="OutputType" FontStyle="Normal" Margin="10,0,0,0"
        IsChecked="{Binding SelectedType, 
                            Converter={StaticResource StringToBoolConverter}, 
                            ConverterParameter=CSV, Mode=TwoWay}"/>
                    <RadioButton Grid.Column="4" Content="スプール" 
                 GroupName="OutputType" FontStyle="Normal"
                         IsChecked="{Binding SelectedType, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=Spool, Mode=TwoWay}"/>
                </Grid>

            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock  Grid.Row="1"  Grid.Column="0" Text="※予算を組んだ店舗のみを出力します" VerticalAlignment="Center"/>
            <TextBlock  Grid.Row="2"  Grid.Column="0" Text="   前年に予算を登録した店舗のみ前年比が表示されます。" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{DynamicResource ExecButton}" Content="実行(Enter)" Margin="0,0,8,0" Command="{Binding DoPrintCommand}"/>
                <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
