<Window
    x:Class="CvnetClient.Views.SubDlg23PrnTantouhankiView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CvnetClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:CvnetClient.Views"
    xmlns:utils="clr-namespace:CvnetClient.Utils"
    xmlns:vm="clr-namespace:CvnetClient.ViewModels"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="売上分析 : 担当別売上実績半期報"
    Background="White"
    Style="{StaticResource SmallWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg23PrnTantouhankiViewModel />
    </Window.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="ContentRendered">
            <behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="9*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="10,0,10,0"
            Padding="10"
            HorizontalAlignment="Stretch"
            BorderBrush="White"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20*" />
                </Grid.RowDefinitions>

                <GroupBox
                    Grid.Row="0"
                    Margin="10,0,10,0"
                    Background="White"
                    Header="印刷範囲指定　(※システム設定にかかわらず対象データ範囲を印刷します)">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,3"
                            VerticalAlignment="Bottom"
                            Content="掛計上日" />

                        <TextBox Grid.Column="1" Grid.ColumnSpan="2" />

                        <TextBox
                            Grid.Column="4"
                            Grid.ColumnSpan="1"
                            Margin="-10,0,0,0" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="5"
                            Margin="-10,10,0,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="～" />

                        <TextBox
                            Grid.Column="6"
                            Grid.ColumnSpan="1"
                            Margin="-10,0,0,0" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="4"
                            Grid.ColumnSpan="2"
                            Margin="-20,0,0,0"
                            HorizontalAlignment="Left"
                            Content="（指定月から6ヶ月）"
                            Foreground="#FF5F5F5F" />
                        <Label
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Content="営業担当" />

                        <Grid
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" TextWrapping="Wrap">
                                <TextBox.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="SelectShop.FromWorkerShopCd" />
                                        <Binding Path="SelectShop.FromWorkerShopName" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>

                            <uc:CvnetBtListView
                                Grid.Column="1"
                                Command="{Binding FindFromWorkerShopCommand}"
                                MstName="{Binding MstName}"
                                Param2="{Binding ChooseMenu.DeadLine}"
                                SelectedValue="{Binding SelectShop.FromWorkerShopCd}"
                                StyleDesign="2" />
                        </Grid>

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="4"
                            Margin="0,10,10,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="～" />
                        <Grid
                            Grid.Row="3"
                            Grid.Column="5"
                            Grid.ColumnSpan="3"
                            VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" TextWrapping="Wrap">
                                <TextBox.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="SelectShop.ToWorkerShopCd" />
                                        <Binding Path="SelectShop.ToWorkerShopName" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>

                            <uc:CvnetBtListView
                                Grid.Column="1"
                                Command="{Binding FindToWorkerShopCommand}"
                                MstName="{Binding MstName}"
                                Param2="{Binding ChooseMenu.DeadLine}"
                                SelectedValue="{Binding SelectShop.FromWorkerShopCd}"
                                StyleDesign="2" />
                        </Grid>
                        <Button
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Content="ブランド" />

                        <Grid
                            Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" TextWrapping="Wrap">
                                <TextBox.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="SelectShop.FromWorkerShopCd" />
                                        <Binding Path="SelectShop.FromWorkerShopName" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>

                            <uc:CvnetBtListView
                                Grid.Column="1"
                                Command="{Binding FindFromWorkerShopCommand}"
                                MstName="{Binding MstName}"
                                Param2="{Binding ChooseMenu.DeadLine}"
                                SelectedValue="{Binding SelectShop.FromWorkerShopCd}"
                                StyleDesign="2" />
                        </Grid>

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="4"
                            Margin="0,10,10,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="～" />
                        <Grid
                            Grid.Row="5"
                            Grid.Column="5"
                            Grid.ColumnSpan="3"
                            VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" TextWrapping="Wrap">
                                <TextBox.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="SelectShop.ToWorkerShopCd" />
                                        <Binding Path="SelectShop.ToWorkerShopName" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>

                            <uc:CvnetBtListView
                                Grid.Column="1"
                                Command="{Binding FindToWorkerShopCommand}"
                                MstName="{Binding MstName}"
                                Param2="{Binding ChooseMenu.DeadLine}"
                                SelectedValue="{Binding SelectShop.FromWorkerShopCd}"
                                StyleDesign="2" />
                        </Grid>

                        <Label
                            Grid.Row="7"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Content="伝票処理区分"
                            ToolTip="出荷売上の印刷か、店頭売上の印刷か、全ての印刷かを選択" />

                        <Border
                            Grid.Row="7"
                            Grid.Column="1"
                            Grid.ColumnSpan="4"
                            Margin="0,0,30,0"
                            BorderBrush="#FFD0D3D4"
                            BorderThickness="1"
                            CornerRadius="5">

                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Margin="10,0,10,0"
                                    Content="出荷売上"
                                    FontStyle="Normal"
                                    IsChecked="{Binding IsOutputUnitVoucher}"
                                    ToolTip="出荷売上" />
                                <RadioButton
                                    Margin="10,0,10,0"
                                    Content="店頭売上"
                                    FontStyle="Normal"
                                    IsChecked="{Binding IsOutputUnitProduct}"
                                    ToolTip="店頭売上" />
                                <RadioButton
                                    Margin="20,0,10,0"
                                    Content="全て"
                                    FontStyle="Normal"
                                    IsChecked="{Binding IsOutputUnitProduct}"
                                    ToolTip="全て" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="7"
                            Grid.Column="5"
                            Grid.ColumnSpan="2"
                            Margin="0,0,-10,0"
                            BorderBrush="#FFD0D3D4"
                            BorderThickness="1"
                            CornerRadius="5"
                            ToolTip="出力形式を選択">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <RadioButton
                                    Margin="10,0,10,0"
                                    Content="印刷"
                                    FontStyle="Normal"
                                    IsChecked="{Binding IsOutputWayPrint}"
                                    Visibility="Visible" />
                                <RadioButton
                                    Margin="20,0,10,0"
                                    Content="メール"
                                    FontStyle="Normal"
                                    IsChecked="{Binding IsOutputWayMail}"
                                    Visibility="Visible" />
                            </StackPanel>
                        </Border>
                        <Label
                            Grid.Row="9"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Content="出力タイプ"
                            ToolTip="担当者の出力元が売上伝票・営業担当別予算マスタかの選択" />

                        <Border
                            Grid.Row="9"
                            Grid.Column="1"
                            Grid.ColumnSpan="4"
                            Margin="0,0,30,0"
                            BorderBrush="#FFD0D3D4"
                            BorderThickness="1"
                            CornerRadius="5">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <RadioButton
                                    Margin="10,0,10,0"
                                    Content="売上伝票"
                                    FontStyle="Normal"
                                    IsChecked="{Binding IsOutputWayPrint}"
                                    ToolTip="売上伝票"
                                    Visibility="Visible" />
                                <RadioButton
                                    Margin="10,0,10,0"
                                    Content="営業担当別予算マスタ"
                                    FontStyle="Normal"
                                    IsChecked="{Binding IsOutputWayMail}"
                                    ToolTip="営業担当別予算マスタ"
                                    Visibility="Visible" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </GroupBox>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="30,0,0,0"
                VerticalAlignment="Top"
                Foreground="#FF5F5F5F"
                Text="営業担当 ：【出荷売上/店舗売上伝票】担当者&#x0a; ※伝票担当者未設定時は、得意先マスタの営業担当を参照&#x0a; 伝票処理区分 出荷売上：得意先マスタ「卸先」の【出荷・売上入力】&#x0a; 伝票処理区分 店頭売上：得意先マスタ「売仕店」の【店舗売上入力】&#x0a; ※得意先マスタ「卸先」の【店舗売上入力】は対象外&#x0a; ※得意先マスタ「売仕店」の【出荷・売上入力】は対象外" />

            <StackPanel
                Grid.Column="1"
                Margin="0,0,40,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    Margin="0,0,10,0"
                    Command="{Binding DoPrintCommand}"
                    Content="実行(ENTER)"
                    Style="{DynamicResource ExecButton}"
                    ToolTip="Enterで印刷実行" />

                <Button
                    Command="{Binding ExitCommand}"
                    Content="戻る(ESC)"
                    Style="{DynamicResource BackBtn}"
                    ToolTip="ESCでメインメニューに戻る" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
