<Window x:Class="CvnetClient.Views.ShainShoInsatuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        mc:Ignorable="d"
        Background="{DynamicResource FormMenuBg}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontSize="{DynamicResource MenuFontSize}"
        Title="社員証印刷" Height="450" Width="800">
    <Window.Resources>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:UsrlistViewModel />
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!--<RowDefinition Height="Auto"/>-->
            <!-- Title -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Content -->
        <Border Grid.Row="0"
        Background="White"
        CornerRadius="12"
        Padding="30"
        BorderBrush="#dcdde1"
        BorderThickness="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>  <!-- Label column -->
            <ColumnDefinition Width="*"/>     <!-- Input column -->
        </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                

                <TextBlock Grid.Column="0" Text="社員CD" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBox  Width="150" TextWrapping="Wrap">
                            <MultiBinding StringFormat='{}{0} {1}'>
                                <Binding Path="WorkerFrom.WorkerCD" />
                                <Binding Path="WorkerFrom.Name" />
                            </MultiBinding>
                        </TextBox>
                        <Button Content="&lt;" Command="{Binding SelWorkerCommand}" Width="20" CommandParameter="From"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBox  Width="150" TextWrapping="Wrap" >
                            <MultiBinding StringFormat='{}{0} {1}'>
                                <Binding Path="WorkerTo.WorkerCD" />
                                <Binding Path="WorkerTo.Name" />
                            </MultiBinding>
                        </TextBox>
                        <Button Content="&lt;" Command="{Binding SelWorkerCommand}" Width="20" CommandParameter="To"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0" Text="店舗CD" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBox  Width="150" TextWrapping="Wrap">
                            <MultiBinding StringFormat='{}{0} {1}'>
                                <Binding Path="ShopFrom.TradingCD" />
                                <Binding Path="ShopFrom.TradingName" />
                            </MultiBinding>
                        </TextBox>
                        <Button Content="&lt;" Command="{Binding SelShopCommand}" Width="20" CommandParameter="From"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBox  Width="150" TextWrapping="Wrap">
                            <MultiBinding StringFormat='{}{0} {1}'>
                                <Binding Path="ShopTo.TradingCD" />
                                <Binding Path="ShopTo.TradingName" />
                            </MultiBinding>
                        </TextBox>
                        <Button Content="&lt;" Command="{Binding SelShopCommand}" Width="20" CommandParameter="To"/>
                    </StackPanel>
                </Grid>
                <!-- バーコード -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Column="0" Text="バーコード:" 
               VerticalAlignment="Center" 
               Margin="0,0,20,0"/>
    <RadioButton Grid.Column="1" Content="CODE39" 
                 GroupName="BarcodeType"
                         IsChecked="{Binding SelectedBarcode, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=CODE39, Mode=TwoWay}"
                 Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="2" Content="NW7" GroupName="BarcodeType"
                         IsChecked="{Binding SelectedBarcode, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=NW7, Mode=TwoWay}"/>
</Grid>
        <!-- Info -->
        <TextBlock Grid.Row="3" Grid.Column="1"
                   Text="対応ラベル: A-one 目安 28919 (A4版2列6段)"
                   Foreground="Gray"
                   FontSize="12"
                   Margin="0,20,0,0"/>
    </Grid>
</Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Style="{DynamicResource ExecButton}" Command="{Binding DoPrintCommand}"/>
            <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
            
        </StackPanel>
    </Grid>
</Window>
