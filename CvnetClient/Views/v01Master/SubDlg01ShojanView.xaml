<Window x:Class="CvnetClient.Views.SubDlg01ShojanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
		xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
		WindowStartupLocation="CenterScreen"
        Title="商品色サイズメンテ" Style="{StaticResource MasterWindowStyle2}">
	<Window.DataContext> <!-- where to look for those properties -->
		<vm:SubDlg01ShojanViewModel />
	</Window.DataContext>
	<Window.InputBindings>
		<KeyBinding Key="F5" Command="{Binding DoListCommand}" />
		<KeyBinding Key="F6" Command="{Binding DoUpdateCommand}" />
		<KeyBinding Key="F7" Command="{Binding DoDeleteCommand}" />
		<KeyBinding Key="F8" Command="{Binding DoInsertCommand}" />
		<KeyBinding Key="F9" Command="{Binding DoPrintCommand}" />
	</Window.InputBindings>

	<!-- OUTER: top band + main area -->
	<Grid Margin="10" Background="White">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ======= TOP BAND ======================= -->
		<Border Grid.Row="0" Margin="4,0,4,8"
            Background="#FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10">
			<Grid>
				<!-- Two rows: line1 (商品CD/商品名/単価), line2 (JANコード full width) -->
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Grid Grid.Row="0" Margin="0,5,0,0">
					<Grid.ColumnDefinitions>
						<!-- Label | Field | spacer | Label | Field | spacer | Label | Field (flex) -->
						<ColumnDefinition Width="70"/>		<!-- 商品CD label -->
						<ColumnDefinition Width="4*"/>		<!-- 商品CD fixed -->
						<ColumnDefinition Width="10"/>		<!-- spacer -->
						<ColumnDefinition Width="70"/>		<!-- カラー label -->
						<ColumnDefinition Width="2*"/>		<!-- カラー fixed -->
						<ColumnDefinition Width="10"/>		<!-- spacer -->
						<ColumnDefinition Width="70"/>		<!-- サイズ label -->
						<ColumnDefinition Width="2*"/>		<!-- サイズ stretches with window -->
					</Grid.ColumnDefinitions>

					<Label Grid.Column="0" Content="商品CD" VerticalAlignment="Center" Margin="5,0,0,0"/>
					<TextBox Grid.Column="1" Margin="5,0,0,0"
							Text="{Binding FindProduct.ProductCD}" d:Text="商品CD：Data"/>

					<Label Grid.Column="3" Content="カラー" VerticalAlignment="Center"/>
					<TextBox Grid.Column="4" Margin="5,0,0,0"
							Text="{Binding FindProduct.ColorCD}" d:Text="カラー：Data"/>

					<Label Grid.Column="6" Content="サイズ" VerticalAlignment="Center"/>
					<TextBox Grid.Column="7" Margin="5,0,0,0"
							HorizontalAlignment="Stretch"   
							Text="{Binding FindProduct.SizeCD}" d:Text="サイズ：Data"/>
				</Grid>

				<Grid Grid.Row="1" Margin="0,5,0,0">
					<Grid.ColumnDefinitions>
						<!-- Label | Field1 | spacer | Field2 | spacer | Field3 (stretch) -->
						<ColumnDefinition Width="70"/>
						<!-- JAN label -->
						<ColumnDefinition Width="3*"/>
						<!-- textbox 1 -->
						<ColumnDefinition Width="3*"/>
						<!-- textbox 2 -->
						<ColumnDefinition Width="3*"/>
						<!-- textbox 3 (fills remaining space) -->
					</Grid.ColumnDefinitions>

					<!-- Label -->
					<Label Grid.Column="0"
						   Content="JAN"
						   VerticalAlignment="Center"
						   Margin="5,0,0,0"/>

					<!-- TextBox 1 -->
					<TextBox Grid.Column="1"
							 Margin="5,0,0,0"
							 Text="{Binding FindProduct.JanCode1}"
							 d:Text="JAN-1：Data"
							 TextWrapping="Wrap"/>

					<!-- TextBox 2 -->
					<TextBox Grid.Column="2"
							 Margin="0,0,0,0"
							 Text="{Binding FindProduct.JanCode2}"
							 d:Text="JAN-2：Data"
							 TextWrapping="Wrap"/>			

					<!-- TextBox 3 -->
					<TextBox Grid.Column="3"
							 Margin="0,0,0,0"
							 Text="{Binding FindProduct.JanCode3}"
							 HorizontalAlignment="Stretch"
							 d:Text="JAN-3：Data"
							 TextWrapping="Wrap"/>
				</Grid>

				<Grid Grid.Row="2">
					<Button Margin="10,6"  Style="{DynamicResource ExecButton}" Command="{Binding SelDspUpdateCommand}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10" />
				</Grid>
			</Grid>
		</Border>

		<!-- ======= MAIN AREA (2 columns: table | form) ======== -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>		<!-- LEFT: table -->
				<ColumnDefinition Width="*"/>		<!-- RIGHT: form -->
			</Grid.ColumnDefinitions>

			<!-- LEFT: TABLE -->
			<Border Margin="4" >
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="6*"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<Border Margin="4" Background="White" BorderBrush="#888" BorderThickness="1" CornerRadius="3">
						<DataGrid Grid.Row="0" x:Name="ProductGrid"
								AutoGenerateColumns="False" d:ItemsSource="{d:SampleData ItemCount=5}"
								IsReadOnly="True" GridLinesVisibility="All" 
								RowHeaderWidth="0" RowHeight="24" ColumnHeaderHeight="24"
								FontSize="12" ItemsSource="{Binding ListShohinJan}"
								SelectedItem="{Binding SelectedProduct}"
								Style="{DynamicResource WinGridData}">
							<DataGrid.Columns>
								<DataGridTextColumn Header="商品CD" Binding="{Binding ProductCD}" Width="2*"/>
								<DataGridTextColumn Header="色"     Binding="{Binding ColorCD}" Width="1*"/>
								<DataGridTextColumn Header="サイズ" Binding="{Binding SizeCD}" Width="1*"/>
								<DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="2*"/>
							</DataGrid.Columns>
						</DataGrid>
					</Border>
					<StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Top">
						<!--<Button Margin="1,6"  Style="{DynamicResource PrevPageBtn}"
								HorizontalAlignment="Right" BorderBrush="Black" 
								BorderThickness="10" Command="{Binding BackListCommand}" IsEnabled="{Binding CanBack}"/>
						<Button Margin="1,1,6,1"  Style="{DynamicResource NextPageBtn}"
								HorizontalAlignment="Right" BorderBrush="Black" 
								BorderThickness="10" Command="{Binding NextListCommand}" IsEnabled="{Binding CanNext}"/>-->
						<Button Style="{DynamicResource PrevPageBtn}" BorderThickness="10" Command="{Binding BackListCommand}"/>
						<Button Style="{DynamicResource NextPageBtn}" Grid.Column="2" Command="{Binding NextListCommand}"/>
					</StackPanel>
				</Grid>
			</Border>

			<!-- RIGHT: FORM -->
			<Border Grid.Column="1" Margin="1">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="5*"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<GroupBox Grid.Row="0" Header="詳細">
						<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
							<StackPanel Orientation="Vertical" >
								<!-- 商品CD -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="*" />
										<!--<ColumnDefinition Width="34"/>-->
									</Grid.ColumnDefinitions>
									<!--<Label Content="商品CD" Margin="0,0,8,0" VerticalAlignment="Center"/>-->
									<uc:CvnetBtListView Width="85"
											Title="商品CD" 
											MstName="商品"
											StyleDesign="1"
											SelectedValue ="{Binding EditProduct.ProductCD}"
											Command="{Binding SelProductCommand}" />
									<TextBox Grid.Column="1" Height="26" Text="{Binding EditProduct.ProductCD}" />
									<!--<TextBox.Text>
											<MultiBinding StringFormat='{}{0} {1}'>
												<Binding Path=" />
												<Binding Path="EditProduct.ProductName" />
											</MultiBinding>
										</TextBox.Text>
									</TextBox>-->
									<!--<Button Grid.Column="2" Content="≪" Height="24"/>-->
								</Grid>
								<!-- カラー -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<uc:CvnetBtListView Width="85"
											Title="カラー" 
											MstName="カラー"
											StyleDesign="1"
											SelectedValue ="{Binding EditProduct.ColorCD}"
											Command="{Binding SelColorCommand}" />
									<TextBox Grid.Column="1" Height="26" Text="{Binding EditProduct.ColorCD}" />
								</Grid>
								<!-- サイズ -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<uc:CvnetBtListView Width="85"
											Title="サイズ" 
											MstName="サイズ"
											StyleDesign="1"
											SelectedValue ="{Binding EditProduct.SizeCD}"
											Command="{Binding SelSizeCommand}" />
									<TextBox Grid.Column="1" Height="26" Text="{Binding EditProduct.SizeCD}" />
								</Grid>
								<!-- JAN -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />

									</Grid.ColumnDefinitions>
									<Label Content="JAN" Margin="0,0,0,0" VerticalAlignment="Center"/>
									<!-- JANコード1 -->
									<TextBox Grid.Column="1"
											 d:Text="JANコード1：Data"
											 Text="{Binding EditProduct.JanCode1}"
											 TextWrapping="Wrap" />		
									<!-- JANコード2 -->
									<TextBox Grid.Column="2"
											 d:Text="JANコード2：Data"
											 Text="{Binding EditProduct.JanCode2}"
											 TextWrapping="Wrap" />
									<!-- JANコード3 -->
									<TextBox Grid.Column="3"
											 d:Text="JANコード3：Data"
											 Text="{Binding EditProduct.JanCode3}"
											 TextWrapping="Wrap" />
								</Grid>
								<!-- 上代 -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>
									<Label Content="上代" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBox Grid.Column="1" Height="26" Grid.ColumnSpan="2"/>
								</Grid>
								<!-- 中止 & 生産予定数 -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>
									<Label Content="中止" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<ComboBox Grid.Column="1" Height="26" Grid.ColumnSpan="2"
											  ItemsSource="{Binding Chushi}"
											  DisplayMemberPath="Value"
											  SelectedValuePath="Key"
											  SelectedValue="{Binding EditProduct.UseFlag }" Style="{StaticResource SearchableComboBox1}"/>
									<Label Grid.Column="3" Content="生産予定数" Margin="-10,0,6,0" VerticalAlignment="Center" Visibility="Hidden" />
									<TextBox Grid.Column="4" Height="26" Visibility="Hidden"/>
								</Grid>
								<!-- 自動配分 & メモ -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>
									<Label Content="自動配分" Margin="0,0,8,0" 
										   VerticalAlignment="Center"/>
									<ComboBox Grid.Column="1" Height="26" Grid.ColumnSpan="2"
											  ItemsSource="{Binding Jidohaibun}"
											  DisplayMemberPath="Value"
											  SelectedValuePath="Key"
											  SelectedValue="{Binding EditProduct.AutoAllocationFlag}" 
											  Style="{StaticResource SearchableComboBox1}"/>
									<Label Grid.Column="3" Content="メモ" 
										   Margin="-10,0,8,0" VerticalAlignment="Center" 
										   Visibility="Hidden"/>
									<TextBox Grid.Column="4" Height="26" Visibility="Hidden"/>
								</Grid>
								<!-- 仕入価格 & 下札枚数 -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>
									<Label Content="仕入価格" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBox Grid.Column="1" Height="26" Grid.ColumnSpan="2"/>
									<Label Grid.Column="3" Content="下札枚数" Margin="-10,0,8,0" VerticalAlignment="Center" Visibility="Hidden"/>
									<TextBox Grid.Column="4" Height="26" Visibility="Hidden"/>
								</Grid>
								<!-- 原価 -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>
									<Label Content="原価" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBox Grid.Column="1" Height="26" Grid.ColumnSpan="2"/>
								</Grid>
								<!-- 外貨単価 -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>
									<Label Content="外貨単価" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBox Grid.Column="1" Height="26" Grid.ColumnSpan="2"/>
								</Grid>
								<!-- 裁断数 -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>
									<Label Content="裁断数" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBox Grid.Column="1" Height="26" Grid.ColumnSpan="2"/>
								</Grid>
								<!-- 作成日 -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>
									<Label Content="作成日" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBox Style="{StaticResource ReadOnlyTextBox}" Grid.Column="1" Height="26" Grid.ColumnSpan="2"/>
								</Grid>
								<!-- 修正日 -->
								<Grid Margin="0,2,0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="70" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>
									<Label Content="修正日" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBox Style="{StaticResource ReadOnlyTextBox}" Grid.Column="1" Height="26" Grid.ColumnSpan="2"/>
								</Grid>
								
								<!-- Button (追加、修正、削除、印刷) -->
								<!--<StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Center">
									<Button Style="{DynamicResource AddIconBtn}" Margin="20,5,20,5" Command="{Binding DoInsertCommand}"/>
									<Button Style="{DynamicResource UpdateIconBtn}" Margin="20,5,20,5" Command="{Binding DoUpdateCommand}"/>
									<Button Style="{DynamicResource DeleteIconBtn}" Margin="20,5,20,5" Command="{Binding DoDeleteCommand}"/>
									<Button Style="{DynamicResource PrintIconBtn}" Margin="20,5,20,5" Command="{Binding DoPrintCommand}"/>
								</StackPanel>-->

								<Grid Margin="8,8,15,8" HorizontalAlignment="Center">

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90"/>
										<ColumnDefinition Width="12"/>
										<ColumnDefinition Width="90"/>
										<ColumnDefinition Width="12"/>
										<ColumnDefinition Width="90"/>
										<ColumnDefinition Width="12"/>
										<ColumnDefinition Width="90"/>
									</Grid.ColumnDefinitions>

									<Button Style="{DynamicResource AddIconBtn}" BorderThickness="10" Command="{Binding DoInsertCommand}"/>
									<Button Style="{DynamicResource UpdateIconBtn}" Grid.Column="2" Command="{Binding DoUpdateCommand}"/>
									<Button Style="{DynamicResource DeleteIconBtn}" Grid.Column="4" Command="{Binding DoDeleteCommand}"/>
									<Button Style="{DynamicResource PrintIconBtn}" Grid.Column="6" Command="{Binding DoPrintCommand}"/>

								</Grid>

							</StackPanel>
						</ScrollViewer>
					</GroupBox>
					<StackPanel Grid.Row="1">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="*"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<TextBlock Grid.Row="0" Margin="0,8,0,0" TextWrapping="Wrap" Text="このメニューからの商品マスタは製造対象外です。&#10;※『商品マスタ(新規登録)』からの登録となります"/>
							<Button Grid.Row="1" Content="戻る(ESC)" Padding="16,4" HorizontalAlignment="Right" Margin="0,0,0,0"/>
						</Grid>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
