<Window x:Class="CvnetClient.Views.SubDlg01ShojanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
		xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
		WindowStartupLocation="CenterScreen"
        Title="商品色サイズメンテ" Style="{StaticResource MasterWindowStyle}">
	<Window.DataContext>
		<vm:SubDlg01ShojanViewModel />
	</Window.DataContext>

	<!-- OUTER: top band + main area -->
	<Grid Margin="10" Background="White">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ======= TOP BAND ======================= -->
		<Border Grid.Row="0" Margin="4,0,4,8"
            Background="#FFFFFF" BorderBrush="#98A0FF" BorderThickness="1" CornerRadius="6" Padding="10">
			<Grid>
				<!-- Two rows: line1 (商品CD/商品名/単価), line2 (JANコード full width) -->
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Grid Grid.Row="0" Margin="0,5,0,0">
					<Grid.ColumnDefinitions>
						<!-- Label | Field | spacer | Label | Field | spacer | Label | Field (flex) -->
						<ColumnDefinition Width="70"/>
						<!-- 商品CD label -->
						<ColumnDefinition Width="4*"/>
						<!-- 商品CD fixed -->
						<ColumnDefinition Width="10"/>
						<!-- spacer -->
						<ColumnDefinition Width="70"/>
						<!-- カラー label -->
						<ColumnDefinition Width="2*"/>
						<!-- カラー fixed -->
						<ColumnDefinition Width="10"/>
						<!-- spacer -->
						<ColumnDefinition Width="70"/>
						<!-- サイズ label -->
						<ColumnDefinition Width="2*"/>
						<!-- サイズ stretches with window -->
					</Grid.ColumnDefinitions>

					<Label Grid.Column="0" Content="商品CD" VerticalAlignment="Center" Margin="5,0,0,0"/>
					<TextBox Grid.Column="1" Margin="5,0,0,0"
				 Text="{Binding EditProduct.ProductCD}" d:Text="商品CD：Data"/>

					<Label Grid.Column="3" Content="カラー" VerticalAlignment="Center"/>
					<TextBox Grid.Column="4" Margin="5,0,0,0"
				 Text="{Binding EditProduct.MakerNo}" d:Text="カラー：Data"/>

					<Label Grid.Column="6" Content="サイズ" VerticalAlignment="Center"/>
					<TextBox Grid.Column="7" Margin="5,0,0,0"
				 HorizontalAlignment="Stretch"   
				 Text="{Binding EditProduct.MakerNo}" d:Text="サイズ：Data"/>
				</Grid>

				<Grid Grid.Row="1" Margin="0,5,0,0">
					<Grid.ColumnDefinitions>
						<!-- Label | Field1 | spacer | Field2 | spacer | Field3 (stretch) -->
						<ColumnDefinition Width="70"/>
						<!-- JAN label -->
						<ColumnDefinition Width="3*"/>
						<!-- textbox 1 -->
						<ColumnDefinition Width="3*"/>
						<!-- textbox 2 -->
						<ColumnDefinition Width="3*"/>
						<!-- textbox 3 (fills remaining space) -->
					</Grid.ColumnDefinitions>

					<!-- Label -->
					<Label Grid.Column="0"
						   Content="JAN"
						   VerticalAlignment="Center"
						   Margin="5,0,0,0"/>

					<!-- TextBox 1 -->
					<TextBox Grid.Column="1"
							 Margin="5,0,0,0"
							 Text="{Binding EditProduct.ProductCD}"
							 d:Text="JAN-1：Data"
							 TextWrapping="Wrap"/>

					<!-- TextBox 2 -->
					<TextBox Grid.Column="2"
							 Margin="0,0,0,0"
							 Text="{Binding EditProduct.ProductCD}"
							 d:Text="JAN-2：Data"
							 TextWrapping="Wrap"/>			

					<!-- TextBox 3 -->
					<TextBox Grid.Column="3"
							 Margin="0,0,0,0"
							 HorizontalAlignment="Stretch"
							 Text="{Binding EditProduct.ProductCD}"
							 d:Text="JAN-3：Data"
							 TextWrapping="Wrap"/>
				</Grid>

				<Grid Grid.Row="2">
					<Button Margin="10,6"  Style="{DynamicResource ExecButton}" Command="{Binding DoListCommand}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10" />
				</Grid>
			</Grid>
		</Border>

		<!-- ======= MAIN AREA (2 columns: table | form) ======== -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="4*"/>		<!-- LEFT: table -->
				<ColumnDefinition Width="5*"/>		<!-- RIGHT: form -->
			</Grid.ColumnDefinitions>

			<!-- LEFT: TABLE -->
			<Border Margin="4" Background="White" BorderBrush="#888" BorderThickness="1" CornerRadius="3">
				<DataGrid x:Name="ProductGrid"
                      AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" GridLinesVisibility="All"
                      RowHeaderWidth="0" RowHeight="24" ColumnHeaderHeight="24"
                      FontSize="12" ItemsSource="{Binding TableItems}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="商品CD" Binding="{Binding ProductCd}" Width="1*"/>
						<DataGridTextColumn Header="色"     Binding="{Binding Color}"     Width="1*"/>
						<DataGridTextColumn Header="サイズ" Binding="{Binding Size}"      Width="1*"/>
						<DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="1*"/>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- RIGHT: FORM -->
			<!--<GroupBox Header="詳細" Margin="10"　BorderBrush="#B3B8F0" BorderThickness="1"　Background="#CFCFFB" Padding="8">

			</GroupBox>-->
			<Border Grid.Column="1" Margin="1">
				<GroupBox Header="詳細">
					<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
						<StackPanel Orientation="Vertical" >
							<!-- 商品CD -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="34"/>
								</Grid.ColumnDefinitions>
								<Label Content="商品CD" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="1" Height="26"/>
								<Button Grid.Column="2" Content="≪" Height="24"/>
							</Grid>
							<!-- カラー -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="34"/>
								</Grid.ColumnDefinitions>
								<Label Content="カラー" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<ComboBox Grid.Column="1" Height="26"/>
								<Button Grid.Column="2" Content="≪" Height="24"/>
							</Grid>
							<!-- サイズ -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="34"/>
								</Grid.ColumnDefinitions>
								<Label Content="サイズ" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="1" Height="26"/>
								<Button Grid.Column="2" Content="≪" Height="24"/>
							</Grid>
							<!-- JAN -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="34" />
								</Grid.ColumnDefinitions>
								<Label Content="JAN" Margin="0,0,0,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="1" Height="26" 
									 Text="{Binding EditProduct.ProductCD}" />
								<TextBox Grid.Column="2" Height="26" 
									 Margin="0,0,0,0"  
									 Text="{Binding EditProduct.ProductCD}" />
								<TextBox Grid.Column="3" Height="26" 
									 Margin="0,0,0,0"  
									 Text="{Binding EditProduct.ProductCD}" />

							</Grid>
							<!-- 上代 -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="34" />
								</Grid.ColumnDefinitions>
								<Label Content="上代" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="1" Height="26"/>
							</Grid>
							<!-- 中止 & 生産予定数 -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="2*" />
									<ColumnDefinition Width="1.5*" />
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="2*" />
								</Grid.ColumnDefinitions>
								<Label Content="中止" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<ComboBox Grid.Column="1" Height="26"/>
								<Label Grid.Column="3" Content="生産予定数" Margin="-10,0,6,0" VerticalAlignment="Center" />
								<TextBox Grid.Column="4" Height="26"/>
							</Grid>
							<!-- 自動配分 & 裁断数 -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="2*" />
									<ColumnDefinition Width="1.5*" />
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="2*" />
								</Grid.ColumnDefinitions>
								<Label Content="自動配分" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<ComboBox Grid.Column="1" Height="26"/>
								<Label Grid.Column="3" Content="裁断数" Margin="-10,0,8,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="4" Height="26"/>
							</Grid>
							<!-- メモ & 下札枚数 -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="2*" />
									<ColumnDefinition Width="1.5*" />
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="2*" />
								</Grid.ColumnDefinitions>
								<Label Content="メモ" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<ComboBox Grid.Column="1" Height="26"/>
								<Label Grid.Column="3" Content="下札枚数" Margin="-10,0,8,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="4" Height="26"/>
							</Grid>
							<!-- 作成日 -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="34" />
								</Grid.ColumnDefinitions>
								<Label Content="作成日" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="1" Height="26"/>
							</Grid>
							<!-- 修正日 -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="34" />
								</Grid.ColumnDefinitions>
								<Label Content="修正日" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="1" Height="26"/>
							</Grid>



							<StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
								<Button Content="修正(F6)"  Margin="20,5,20,5" Padding="14,4"/>
								<Button Content="削除(F7)"  Margin="20,5,20,5" Padding="14,4"/>
								<Button Content="追加(F8)"  Margin="20,5,20,5" Padding="14,4"/>
								<Button Content="印刷(F9)"  Margin="20,5,20,5" Padding="14,4"/>
							</StackPanel>

							<!--<TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
									   Text="このメニューからの商品マスタは製造対象外です。&#10;※『商品マスタ(新規登録)』からの登録となります"/>
							<Button Content="戻る(ESC)" Padding="16,4" HorizontalAlignment="Right" Margin="0,8,0,0"/>-->
						</StackPanel>
					</ScrollViewer>
				</GroupBox>
			</Border>
		</Grid>
	</Grid>
</Window>
