<Window x:Class="CvnetClient.Views.SubDlg01MeiView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="名称マスタ" Style="{StaticResource MasterWindowStyle}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg01MeiViewModel/>
    </Window.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="ContentRendered">
            <behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding DoListCommand}" />
        <KeyBinding Key="F6" Command="{Binding DoUpdateCommand}" />
        <KeyBinding Key="F7" Command="{Binding DoDeleteCommand}" />
        <KeyBinding Key="F8" Command="{Binding DoInsertCommand}" />
        <KeyBinding Key="F9" Command="{Binding DoPrintCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="12"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" CornerRadius="10" BorderThickness="1"   Padding="3" Background="White" Margin="3">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>


                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="名称区分" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding ListKubun}" SelectedItem="{Binding SelectKubun}" Grid.Column="1" Style="{StaticResource SearchableComboBox1}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>


                    <Grid Grid.Row="1" Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="名称CD" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding StartCode}" Grid.Column="1"/>
                    </Grid>
                    <Button Grid.Row="2" Margin="13,6" Command="{Binding DoListCommand}" Style="{DynamicResource ExecButton}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                </Grid>


            </Border>

            <DataGrid   Grid.Row="1" Margin="8" Height="360" d:ItemsSource="{d:SampleData ItemCount=5}"
                        AutoGenerateColumns="False"
                        Style="{DynamicResource WinGridData}"
                        IsReadOnly="True"
                        ItemsSource="{Binding ListMeisho}"
                        SelectedItem="{Binding SelectedMeisho}"
                        SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="80" Binding="{Binding MeishoCd}" Header="名称CD" />
                    <DataGridTextColumn Width="*" Binding="{Binding Meisho}" Header="名称" />
                    <DataGridTextColumn Width="100" Binding="{Binding RyakuShou}" Header="略称" />
                </DataGrid.Columns>

            </DataGrid>

            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button Margin="1,6" Command="{Binding BackListCommand}" Style="{DynamicResource PrevPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                <Button Margin="1,1,6,1" Command="{Binding NextListCommand}" Style="{DynamicResource NextPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
            </StackPanel>

        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="9*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <GroupBox Background="White" BorderBrush="Transparent" BorderThickness="2" Margin="0,8,15,0">
                <GroupBox.Header>
                    <Label FlowDirection="RightToLeft">
                        詳細
                    </Label>
                </GroupBox.Header>
                <GroupBox.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="Height" Value="26.27333"/>
                        <Setter Property="Margin" Value="0,4,0,4"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="ComboBox">
                        <Setter Property="Height" Value="26.273333"/>
                        <Setter Property="Margin" Value="0,4,0,4"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style x:Key="ReadOnlyTextBox" TargetType="TextBox">
                        <Setter Property="Background" Value="#f0f0f0"/>
                        <Setter Property="Height" Value="26.273333"/>
                        <Setter Property="BorderBrush" Value="#ccc"/>
                        <Setter Property="Margin" Value="0,4,0,4"/>
                    </Style>

                </GroupBox.Resources>
                <StackPanel>

                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Content="名称区分" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{DynamicResource ReadOnlyTextBox}" Text="{Binding EditMeisho.Kubun}"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="区分一括印刷" Margin="8,0,0,0" Command="{Binding DoPrintAllCommand}"/>

                        <Label Grid.Row="1" Content="名称CD" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditMeisho.MeishoCd}" />

                        <Label Grid.Row="2" Content="名称" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditMeisho.Meisho}" />

                        <Label Grid.Row="3" Content="{Binding LabelRyakusho}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditMeisho.RyakuShou}"/>

                        <Label Grid.Row="4" Content="{Binding LabelDispFlg}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditMeisho.Rank}"/>

                        <Label Grid.Row="5" Content="{Binding LabelRenban}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EditMeisho.Renban}" />

                        <Label Grid.Row="6" Content="{Binding LabelKana}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" />

                        <Label Grid.Row="7" Content="POS区分" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EditMeisho.PosKubun}" />

                        <TextBlock Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray" Text="0 出力する, 9 削除指示, 10 出力しない"/>

                        <Label Grid.Row="9" Content="登録日時" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="9" Grid.Column="1" Style="{DynamicResource ReadOnlyTextBox}" Text="{Binding EditMeisho.VdateCreate, Converter={StaticResource VdateConverter}}" IsReadOnly="True"/>

                        <Label Grid.Row="10" Content="更新日時" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding EditMeisho.VdateUpdate, Converter={StaticResource VdateConverter}}" IsReadOnly="True" Style="{DynamicResource ReadOnlyTextBox}"/>

                        <Label Grid.Row="11" Content="最終修正者" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding EditMeisho.SaishuuShuuseiSha}" IsReadOnly="True" Style="{DynamicResource ReadOnlyTextBox}"/>
                    </Grid>

                    <!-- Button Row -->
                    <Grid Margin="8,8,15,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Style="{DynamicResource AddIconBtn}" Command="{Binding DoInsertCommand}"/>
                        <Button Style="{DynamicResource UpdateIconBtn}" Padding="0,3" Grid.Column="2" Command="{Binding DoUpdateCommand}"/>
                        <Button Style="{DynamicResource DeleteIconBtn}" Grid.Column="4" Command="{Binding DoDeleteCommand}"/>
                        <Button Style="{DynamicResource PrintIconBtn}" Grid.Column="6" Command="{Binding DoPrintCommand}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
            <Button Grid.Row="1" Margin="8" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>
        </Grid>
        
    </Grid>
</Window>
