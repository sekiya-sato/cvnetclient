<Window
    x:Class="CvnetClient.Views.SubDlg01StkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:CvnetClient.Views"
    xmlns:util="clr-namespace:CvnetClient.Utils"
    xmlns:vm="clr-namespace:CvnetClient.ViewModels"
    Title="マスタ : タックシール印刷"
    Width="900"
    Height="500"
    Style="{StaticResource MasterWindowStyle}"
    mc:Ignorable="d">
    <Window.DataContext>
        <vm:SubDlg01StkViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <util:RdIntToBoolConverter x:Key="RdIntToBoolConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,5"
            VerticalAlignment="Center"
            Text="印刷範囲指定" />

        <!--  検索条件  -->
        <Border
            Grid.Row="1"
            Margin="3"
            Padding="3"
            Background="White"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="9*" />
                    </Grid.ColumnDefinitions>

                    <!--  Radio Button Customer Or Supplier  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Orientation="Horizontal">
                        <RadioButton
                            Margin="0,0,10,0"
                            Content="得意先"
                            GroupName="CustomerSupplierSelection"
                            IsChecked="{Binding SelCustomerSupplier, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=0}" />
                        <RadioButton
                            Margin="0,0,10,0"
                            Content="仕入先"
                            GroupName="CustomerSupplierSelection"
                            IsChecked="{Binding SelCustomerSupplier, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=1}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="10"
                        Orientation="Horizontal">
                        <Label Width="80" Content="{Binding LabelRange}" />
                        <TextBox
                            Width="280"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="RangeFrom.Code" />
                                    <Binding Path="RangeFrom.Name" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>

                        <uc:CvnetBtListView
                            Width="40"
                            Command="{Binding SelRangeFromCommand}"
                            MstName="{Binding LabelRange}"
                            SelectedValue="{Binding RangeFrom.Code}"
                            Margin="-5,0"
                            StyleDesign="2" />

                        <Label Content="～" />

                        <!-- TO -->
                        <TextBox
                            Width="280"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="RangeTo.Code" />
                                    <Binding Path="RangeTo.Name" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>

                        <uc:CvnetBtListView
                            Width="40"
                            Command="{Binding SelRangeToCommand}"
                            MstName="{Binding LabelRange}"
                            SelectedValue="{Binding RangeTo.Code}"
                            Margin="-5,0"
                            StyleDesign="2" />

                    </StackPanel>

                    <!--  conditional join  -->

                    <StackPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="10"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="結合条件" />
                        <RadioButton
                            Margin="0,0,10,0"
                            Content="AND"
                            GroupName="JoinConds"
                            IsChecked="{Binding SearchOpt.SelJoinCond, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=0}" />
                        <RadioButton
                            Margin="0,0,10,0"
                            Content="OR"
                            GroupName="JoinConds"
                            IsChecked="{Binding SearchOpt.SelJoinCond, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=1}" />
                    </StackPanel>

                </Grid>
            </StackPanel>

        </Border>

        <!--  Address modifiers  -->
        <uc:ListFlexView Grid.Row="2" DataSource="{Binding ListFlexData}" />

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                Margin="10"
                VerticalAlignment="Center"
                Text="宛名修飾文字" />
            <!--  Thank you  -->
            <RadioButton
                Margin="10,0,10,0"
                Content="御中"
                GroupName="JoinOptions"
                IsChecked="{Binding SearchOpt.AddressCustomer, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=0}" />
            <!--  Mr  -->
            <RadioButton
                Margin="10,0,10,0"
                Content="様"
                GroupName="JoinOptions"
                IsChecked="{Binding SearchOpt.AddressCustomer, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=1}" />
            <!--  To  -->
            <RadioButton
                Margin="10,0,10,0"
                Content="宛"
                GroupName="JoinOptions"
                IsChecked="{Binding SearchOpt.AddressCustomer, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=2}" />
            <!--  Lord  -->
            <RadioButton
                Margin="10,0,10,0"
                Content="殿"
                GroupName="JoinOptions"
                IsChecked="{Binding SearchOpt.AddressCustomer, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=3}" />
            <RadioButton
                Margin="10,0,10,0"
                Content="なし"
                GroupName="JoinOptions"
                IsChecked="{Binding SearchOpt.AddressCustomer, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=4}" />
        </StackPanel>
        <!--  Print Size Notification  -->
        <Label
            Grid.Row="4"
            HorizontalAlignment="Center"
            Background="White"
            Content="対応ラベル：A-one 品番28919(A4版2列6段)"
            Foreground="#FFC0C0C0" />
        <!--  Action Buttons  -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,5,0"
                Command="{Binding DoPrintCommand}"
                Style="{DynamicResource ExecButton}" />
            <Button
                Margin="0,0,5,0"
                Command="{Binding DoExitCommand}"
                Style="{DynamicResource BackBtn}" />
        </StackPanel>

    </Grid>
</Window>
