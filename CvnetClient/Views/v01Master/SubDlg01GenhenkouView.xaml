<Window x:Class="CvnetClient.Views.SubDlg01GenhenkouView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        mc:Ignorable="d"
        Title="SubDlg01GenhenkouView" 
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MasterWindowStyle}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg01GenhenkouViewModel/>
    </Window.DataContext>
    <Grid>
        <TabControl BorderThickness="1" Grid.Row="0">
            <TabItem Header="検索画面(Shift+F1)" >
                <Grid MinHeight="550" MaxHeight="1000">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*" MaxHeight="380"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="0.2*"/>
                            <ColumnDefinition Width="2*"/>

                            <ColumnDefinition Width="0.2*"/>

                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="0.2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="伝票No" VerticalAlignment="Center" Margin="0,1"/>
                        <TextBox Grid.Row="0" Grid.Column="1"  Margin="0,1" Text="{Binding Condition.RecptFrom}" />
                        <Label Grid.Row="0" Grid.Column="2" Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="3"  Margin="0,1" Text="{Binding Condition.RecptFrom}"/>

                        <Label Grid.Row="0" Grid.Column="5" Content="変更日" VerticalAlignment="Center" Margin="0,1"/>
                        <xctk:DateTimePicker 
                                                Format="Custom"
                                                HorizontalAlignment="Left"
                                                FormatString="yyyy/MM/dd" 
                                                Grid.Row="0" 
                                                Grid.Column="6"
                                                MinWidth="190"
                            Height="30"
                                                ShowButtonSpinner="True" 
                                                TimePickerVisibility="Collapsed" 
                                                AllowTextInput="False"
                                                Value="{Binding Condition.DateFrom}" 
                                                Margin="0,1"/>
                        <Label Grid.Row="0" Grid.Column="7" Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                        <xctk:DateTimePicker 
                                                Format="Custom"
                                                HorizontalAlignment="Left"
                                                FormatString="yyyy/MM/dd" 
                                                Grid.Row="0"
                                                Grid.Column="8"
                                                MinWidth="190" 
                            Height="30"
                                                ShowButtonSpinner="True" 
                                                TimePickerVisibility="Collapsed" 
                                                AllowTextInput="False"
                                                Value="{Binding Condition.DateTo}" 
                                                Margin="0,1"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="商品" VerticalAlignment="Center" Margin="0,1"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding Condition.ProductFrom.Display}"/>
                            <uc:CvnetBtListView Grid.Column="1" MstName="商品" StyleDesign="2" 
    SelectedValue ="{Binding Condition.ProductFrom.Code}"
    Command="{Binding SelProduct1Command}"/>
                        </Grid>

                        <Label Grid.Row="1" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                        <Grid Grid.Row="1" Grid.Column="3" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding EditSearch.SupplierTo.Display}"/>
                            <uc:CvnetBtListView Grid.Column="1" MstName="商品" StyleDesign="2" 
        SelectedValue ="{Binding Condition.ProductTo.Code}"
        Command="{Binding SelProduct2Command}"/>
                        </Grid>

                        <Label Grid.Row="1" Grid.Column="5" Content="入力者" VerticalAlignment="Center" Margin="0,1"/>
                        <Grid Grid.Row="1" Grid.Column="6" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding Condition.StaffFrom.Display}"/>
                            <uc:CvnetBtListView Grid.Column="1" MstName="担当" StyleDesign="2" 
SelectedValue ="{Binding Condition.StaffFrom.Code}"
Command="{Binding SelStaff1Command}"/>
                        </Grid>

                        <Label Grid.Row="1" Grid.Column="7"  Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                        <Grid Grid.Row="1" Grid.Column="8" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding Condition.StaffTo.Display}"/>
                            <uc:CvnetBtListView Grid.Column="1" MstName="担当" StyleDesign="2" 
    SelectedValue ="{Binding Condition.StaffTo.Code}"
    Command="{Binding SelStaff2Command}"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,10,0,0">
                            <Button Margin="1" Command="{Binding BackListCommand}" Style="{DynamicResource PrevPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                            <Button Margin="1,1,6,1" Command="{Binding NextListCommand}" Style="{DynamicResource NextPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                        </StackPanel>
                        <Button Grid.Column="1" Margin="13,10,13,0" Command="{Binding DoListCommand}" Style="{DynamicResource ExecButton}" Content="一覧取得(F5)" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="8,3,8,10" >
                        <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" 
                                  x:Name="ListHeader"
AutoGenerateColumns="False"
Style="{DynamicResource WinGridData}"
IsReadOnly="True"
ItemsSource="{Binding ListGenka}"
SelectedItem="{Binding SelectedProduct}"
MouseDoubleClick="DataGrid_MouseDoubleClick"
VerticalAlignment="Top"
VerticalScrollBarVisibility="Visible"
d:DataContext="{d:DesignInstance Type=vm:SubDlg01GenhenkouViewModel, IsDesignTimeCreatable=True}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding ReceiptNo}" Header="伝票No" />
                                <DataGridTextColumn Width="*" Binding="{Binding EditDate}" Header="修正・登録日" />
                                <DataGridTextColumn Width="*" Binding="{Binding ChangeDate}" Header="変更日" />
                                <DataGridTextColumn Width="*" Binding="{Binding StaffIncharge}" Header="入力者" />
                                <DataGridTextColumn Width="*" Binding="{Binding StaffName}" Header="入力者名" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    
                    <Button Grid.Row="3" HorizontalAlignment="Left" Style="{DynamicResource PrintIconBtn}" Content="一覧印刷(F9)" Margin="0,0,8,0" Command="{Binding DoPrintCommand}"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource UpdateIconBtn}" Margin="0,0,8,0" Content="修正・照会(F6)" Command="{Binding RowDoubleClickCommand}"/>
                        <Button Style="{DynamicResource DeleteIconBtn}" Margin="0,0,8,0" Command="{Binding DoDeleteCommand}"/>
                        <Button  Margin="8" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="修正・登録画面(Shift+F2)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="7*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="伝票No" VerticalAlignment="Center" Margin="0,1"/>
                            <TextBox Grid.Column="1"  Margin="0,1" Text="{Binding ReceiptNo}" Style="{StaticResource ReadOnlyTextBox}"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="7*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="入力者" VerticalAlignment="Center" Margin="0,1"/>
                            <TextBox Grid.Column="1"  Margin="0,1" Text="{Binding InputStaff}" Style="{StaticResource ReadOnlyTextBox}"/>
                        </Grid>

                        <Grid Grid.Column="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="7*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="変更日" VerticalAlignment="Center" Margin="0,1"/>
                            <DatePicker
                                            Grid.Column="1" 
                                            Text="{Binding changeDate}" 
                                            Height="34"/>
                        </Grid>
                        <Grid Grid.Column="6" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="7*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding MarkupRateChange}"/>
                            <Button Grid.Column="1" Margin="1" Content="掛率一括変更" Command="{Binding AllRateChange}"/>

                        </Grid>
                        <Button Grid.Column="8" HorizontalAlignment="Center" Style="{StaticResource ExecButton}" Content="一覧取得(F5)"/>
                    </Grid>

                    <DataGrid x:Name="ListDetail" Grid.Row="2"
                    d:ItemsSource="{d:SampleData ItemCount=5}"
                    ItemsSource="{Binding ListDetailGenka}"
                    AlternationCount="999999"
                    IsSynchronizedWithCurrentItem="True"
                    HeadersVisibility="Column"                         
                    ColumnWidth="*"
                    Margin="0,2,0,6"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    GridLinesVisibility="All"
                    HorizontalGridLinesBrush="#B0B0B0"
                    VerticalGridLinesBrush="#B0B0B0"
                    BorderBrush="#707070"
                    BorderThickness="1">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" 
       BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="0.5*" MaxWidth="40">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="行" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Rownum}" Grid.ColumnSpan="2" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="0.5*" MaxWidth="40">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="更新" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"  VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="商品CD" FontWeight="Bold"/>
                                            <TextBlock Text="商品名" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="4*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Grid.ColumnSpan="2"  Text="{Binding ProductCD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
                                            <Border Grid.Row="1" Grid.ColumnSpan="2"  BorderBrush="DarkGray" BorderThickness="0,1,0,0">
                                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
                                            </Border>
                                        </Grid>


                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="メーカー品番" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="4*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Text="{Binding MakerNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="上代" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="掛率" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="4*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Grid.ColumnSpan="2"  Text="{Binding RetailPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
                                            <Border Grid.Row="1" Grid.ColumnSpan="2"  BorderBrush="DarkGray" BorderThickness="0,1,0,0">
                                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding MarkupRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="元原価" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="新原価" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="4*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Grid.ColumnSpan="2"  Text="{Binding OriCostPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
                                            <Border Grid.Row="1" Grid.ColumnSpan="2"  BorderBrush="DarkGray" BorderThickness="0,1,0,0">
                                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NewCostPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,0,0,0" Grid.RowSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Margin="1,1" Content="全てON(Shift+F3)" Command="{Binding SelectAllCommand}" />
                        <Button Grid.Column="1" Margin="1,1" Content="全てOff(Shift+F4)" Command="{Binding UnselectAllCommand}"/>
                        <Button Grid.Column="3" Margin="1,1" Content="全てクリア(Shift+F6)" Command="{Binding AllClearCommand}"/>

                        <StackPanel Grid.Column="6" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <Button Grid.Column="5" Margin="1,0" Style="{DynamicResource UpdateIconBtn}" Command="{Binding DoUpdateCommand}"/>
                            <Button Grid.Column="6" Margin="1,0" Style="{DynamicResource AddIconBtn}" Command="{Binding DoInsertCommand}"/>
                        </StackPanel>

                        <Button Grid.Column="8" Content="一覧へ(ESC)" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

            </TabItem>
        </TabControl>
    </Grid>
</Window>
