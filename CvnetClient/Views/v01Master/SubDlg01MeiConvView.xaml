<Window x:Class="CvnetClient.Views.SubDlg01MeiConvView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        mc:Ignorable="d"
        Title="名称マスタコピー作成" Style="{StaticResource MasterWindowStyle}">
    <Window.DataContext>
        <vm:SubDlg01MeiConvViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoCopyCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4.5*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="9.5*"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="コピー元"></Label>

                <DataGrid   Grid.Row="1" Margin="8"  d:ItemsSource="{d:SampleData ItemCount=5}"
            AutoGenerateColumns="False"
            Style="{DynamicResource WinGridData}"
            IsReadOnly="True"
            ItemsSource="{Binding CopyFrom}"
            SelectedItem="{Binding SelectedCopyFrom}"
                            HeadersVisibility="None"
            SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Title}" />
                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⇒" FontSize="100" FontFamily="Segoe UI Symbol"
               VerticalAlignment="Center" HorizontalAlignment="Center"
               Foreground="Black">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1" To="1.3" Duration="0:0:0.6" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1" To="1.3" Duration="0:0:0.6" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                    <TextBlock.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
            
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="9.5*"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="コピー先"></Label>

                <DataGrid   Grid.Row="1" Margin="8" d:ItemsSource="{d:SampleData ItemCount=5}"
                            AutoGenerateColumns="False"
                            Style="{DynamicResource WinGridData}"
                            IsReadOnly="True"
                            ItemsSource="{Binding CopyTo}"
                            SelectedItem="{Binding SelectedCopyTo}"
                            HeadersVisibility="None"
                            SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Title}" />
                    </DataGrid.Columns>

                </DataGrid>

            </Grid>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderThickness="1" BorderBrush="Transparent" Margin="10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="※名称マスタに対象テーブルからコピーします。"></TextBlock>
                    <TextBlock Grid.Row="1" Text="※コピー元・コピー先に間違いないか、再度確認ください"></TextBlock>
                    <TextBlock Grid.Row="2" Text="※実行後、元に戻すことはできません"></TextBlock>
                </Grid>
                
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10" Orientation="Horizontal">
                <Button Style="{DynamicResource ExecButton}" Content="コピー実行" Margin="5" Command="{Binding DoCopyCommand}"></Button>
                <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" Margin="5"></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
