                                            SelectedValue="{Binding EditSupplier.SupplierCD, Mode=TwoWay}" />

                                        <TextBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd01}" />

                                        <uc:CvnetBtListView
                                            Title="名称CD02"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="90"
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            Command=""
                                            SelectedValue="" />

                                        <TextBox
                                            Grid.Row="0"
                                            Grid.Column="3"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd02}" />

                                        <uc:CvnetBtListView
                                            Title="名称CD03"
                                            Grid.Row="1"
                                            Width="90"
                                            Margin="10"
                                            HorizontalAlignment="Left"
                                            Command=""
                                            SelectedValue="" />

                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd03}" />

                                        <uc:CvnetBtListView
                                            Title="名称CD04"
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="90"
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            Command=""
                                            SelectedValue="" />

                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd04}" />

                                        <uc:CvnetBtListView
                                            Title="名称CD05"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Width="90"
                                            Margin="10"
                                            HorizontalAlignment="Left"
                                            Command=""
                                            SelectedValue="" />

                                        <TextBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd05}" />

                                        <uc:CvnetBtListView
                                            Title="名称CD06"
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Width="90"
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            Command=""
                                            SelectedValue="" />

                                        <TextBox
                                            Grid.Row="2"
                                            Grid.Column="3"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd06}" />

                                        <uc:CvnetBtListView
                                            Title="名称CD07"
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Width="90"
                                            Margin="10"
                                            HorizontalAlignment="Left"
                                            Command=""
                                            SelectedValue="" />

                                        <TextBox
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd07}" />

                                        <uc:CvnetBtListView
                                            Title="名称CD08"
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Width="90"
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            Command=""
                                            SelectedValue="" />

                                        <TextBox
                                            Grid.Row="3"
                                            Grid.Column="3"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd08}" />

                                        <uc:CvnetBtListView
                                            Title="名称CD09"
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Width="90"
                                            Margin="10"
                                            HorizontalAlignment="Left"
                                            Command=""
                                            SelectedValue="" />

                                        <TextBox
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd09}" />

                                        <uc:CvnetBtListView
                                            Title="名称CD10"
                                            Grid.Row="4"
                                            Grid.Column="2"
                                            Width="90"
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            Command=""
                                            SelectedValue="" />

                                        <TextBox
                                            Grid.Row="4"
                                            Grid.Column="3"
                                            Margin="0,5"
                                            Text="{Binding EditSupplier.NameCd10}" />

                                        <Label
                                            Grid.Row="5"
                                            Margin="0,5"
                                            VerticalAlignment="Center"
                                            Content="生産FLG" />
                                        <!--  production FLG  -->
                                        <TextBox
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Width="80"
                                            Margin="0,5"
                                            HorizontalAlignment="Left"
                                            Text="{Binding EditSupplier.ProductionFlag}" />

                                        <Grid Grid.Row="6" Grid.ColumnSpan="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2*" />
                                                <RowDefinition Height="15*" />
                                                <RowDefinition Height="2*" />
                                                <RowDefinition Height="15*" />
                                            </Grid.RowDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                Margin="0,5"
                                                VerticalAlignment="Center"
                                                Content="備考1" />
                                            <!--  remarks  -->
                                            <TextBox
                                                Grid.Row="1"
                                                Height="80"
                                                Margin="10,0,10,0"
                                                VerticalContentAlignment="Top"
                                                AcceptsReturn="True"
                                                Style="{DynamicResource NotesTextBoxPlaceholder}"
                                                Tag="Write Here..."
                                                Text="{Binding EditSupplier.Remarks}"
                                                TextWrapping="Wrap" />

                                            <Label
                                                Grid.Row="2"
                                                Margin="0,5"
                                                VerticalAlignment="Center"
                                                Content="備考2" />
                                            <TextBox
                                                Grid.Row="3"
                                                Height="80"
                                                Margin="10,0,10,0"
                                                VerticalContentAlignment="Top"
                                                AcceptsReturn="True"
                                                Style="{DynamicResource NotesTextBoxPlaceholder}"
