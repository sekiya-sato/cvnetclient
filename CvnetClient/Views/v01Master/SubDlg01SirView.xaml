                        </TabControl>
                        <Grid Grid.Row="1" Margin="8,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Button Command="{Binding DoUpdateCommand}" Style="{DynamicResource UpdateIconBtn}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding DoDeleteCommand}"
                                Style="{DynamicResource DeleteIconBtn}" />
                            <Button
                                Grid.Column="4"
                                Command="{Binding DoInsertCommand}"
                                Style="{DynamicResource AddIconBtn}" />
                            <Button
                                Grid.Column="6"
                                Command="{Binding DoPrintCommand}"
                                Style="{DynamicResource PrintIconBtn}" />
                        </Grid>
                    </Grid>

                </Border>

                <Button
                    Grid.Row="2"
                    Margin="8"
                    HorizontalAlignment="Right"
                    Command="{Binding ExitCommand}"
                    IsCancel="True"
                    Style="{DynamicResource BackBtn}" />
            </Grid>
        </Border>

    </Grid>
</Window>
