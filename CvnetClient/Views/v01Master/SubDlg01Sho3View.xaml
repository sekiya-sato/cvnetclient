<Window x:Class="CvnetClient.Views.SubDlg01Sho3View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        Title="商品マスタ"
        mc:Ignorable="d"
        FontFamily="Meiryo UI"
        Width="1440"
        Height="1000"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MasterWindowStyle2}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg01Sho2ViewModel />
    </Window.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="ContentRendered">
            <behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="9*" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"  
				   Margin="5,0,0,0"
				   VerticalContentAlignment="Center"
				   Content="商品CD" />
                <TextBox Grid.Column="1"
					 Text="{Binding SelProductCd}"
                         HorizontalAlignment="Center"
					 MinWidth="100"/>
                <Button Grid.Column="3"
					Width="35" 
					VerticalAlignment="Center"
					HorizontalAlignment="Right" 
                    
					Content="&lt;&lt;" />
                <Button Grid.Column="4"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Command="{Binding SelDspUpdateCommand}"
					Content=" 表示更新(F5) "
                    Style="{StaticResource ExecButton}"
                    Margin="2,0"/>
                <Button Grid.Column="5"
					Width="35" 
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Margin="0,0,15,0"
					Content="&gt;&gt;" />

            </Grid>


            <DataGrid Grid.Row="1" Grid.Column="0"
                  Margin="0,0,10,0"
				  AutoGenerateColumns="False"
				  HeadersVisibility="Column"
				  IsReadOnly="True"
				  IsSynchronizedWithCurrentItem="True"
				  d:ItemsSource="{d:SampleData ItemCount=5}"
				  ItemsSource="{Binding ListProduct}"
				  SelectedItem="{Binding SelectedProduct}"  
                  Style="{StaticResource WinGridData}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="商品CD" Binding="{Binding ProductCD}" Width="4*" />
                    <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="6*" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
					 VerticalAlignment="Center" 
					 HorizontalAlignment="Right"
					 Width="50" />
                <Label Grid.Column="1"
				   VerticalAlignment="Center"  
				   Content="/"
				   VerticalContentAlignment="Center"/>
                <TextBox Grid.Column="2"
					 VerticalAlignment="Center" 
					 HorizontalAlignment="Right"
					 Width="50" />
            </Grid>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="9.5*" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Grid.Column="0" Margin="0,5,0,0">
                <TabItem Header="基本情報 (Shift+F1)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition/>
                            <ColumnDefinition />
                            <ColumnDefinition/>
                            <ColumnDefinition />
                            <ColumnDefinition/>
                            <ColumnDefinition />
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label   Grid.Row="0" Grid.Column="0" Margin="1" Content="商品CD" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="1" Grid.ColumnSpan="2" d:Text="商品CD：Data" Text="{Binding EditProduct.ProductCD}" TextWrapping="Wrap"/>
                        <Label   Grid.Row="0" Grid.Column="3" Margin="1" VerticalContentAlignment="Center" Content="ﾒｰｶｰ品番" />
                        <TextBox Grid.Row="0" Grid.Column="4" Margin="1" d:Text="ﾒｰｶｰ品番：Data" Text="{Binding EditProduct.MakerNo}" TextWrapping="Wrap" />
                                                              
                        <Label   Grid.Row="1" Grid.Column="0" Margin="1" Content="商品名" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="1" Grid.ColumnSpan="4" d:Text="商品名：Data" Text="{Binding EditProduct.ProductName}" TextWrapping="Wrap" />
                                                              
                        <Label   Grid.Row="2" Grid.Column="0" Margin="1" Content="略称" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="1" Grid.ColumnSpan="2" d:Text="略称：Data" Text="{Binding EditProduct.Abbreviation}" TextWrapping="Wrap" />
                        <Button  Grid.Row="2" Grid.Column="3" Margin="1" Style="{StaticResource FileUploadBtn}" Content="絵型名1" />
                        <TextBox Grid.Row="2" Grid.Column="4" Margin="1" IsEnabled="False" d:Text="abcdefghijklmnopqrstuvwxyz12345678901234" Text="{Binding EditProduct.ImgName}" Style="{StaticResource ReadOnlyTextBox}" TextWrapping="Wrap" />
                                                              
                        <Label   Grid.Row="3" Grid.Column="0" Margin="1" Content="旧コード" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="1" Grid.ColumnSpan="2" d:Text="旧コード：Data" Text="{Binding EditProduct.OldCode}" TextWrapping="Wrap" />
                        <Button  Grid.Row="3" Grid.Column="3" Margin="1" Style="{StaticResource FileUploadBtn}" Content="絵型名2" />
                        <TextBox Grid.Row="3" Grid.Column="4" Margin="1" IsEnabled="False" d:Text="abcdefghijklmnopqrstuvwxyz12345678901234" Text="{Binding EditProduct.ImgName2}" Style="{StaticResource ReadOnlyTextBox}" TextWrapping="Wrap" />
                                                              
                        <Label   Grid.Row="4" Grid.Column="0" Margin="1" Content="JAN連番" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="1" Grid.ColumnSpan="2" d:Text="JAN連番：Data" Text="{Binding EditProduct.Jan1stdigit}"  TextWrapping="Wrap" />
                        <TextBox Grid.Row="4" Grid.Column="3" Margin="1" Grid.ColumnSpan="2" d:Text="JAN連番：Data" Text="{Binding EditProduct.JanCode2}" TextWrapping="Wrap" />
                                                              
                        <Label   Grid.Row="5" Grid.Column="0" Margin="1" Content="年度" />
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="1" d:Text="年度：Data"     Text="{Binding EditProduct.JanCode1}"  TextWrapping="Wrap" />
                        <Label   Grid.Row="5" Grid.Column="2" Margin="1" Content="製品番号" />
                        <TextBox Grid.Row="5" Grid.Column="3" Margin="1" Grid.ColumnSpan="2" d:Text="製品番号：Data" Text="" TextWrapping="Wrap" />


                        <uc:CvnetBtListView  Grid.Row="6" Grid.Column="0" Margin="1"
							MstName="ブランド" StyleDesign="1"
							Title="ブランド"  SelectedValue ="{Binding EditProduct.BrandCD}" Command="{Binding SelBrandCommand}" />
                        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" d:Text="ブランド：Data" TextWrapping="Wrap" Margin="1">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.BrandCD" />
                                    <Binding Path="EditProduct.BrandName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView Grid.Row="6" Grid.Column="4" Margin="1"
							Title="アイテム"  MstName="アイテム"
							SelectedValue="{Binding EditProduct.ItemCD}" Command="{Binding SelItemCommand}"/>
                        <TextBox Grid.Row="6" Grid.Column="5" Grid.ColumnSpan="3" d:Text="アイテム：Data" TextWrapping="Wrap" Margin="1">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.ItemCD" />
                                    <Binding Path="EditProduct.ItemName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>


                        <uc:CvnetBtListView Grid.Row="7" Grid.Column="0"  Margin="1"
                            Title="シーズン" MstName="シーズン"
							SelectedValue="{Binding EditProduct.SeasonCD}" Command="{Binding SelSeasonCommand}" />
                        <TextBox Grid.Row="7" Grid.Column="1"  Margin="1" Grid.ColumnSpan="3" 
                            d:Text="シーズン：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.SeasonCD" />
                                    <Binding Path="EditProduct.SeasonName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView Grid.Row="7" Grid.Column="4"  Margin="1"
							Title="素材" MstName="素材"
							SelectedValue="{Binding EditProduct.MaterialCD}" Command="{Binding SelMaterialCommand}"/>
                        <TextBox  Grid.Row="7" Grid.Column="5"  Margin="1" Grid.ColumnSpan="3" 
							 d:Text="素材：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.MaterialCD" />
                                    <Binding Path="EditProduct.MaterialName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>


                        <uc:CvnetBtListView Grid.Row="8" Grid.Column="0"  Margin="1"
							Title="ﾃﾞｻﾞｲﾅｰ" MstName="デザイナー"
							SelectedValue="{Binding EditProduct.DesignCD}" Command="{Binding SelDesignCommand}" />
                        <TextBox Grid.Row="8" Grid.Column="1"  Margin="1" Grid.ColumnSpan="3" 
                            d:Text="ﾃﾞｻﾞｲﾅｰ：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.DesignCD" />
                                    <Binding Path="EditProduct.DesignName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView Grid.Row="8" Grid.Column="4"  Margin="1"
							Title="原産国" MstName="原産国"
							SelectedValue="{Binding EditProduct.MadeInCD}" Command="{Binding SelMadeInCommand}"/>
                        <TextBox Grid.Row="8" Grid.Column="5"  Margin="1" Grid.ColumnSpan="3" 
							d:Text="原産国：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.MadeInCD" />
                                    <Binding Path="EditProduct.MadeInName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>


                        <uc:CvnetBtListView  Grid.Row="9" Grid.Column="0" Margin="1"
							Title="展示会" MstName="展示会"			
							SelectedValue="{Binding EditProduct.ExhibitCD}" Command="{Binding SelExhibitCommand}"/>
                        <TextBox  Grid.Row="9" Grid.Column="1" Margin="1" Grid.ColumnSpan="3" 
							 d:Text="展示会：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.ExhibitCD" />
                                    <Binding Path="EditProduct.ExhibitName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView  Grid.Row="9" Grid.Column="4" Margin="1"
							Title="メーカー" MstName="メーカー"
							SelectedValue="{Binding EditProduct.ManufactCD}" Command="{Binding SelManufactCommand}"/>
                        <TextBox  Grid.Row="9" Grid.Column="5" Margin="1" Grid.ColumnSpan="3" 
							d:Text="メーカー：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.ManufactCD" />
                                    <Binding Path="EditProduct.ManufactName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>


                        <uc:CvnetBtListView Grid.Row="10" Grid.Column="0" Margin="1"
							Title="補足1" MstName="名称" Param2="B01"
							SelectedValue="{Binding EditProduct.NameCD01}" Command="{Binding SelNameCommand}"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Margin="1" Grid.ColumnSpan="3" 
                            d:Text="補足1：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD01" />
                                    <Binding Path="EditProduct.SubName01" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView Grid.Row="10" Grid.Column="4" Margin="1"
							Title="補足2" MstName="名称" Param2="B02"
							SelectedValue="{Binding EditProduct.NameCD02}" Command="{Binding SelNameCommand}"/>
                        <TextBox Grid.Row="10" Grid.Column="5" Margin="1" Grid.ColumnSpan="3" 
							d:Text="補足2：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD02" />
                                    <Binding Path="EditProduct.SubName02" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>


                        <uc:CvnetBtListView Grid.Row="11" Grid.Column="0" Margin="1"
							Title="補足3" MstName="名称" Param2="B03"
							SelectedValue="{Binding EditProduct.NameCD03}" Command="{Binding SelNameCommand}"/>
                        <TextBox Grid.Row="11" Grid.Column="1" Margin="1" Grid.ColumnSpan="3" 
							d:Text="補足3：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD03" />
                                    <Binding Path="EditProduct.SubName03" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView Grid.Row="11" Grid.Column="4" Margin="1"
							Title="補足4" MstName="名称" Param2="B04"
							SelectedValue="{Binding EditProduct.NameCD04}" Command="{Binding SelNameCommand}"/>
                        <TextBox Grid.Row="11" Grid.Column="5" Margin="1" Grid.ColumnSpan="3" 
							d:Text="補足4：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD04" />
                                    <Binding Path="EditProduct.SubName04" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>


                        <uc:CvnetBtListView Grid.Row="12" Grid.Column="0" Margin="1"
							Title="補足5" MstName="名称" Param2="B05"
							SelectedValue="{Binding EditProduct.NameCD05}" Command="{Binding SelNameCommand}"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Margin="1" Grid.ColumnSpan="3" 
							d:Text="補足5：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD05" />
                                    <Binding Path="EditProduct.SubName05" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView Grid.Row="12" Grid.Column="4" Margin="1"
							Title="補足6" MstName="名称" Param2="B06"
							SelectedValue="{Binding EditProduct.NameCD06}" Command="{Binding SelNameCommand}"/>
                        <TextBox Grid.Row="12" Grid.Column="5" Margin="1" Grid.ColumnSpan="3" 
							d:Text="補足6：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD06" />
                                    <Binding Path="EditProduct.SubName06" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>


                        <uc:CvnetBtListView Grid.Row="13" Grid.Column="0" Margin="1"
							Title="補足7" MstName="名称" Param2="B07"
							SelectedValue="{Binding EditProduct.NameCD07}" Command="{Binding SelNameCommand}"/>
                        <TextBox Grid.Row="13" Grid.Column="1" Margin="1" Grid.ColumnSpan="3" 
                            d:Text="補足7：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD07" />
                                    <Binding Path="EditProduct.SubName07" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView Grid.Row="13" Grid.Column="4" Margin="1"
							Title="補足8" MstName="名称" Param2="B08"
							SelectedValue="{Binding EditProduct.NameCD08}" Command="{Binding SelNameCommand}"/>
                        <TextBox Grid.Row="13" Grid.Column="5" Margin="1" Grid.ColumnSpan="3" 
							d:Text="補足8：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD08" />
                                    <Binding Path="EditProduct.SubName08" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>


                        <uc:CvnetBtListView  Grid.Row="14" Grid.Column="0" Margin="1"
							Title="補足9" MstName="名称" Param2="B09"
							SelectedValue="{Binding EditProduct.NameCD09}" Command="{Binding SelNameCommand}"/>
                        <TextBox  Grid.Row="14" Grid.Column="1" Margin="1" Grid.ColumnSpan="3" 
							d:Text="補足9：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD09" />
                                    <Binding Path="EditProduct.SubName09" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <uc:CvnetBtListView  Grid.Row="14" Grid.Column="4" Margin="1"
							Title="補足10" MstName="名称" Param2="B10"
							SelectedValue="{Binding EditProduct.NameCD10}" Command="{Binding SelNameCommand}"/>
                        <TextBox  Grid.Row="14" Grid.Column="5" Margin="1" Grid.ColumnSpan="3" 
							d:Text="補足10：Data" TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.NameCD10" />
                                    <Binding Path="EditProduct.SubName10" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>


                        <Label   Grid.Row="15" Grid.Column="0"  Margin="1" Content="元上代" />
                        <TextBox Grid.Row="15" Grid.Column="1"  Margin="1"  d:Text="元上代：Data" Text="{Binding EditProduct.OriPrice}" TextWrapping="Wrap" />
                        <Label   Grid.Row="15" Grid.Column="2"  Margin="1" VerticalContentAlignment="Center" Content="上代" />
                        <TextBox Grid.Row="15" Grid.Column="3"  Margin="1"  d:Text="上代：Data" Text="{Binding EditProduct.Price}" TextWrapping="Wrap" />
                        <Label   Grid.Row="15" Grid.Column="4"  Margin="1" VerticalContentAlignment="Center" Content="加工工賃" />
                        <TextBox Grid.Row="15" Grid.Column="5"  Margin="1"  d:Text="加工工賃：Data" Text="{Binding EditProduct.ManufactFee}" TextWrapping="Wrap" />



                        <Label   Grid.Row="16" Grid.Column="0" Margin="1" Content="仕入価格" />
                        <TextBox Grid.Row="16" Grid.Column="1" Margin="1"  d:Text="仕入価格：Data" Text="{Binding EditProduct.PurchasePrice}" TextWrapping="Wrap" />
                        <Label   Grid.Row="16" Grid.Column="2" Margin="1" Content="原価" />
                        <TextBox Grid.Row="16" Grid.Column="3" Margin="1" d:Text="原価：Data" Text="{Binding EditProduct.Cost}" TextWrapping="Wrap" />
                        <Label   Grid.Row="16" Grid.Column="4" Margin="1" Content="営業原価" />
                        <TextBox Grid.Row="16" Grid.Column="5" Margin="1"  d:Text="営業原価：Data" Text="{Binding EditProduct.OpCostPrice}" TextWrapping="Wrap" />

                        
                        <Label    Grid.Row="17" Grid.Column="0" Margin="1" Content="外貨仕入価格" />
                        <TextBox  Grid.Row="17" Grid.Column="1" Margin="1" d:Text="外貨仕入価格：Data"  Text="{Binding EditProduct.ForeignCurPrice}" TextWrapping="Wrap" />
                        <Label    Grid.Row="17" Grid.Column="2" Margin="1" Content="在庫管理" />
                        <ComboBox Grid.Row="17" Grid.Column="3" Margin="1" Style="{StaticResource SearchableComboBox1}"
								                                ItemsSource="{Binding InvMngmentList}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditProduct.InvMngmentFLG}"/>
                        <Label    Grid.Row="17" Grid.Column="4" Margin="1" Content="セール区分" />
                        <ComboBox Grid.Row="17" Grid.Column="5" Margin="1" Style="{StaticResource SearchableComboBox1}"
									ItemsSource="{Binding SalesCateList}" DisplayMemberPath="Value"  SelectedValuePath="Key" SelectedValue="{Binding EditProduct.SalesCate}" />

                        <Label    Grid.Row="18" Grid.Column="0" Margin="1" Content="売上基準自動補充" />
                        <ComboBox Grid.Row="18" Grid.Column="1" Margin="1" Style="{StaticResource SearchableComboBox1}"
									ItemsSource="{Binding AutoDistList}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditProduct.AutoDistFLG}"/>
                        <uc:CvnetBtListView Grid.Row="18" Grid.Column="2" Margin="1" Title="基準倉庫CD" MstName="倉庫" SelectedValue="{Binding EditProduct.StandWareCD}" Command="{Binding SelStandWareCommand}"/>
                        <TextBox  Grid.Row="18" Grid.Column="3" Margin="1" d:Text="基準倉庫CD：Data"  TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat='{}{0} {1}'>
                                    <Binding Path="EditProduct.StandWareCD" />
                                    <Binding Path="EditProduct.StockName" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <Label    Grid.Row="18" Grid.Column="4" Margin="1" Content="納品区分" />
                        <ComboBox Grid.Row="18" Grid.Column="5" Margin="1" ItemsSource="{Binding DeliverCateList}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditProduct.DeliveryCate}" Style="{StaticResource SearchableComboBox1}"/>


                        <Label    Grid.Row="19" Grid.Column="0" Margin="1" Content="EC連携" />
                        <ComboBox Grid.Row="19" Grid.Column="1" Margin="1" ItemsSource="{Binding EcConnectList}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditProduct.EcConnect}" Style="{StaticResource SearchableComboBox1}"/>
                        <Label    Grid.Row="19" Grid.Column="2" Margin="1" Content="EC取置" />
