                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button  Content="UUID取得" VerticalAlignment="Center" Margin="0,8" Command="{Binding GetUUIDCommand}"/>
                                            <TextBox Grid.Column="1" Margin="0,8" Text="{Binding EditShop.TerminalID}"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="備考" VerticalAlignment="Center" Margin="0,8"/>
                                            <TextBox Grid.Column="1" Margin="0,8"  Text="{Binding EditShop.Notes}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="開始時刻" VerticalAlignment="Center" Margin="0,8"/>
                                    <ComboBox  Grid.Column="1" Margin="0,8" ItemsSource="{Binding ComboListHour}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{DynamicResource SearchableComboBox1}" Text="{Binding Hour1}"/>
                                    <Label Grid.Column="2" Content="時" VerticalAlignment="Center" Margin="0,8"/>
                                    <ComboBox  Grid.Column="3" Margin="0,8" ItemsSource="{Binding ComboListMinSec}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{DynamicResource SearchableComboBox1}" Text="{Binding Min1}"/>
                                    <Label Grid.Column="4" Content="分" VerticalAlignment="Center" Margin="0,8"/>
                                    <ComboBox  Grid.Column="5" Margin="0,8" ItemsSource="{Binding ComboListMinSec}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{DynamicResource SearchableComboBox1}" Text="{Binding Sec1}"/>
                                    <Label Grid.Column="6" Content="秒" VerticalAlignment="Center" Margin="0,8"/>
                                </Grid>

                                <Grid Grid.Row="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="終了時刻" VerticalAlignment="Center" Margin="0,8"/>
                                    <ComboBox  Grid.Column="1" Margin="0,8" ItemsSource="{Binding ComboListHour}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{DynamicResource SearchableComboBox1}" Text="{Binding Hour2}"/>
                                    <Label Grid.Column="2" Content="時" VerticalAlignment="Center" Margin="0,8"/>
                                    <ComboBox  Grid.Column="3" Margin="0,8" ItemsSource="{Binding ComboListMinSec}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{DynamicResource SearchableComboBox1}" Text="{Binding Min2}"/>
                                    <Label Grid.Column="4" Content="分" VerticalAlignment="Center" Margin="0,8"/>
                                    <ComboBox  Grid.Column="5" Margin="0,8" ItemsSource="{Binding ComboListMinSec}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{DynamicResource SearchableComboBox1}" Text="{Binding Sec2}"/>
                                    <Label Grid.Column="6" Content="秒" VerticalAlignment="Center" Margin="0,8"/>
                                </Grid>

                            </Grid>
                        </StackPanel>
                    </TabItem>
                </TabControl>
                
            </Grid>
        <!--</Border>-->

            <Grid  Grid.Row="1" Margin="8,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Style="{DynamicResource AddIconBtn}" Command="{Binding DoInsertCommand}"/>
                <Button Style="{DynamicResource UpdateIconBtn}" Grid.Column="2" Command="{Binding DoUpdateCommand}"/>
                <Button Style="{DynamicResource DeleteIconBtn}" Grid.Column="4" Command="{Binding DoDeleteCommand}"/>
                <Button Style="{DynamicResource PrintIconBtn}" Grid.Column="6" Command="{Binding DoPrintCommand}"/>
            </Grid>
            <Button Grid.Row="2" Margin="8" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>
    </Grid>
    </Grid>
</Window>
