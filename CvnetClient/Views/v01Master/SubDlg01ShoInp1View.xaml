<Window x:Class="CvnetClient.Views.SubDlg01ShoInp1View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="{Binding DgTitle}" 
		Height="602" Width="650"
		Style="{StaticResource MasterWindowStyle}">
	<Window.DataContext>
		<vm:SubDlg01ShoInp1ViewModel />
	</Window.DataContext>
	<Grid Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Label Grid.Row="0" Grid.Column="0" 
				   Margin="0,0,0,5"
				   Content="伝票No" 
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
					 Margin="0,0,5,5"
					 Text="{Binding ShoInp1SearchOpt.SlipNo}"
					 HorizontalContentAlignment="Left"/>
			<Button Grid.Row="0" Grid.Column="3"
					Content="伝票一覧" 
					Margin="0,0,5,5"
					HorizontalContentAlignment="Center"/>
			<Label Grid.Row="0" Grid.Column="4"
				   Margin="0,0,5,5"
				   Content="入力者"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2"
					 Margin="0,0,5,5"
					 IsReadOnly="True">
				<TextBox.Text>
					<MultiBinding StringFormat="{}{0} {1}">
						<Binding Path="ShoInp1SearchOpt.InputStaffCd" />
						<Binding Path="ShoInp1SearchOpt.InputStaffName"/>
					</MultiBinding>
				</TextBox.Text>
			</TextBox>
			<Button Grid.Row="0" Grid.Column="7"
					Margin="0,0,5,5"
					Content="発注"/>

			<Label Grid.Row="1" Grid.Column="0"
				   Margin="0,0,0,5"
				   Content="商品"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
					 Margin="0,0,0,5"
				     Text="{Binding ShoInp1SearchOpt.ProdCd}" />
			<TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
					 Margin="0,0,0,5"
					 Text="{Binding ShoInp1SearchOpt.ProdName}"/>
			<Label Grid.Row="1" Grid.Column="6" 
				   Margin="0,0,5,5"
				   Content="取引区分"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<ComboBox Grid.Row="1" Grid.Column="7" Grid.ColumnSpan="2"
					  Margin="0,0,0,5"
					  ItemsSource="{Binding TranCatList}"
					  DisplayMemberPath="Value" 
					  SelectedValuePath="Key" 
					  SelectedValue="{Binding ShoInp1SearchOpt.TranCate}"
					  Style="{StaticResource SearchableComboBox1}"/>

			<Label Grid.Row="2" Grid.Column="0"
				   Margin="0,0,0,5"
				   Content="{Binding ShoInp1SearchOpt.OrderDateTitle}"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<DatePicker Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" 
						Margin="0,0,5,5"
						SelectedDate="{Binding ShoInp1SearchOpt.OrderDate}"/>
			<Label Grid.Row="2" Grid.Column="3"
				   Margin="0,0,5,5"
				   Content="{Binding ShoInp1SearchOpt.DeliverDateTitle}"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<DatePicker Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" 
						Margin="0,0,0,5"
						SelectedDate="{Binding ShoInp1SearchOpt.DeliverDate}"/>
			<Label Grid.Row="2" Grid.Column="6"
				   Margin="0,0,5,5"
				   Content="掛計上日"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<DatePicker Grid.Row="2" Grid.Column="7" Grid.ColumnSpan="2" 
						Margin="0,0,0,5"
						SelectedDate="{Binding ShoInp1SearchOpt.AccountDate}"/>

			<Label Grid.Row="3" Grid.Column="0"
				   Margin="0,0,0,5"
				   Content="仕入先"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
					 Margin="0,0,0,5"
					 Text="{Binding ShoInp1SearchOpt.SupplierCd.Display}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<uc:CvnetBtListView Grid.Row="3" Grid.Column="4"
								Margin="0,0,0,5"
								StyleDesign="2" 
								MstName="仕入先"
								SelectedValue="{Binding ShoInp1SearchOpt.SupplierCd.Code}"
								HorizontalAlignment="Left"/>
			<Label Grid.Row="3" Grid.Column="6"
				   Margin="0,0,0,5"
				   Content="掛計上?"
				   Visibility="{Binding ShoInp1SearchOpt.AccrualTVis}"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<ComboBox Grid.Row="3" Grid.Column="7" Grid.ColumnSpan="2"
					  Margin="0,0,0,5"
					  ItemsSource="{Binding AccrualList}"
					  DisplayMemberPath="Value" 
					  SelectedValuePath="Key" 
					  SelectedValue="{Binding ShoInp1SearchOpt.AccrualCd}"
					  Visibility="{Binding ShoInp1SearchOpt.AccrualDVis}"
					  Style="{StaticResource SearchableComboBox1}"/>

			<Label Grid.Row="4" Grid.Column="0"
				   Margin="0,0,0,5"
				   Content="{Binding ShoInp1SearchOpt.RecDestTitle}"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
					 Margin="0,0,0,5"
					 Text="{Binding ShoInp1SearchOpt.RecDestCd.Display}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<uc:CvnetBtListView Grid.Row="4" Grid.Column="4"
								Margin="0,0,0,5"
								StyleDesign="2"
								MstName="移動倉庫"
								SelectedValue="{Binding ShoInp1SearchOpt.RecDestCd.Code}"
								HorizontalAlignment="Left"/>
			<Label Grid.Row="4" Grid.Column="6"
				   Margin="0,0,0,5"
				   Content="在庫計上?"
				   Visibility="{Binding ShoInp1SearchOpt.RecInvTVis}"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<ComboBox Grid.Row="4" Grid.Column="7" Grid.ColumnSpan="2"
					  Margin="0,0,0,5"
					  ItemsSource="{Binding RecInvList}"
					  DisplayMemberPath="Value" 
					  SelectedValuePath="Key" 
					  SelectedValue="{Binding ShoInp1SearchOpt.RecInvCd}"
					  Visibility="{Binding ShoInp1SearchOpt.RecInvDVis}"
					  Style="{StaticResource SearchableComboBox1}"/>

			<Label Grid.Row="5" Grid.Column="0"
				   Margin="0,0,0,5"
				   Content="備考"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="5"
					 Margin="0,0,0,5"
					 Text="{Binding ShoInp1SearchOpt.Memo}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>

			<Label Grid.Row="6" Grid.Column="0"
				   Margin="0,0,0,5"
				   Content="上代"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Row="6" Grid.Column="1"
					 Margin="0,0,5,5"
					 Text="{Binding ShoInp1SearchOpt.Retail}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<Label Grid.Row="6" Grid.Column="2"
				   Margin="0,0,0,5"
				   Content="原価"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Row="6" Grid.Column="3"
					 Margin="0,0,5,5"
					 Text="{Binding ShoInp1SearchOpt.Cost}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<Label Grid.Row="6" Grid.Column="4"
				   Margin="0,0,0,5"
				   Content="原価FLG"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Row="6" Grid.Column="5"
					 Margin="0,0,5,5"
					 Text="{Binding ShoInp1SearchOpt.CostFlg}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<Label Grid.Row="6" Grid.Column="6"
				   Margin="0,0,0,5"
				   Content="消費税率"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/> 
			<ComboBox Grid.Row="6" Grid.Column="7"
					  Margin="0,0,5,5"
					  ItemsSource="{Binding TaxList}"
					  DisplayMemberPath="Value" 
					  SelectedValuePath="Key" 
					  SelectedValue="{Binding ShoInp1SearchOpt.TaxRate}"
					  Style="{StaticResource SearchableComboBox1}"/>
			<Button Grid.Row="6" Grid.Column="8"
					Margin="0,0,0,5"
					Content="一括Refresh"/>
		</Grid>

		<DataGrid Grid.Row="1"
				  Margin="0,0,0,5"
				  AutoGenerateColumns="True"
				  CanUserAddRows="False"
				  Style="{DynamicResource WinGridData}"> 
		</DataGrid>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Label Grid.Column="0"
				   Margin="0,0,0,5"
				   Content="{Binding ShoInp1SearchOpt.Dsp7Label}"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Column="1"
					 Margin="0,0,5,5"
					 Text="{Binding ShoInp1SearchOpt.Dsp7}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<Label Grid.Column="2"
				   Margin="0,0,0,5"
				   Content="{Binding ShoInp1SearchOpt.Dsp8Label}"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Column="3"
					 Margin="0,0,5,5"
					 Text="{Binding ShoInp1SearchOpt.Dsp8}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<Label Grid.Column="4"
				   Margin="0,0,0,5"
				   Content="(数量・上代・下代)　計"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Column="5"
					 Margin="0,0,5,5"
					 Text="{Binding ShoInp1SearchOpt.TotalQnt}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<TextBox Grid.Column="6"
					 Margin="0,0,5,5"
					 Text="{Binding ShoInp1SearchOpt.TotalRetail}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<TextBox Grid.Column="7"
					 Margin="0,0,5,5"
					 Text="{Binding ShoInp1SearchOpt.TotalWholesales}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
		</Grid>

		<Grid Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Label Grid.Column="0"
				   Margin="0,0,0,0"
				   Content="作成/修正日"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"/>
			<TextBox Grid.Column="1"
					 Margin="0,0,5,0"
					 Text="{Binding ShoInp1SearchOpt.VDate_Create}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>
			<TextBox Grid.Column="2"
					 Margin="0,0,5,0"
					 Text="{Binding ShoInp1SearchOpt.VDate_Update}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"/>

			<Button Grid.Column="4"
					Margin="0,0,5,0"
					Content="確定(F6)"/>
			<Button Grid.Column="5"
					Margin="0,0,5,0"
					Content="戻る(ESC)"/>
		</Grid>

	</Grid>
</Window>
