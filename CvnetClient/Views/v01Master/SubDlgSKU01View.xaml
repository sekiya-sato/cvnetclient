<Window x:Class="CvnetClient.Views.SubDlgSKU01View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        mc:Ignorable="d"
        Title="{Binding Title}" 
		Style="{StaticResource SmallWindow}">
	<Window.DataContext>
		<vm:SubDlgSKU01ViewModel />
	</Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
		 
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="7*" />
				<ColumnDefinition Width="3*" />
			</Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="商品CD" Width="60"/>
                <TextBox Grid.Column="1" 
						 Margin="0,0,5,0"
						 Text="{Binding Sku01Dsp.ProdCD01}"/>
                <TextBox Grid.Column="2" 
						 Margin="0,0,5,0"
						 Visibility="{Binding Sku01Dsp.ProdCD02Visible}"
						 Text="{Binding Sku01Dsp.ProdCD02}"/>
            </Grid>
			<Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
				<Label Grid.Column="0" 
					   Content="商品名" 
					   Width="60"/>
				<TextBox Grid.Column="1" 
						 Margin="0,0,5,0"
						 Text="{Binding Sku01Dsp.ProdName}"/>
            </Grid>
			<Grid Grid.Row="2" Margin="0,0,0,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Label Grid.Column="0" 
				       Content="{Binding Sku01Dsp.Lbl4Title}"
				       Width="60"/>
				<TextBox Grid.Column="1" 
						 Margin="0,0,5,0"
						 Text="{Binding Sku01Dsp.ProdColor.Display}"/>
				<Label Grid.Column="2" 
                       Content="{Binding Sku01Dsp.Lbl5Title}"
                       Width="60"/>
				<TextBox Grid.Column="3" 
					     Margin="0,0,5,0"
					     Text="{Binding Sku01Dsp.ProdSize.Display}"/>
			</Grid>
			<Grid Grid.Row="3" Margin="0,0,0,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Label Grid.Column="0" 
					   Content="上代"
					   Width="60"/>
				<TextBox Grid.Column="1" 
						 Margin="0,0,5,0"
						 Text="{Binding Sku01Dsp.RetailPrice}"/>
				<TextBlock Grid.Column="2" 
						   Margin="0,0,5,0"
						   Text="X" 
						   VerticalAlignment="Center" HorizontalAlignment="Center"/>
				<TextBox Grid.Column="3" 
						 Margin="0,0,5,0"
						 Text="{Binding Sku01Dsp.RetailPercent, UpdateSourceTrigger=PropertyChanged}">
					<i:Interaction.Triggers>
						<i:EventTrigger EventName="TextChanged">
							<i:InvokeCommandAction Command="{Binding RetailPercentChangedCommand}" />
						</i:EventTrigger>
					</i:Interaction.Triggers>
				</TextBox>
				<TextBlock Grid.Column="4" 
						   Text="=" 
						   Margin="0,0,5,0"
						   VerticalAlignment="Center" HorizontalAlignment="Center"/>
				<TextBox Grid.Column="5" 
						 Margin="0,0,5,0"
						 IsEnabled="{Binding Sku01Dsp.RetailPercentActive}"
						 Text="{Binding Sku01Dsp.RetailTotal}"/>
				<Label Grid.Column="6" 
					   Width="60"
					   Margin="0,0,5,0"
					   Visibility="{Binding Sku01Dsp.LblCostBranchVisible}"
					   Content="原価枝番" />
				<TextBox Grid.Column="7" 
						 Margin="0,0,5,0"
						 Visibility="{Binding Sku01Dsp.TxtCostBranchVisible}"
						 Text="{Binding Sku01Dsp.RetailTotal}" 
						 IsEnabled="{Binding Sku01Dsp.RetailTotalActive}"/>
			</Grid>
			<Grid Grid.Row="0" Grid.RowSpan="4"
				   Grid.Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<Image Source="{Binding Sku01Dsp.ProdImg}" />
			</Grid>
		</Grid>
		 
        <DataGrid Grid.Row="1" Margin="10"   
				  AutoGenerateColumns="True"
				  CanUserAddRows="False"
				  ItemsSource="{Binding Spread1}"
				  SelectedIndex="{Binding SpreadRowIdx}"
				  Style="{DynamicResource WinGridData}">
			<i:Interaction.Triggers>
				<i:EventTrigger EventName="BeginningEdit">
					<i:InvokeCommandAction Command="{Binding DataGridBeginEditCommand}"
										   PassEventArgsToCommand="True" />
				</i:EventTrigger>
			</i:Interaction.Triggers>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" 
					Content="展開" 
					Width="90" Height="28"
					Command="{Binding DoExecuteCommand}"/>
            <Button  Margin="8" 
					 Style="{DynamicResource BackBtn}" 
					 Command="{Binding DoExitCommand}" 
					 IsCancel="True" 
					 HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
