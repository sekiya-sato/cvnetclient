            Grid.Row="0"
            Margin="10,0,10,5"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="印刷範囲指定" />
            <Label
                Background="White"
                Content="※ 指定範囲商品CD、もしくは16商品CDを印刷します"
                Foreground="#FFC0C0C0" />
        </StackPanel>

        <!--
            ==========================================================
            商品CD範囲 (Range Selection)
            ===========================================================
        -->
