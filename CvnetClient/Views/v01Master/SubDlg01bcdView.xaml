            Grid.Row="1"
            Margin="3"
            Padding="3"
            Background="White"
            BorderThickness="1"
            CornerRadius="10">

            <!--  商品CD範囲  -->
            <StackPanel Margin="5" Orientation="Horizontal">

                <RadioButton
                    Margin="0,0,10,0"
                    GroupName="SelectProduct"
                    IsChecked="{Binding SelProductSelect, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=0}" />
                <Label Width="80" Content="商品CD範囲" />

                <!--  FROM  -->
                <TextBox
                    Width="280"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    TextWrapping="Wrap">
                    <TextBox.Text>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="RangeFrom.Code" />
                            <Binding Path="RangeFrom.Name" />
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>

                <uc:CvnetBtListView
                    Width="40"
                    Margin="-10,0,0,0"
                    Command="{Binding SelRangeFromCommand}"
                    MstName="商品"
                    SelectedValue="{Binding RangeFrom.Code}"
                    StyleDesign="2" />

                <Label Width="30" Content="～" />

                <!--  TO  -->
                <TextBox
                    Width="280"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    TextWrapping="Wrap">
                    <TextBox.Text>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="RangeTo.Code" />
                            <Binding Path="RangeTo.Name" />
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>

                <uc:CvnetBtListView
                    Width="40"
                    Margin="-10,0"
                    Command="{Binding SelRangeToCommand}"
                    MstName="商品"
                    SelectedValue="{Binding RangeTo.Code}"
                    StyleDesign="2" />
            </StackPanel>

        </Border>

