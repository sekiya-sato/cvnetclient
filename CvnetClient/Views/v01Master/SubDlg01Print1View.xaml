<Window x:Class="CvnetClient.Views.SubDlg01Print1View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="帳票マスタ:一括変更" Style="{StaticResource SmallWindow}">
    <Window.DataContext>
        <vm:SubDlg01Print1ViewModel />
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="F6" Command="{Binding DoUpdateCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
Background="White"
CornerRadius="12"
Padding="30"
BorderBrush="#dcdde1"
BorderThickness="1"
HorizontalAlignment="Center"
VerticalAlignment="Center">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="8*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="変更前" Margin="10"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedChange}" Width="200" Margin="10"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ComboList}" DisplayMemberPath="Value" SelectedValue="{Binding SelectedCombo}" SelectedValuePath="Key" Style="{DynamicResource SearchableComboBox1}" Width="200" Margin="10"/>
                <Label Grid.Row="1" Grid.Column="0" Content="変更後" Margin="10"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedChange}" Width="200" Margin="10"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">
            <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoUpdateCommand}" Content="確定(F6)"/>
            <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
        </StackPanel>
    </Grid>
</Window>
