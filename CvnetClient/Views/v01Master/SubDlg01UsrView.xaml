<Window x:Class="CvnetClient.Views.SubDlg01UsrView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="社員マスタ" Style="{StaticResource MasterWindowStyle2}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg01UsrViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding DoListCommand}" />
        <KeyBinding Key="F6" Command="{Binding DoUpdateCommand}" />
        <KeyBinding Key="F7" Command="{Binding DoDeleteCommand}" />
        <KeyBinding Key="F8" Command="{Binding DoInsertCommand}" />
        <KeyBinding Key="F9" Command="{Binding DoPrintCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>

           

            <Button Grid.Row="0" Margin="6,0" Command="{Binding DoListCommand}" Style="{DynamicResource ExecButton}" HorizontalAlignment="Right"/>
               

            <DataGrid  Grid.Row="1" Margin="4,0" d:ItemsSource="{d:SampleData ItemCount=5}"
                AutoGenerateColumns="False"
                Style="{DynamicResource WinGridData}"
                IsReadOnly="True"
                ItemsSource="{Binding ListWorker}"
                SelectedItem="{Binding SelectedWorker}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="4*" Binding="{Binding WorkerCD}" Header="社員CD" />
                    <DataGridTextColumn Width="6*" Binding="{Binding Name}" Header="名前" />
                </DataGrid.Columns>

            </DataGrid>

            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button Margin="1,6" Command="{Binding BackListCommand}" Style="{DynamicResource PrevPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                <Button Margin="1,6" Command="{Binding NextListCommand}" Style="{DynamicResource NextPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
            </StackPanel>

        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.RowSpan="2" Background="White" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto" MinHeight="50"/>
                    </Grid.RowDefinitions>


                    <TabControl Grid.Row="0" Grid.RowSpan="2" BorderThickness="1">
                

                        <TabItem Header="基本情報(Shift+F1)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MaxWidth="100"/>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="2*" MaxWidth="100"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                    <RowDefinition Height="1*" MinHeight="40"/>
                                </Grid.RowDefinitions>


                                <Label   Grid.Row="0" Grid.Column="0" Content="社員CD" />
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EditWorker.WorkerCD}"/>


                                <Label   Grid.Row="1" Grid.Column="0" Content="名前" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EditWorker.Name}"/>

                                <Label    Grid.Row="2" Grid.Column="0" Content="カナ"/>
                                <TextBox  Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EditWorker.Furigana}"/>

                                <Label   Grid.Row="3" Grid.Column="0" Content="写真/画像"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditWorker.TelNo}" />

                                <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="3" Grid.ColumnSpan="2" Orientation="Vertical" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="4" Background="#FFF" MaxHeight="120"
                                            AllowDrop="True" DragEnter="Border_DragEnter" Drop="Border_Drop">
                                        <Image MinHeight="100" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Stretch="Uniform" Source="{Binding SourceImage}"/>
                                    </Border>
                                    <Button Style="{StaticResource ImageUploadBtn}" VerticalAlignment="Bottom" Content="アップロード" Command="{Binding OpenFileDialogCommand}" MinWidth="100" Margin="0,4"/>
                                </StackPanel>


                                <uc:CvnetBtListView Grid.Row="4" Title="店舗CD" Margin="0,8"
				                    MstName="{Binding TenpoFlg}" StyleDesign="1"
				                    SelectedValue ="{Binding EditWorker.ShopCD}" Command="{Binding SelShopCommand}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" d:Text="店舗CD：Data"  TextWrapping="Wrap" >
                                    <TextBox.Text>
                                        <MultiBinding StringFormat='{}{0} {1}'>
                                            <Binding Path="EditWorker.ShopCD" />
                                            <Binding Path="EditWorker.ShopName" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>

                                <uc:CvnetBtListView Grid.Row="5" Title="部門" Margin="0,8"
                                MstName="部門" StyleDesign="1"
                                SelectedValue ="{Binding EditWorker.Department}" Command="{Binding SelDeptCommand}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" d:Text="部門：Data"  TextWrapping="Wrap" >
                                    <TextBox.Text>
                                        <MultiBinding StringFormat='{}{0} {1}'>
                                            <Binding Path="EditWorker.Department" />
                                            <Binding Path="EditWorker.DepartmentName" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>

                                <!--<Label    Grid.Row="5" Grid.Column="0" Content="部門"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding ComboListBumon}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditWorker.Department}" Style="{StaticResource SearchableComboBox1}"  />-->

 
                                <Label    Grid.Row="6" Grid.Column="0" Content="営業FLG"/>
                                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding ComboListSalesFLG}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditWorker.SalesFlg}" Style="{StaticResource SearchableComboBox1}"  />

                                <Label    Grid.Row="6" Grid.Column="2" Content="メールFLG"  HorizontalAlignment="Center"/>
                                <ComboBox Grid.Row="6" Grid.Column="3" SelectedValue="{Binding EditWorker.EmailFLG}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource SearchableComboBox1}" ItemsSource="{Binding ComboListMailFLG}"/>


                                <Label    Grid.Row="7" Grid.Column="0" Content="メール"/>
                                <TextBox  Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditWorker.Mail}"/>

                                <Label    Grid.Row="8" Grid.Column="0" Content="出力FLG" />
                                <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding ComboListOutPutFLG}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditWorker.OutputFLG}" Style="{StaticResource SearchableComboBox1}" />

                                <Label     Grid.Row="8" Grid.Column="2" Content="POS区分" HorizontalAlignment="Center"/>
                                <ComboBox  Grid.Row="8" Grid.Column="3" ItemsSource="{Binding ComboListPosCate}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditWorker.PosCate}" Style="{StaticResource SearchableComboBox1}" />

                                <Label    Grid.Row="9" Grid.Column="0" Content="備考"/>
                                <TextBox  Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditWorker.Notes}"/>

                                <Label   Grid.Row="10" Grid.Column="0" Content="作成日"/>
                                <TextBox Grid.Row="10" Grid.Column="1" Style="{DynamicResource ReadOnlyTextBox}" Text="{Binding EditWorker.VdateCreate, Converter={StaticResource VdateConverter}}" IsReadOnly="True"/>

                                <Label   Grid.Row="10" Grid.Column="2" Content="修正日" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="10" Grid.Column="3" Style="{DynamicResource ReadOnlyTextBox}" Text="{Binding EditWorker.VdateUpdate, Converter={StaticResource VdateConverter}}" IsReadOnly="True"/>


                                <Label   Grid.Row="11" Content="最終修正者"/>
                                <TextBox Grid.Row="11" Grid.Column="1" Style="{DynamicResource ReadOnlyTextBox}" Text="{Binding EditWorker.EmployeeInpCD}" IsReadOnly="True"/>

                                </Grid>
                        </TabItem>
                        <TabItem Header="人事情報(Shift+F2)">
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MaxWidth="100"/>
                                    <ColumnDefinition Width="8*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <uc:CvnetBtListView Grid.Row="0" Title="部課" Margin="0,8"
                                MstName="名称" StyleDesign="1" Param2="BKA"
                                SelectedValue ="{Binding EditWorker.SectionCD}" Command="{Binding SelNameCommand}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" d:Text="部課：Data"  TextWrapping="Wrap" >
                                    <TextBox.Text>
                                        <MultiBinding StringFormat='{}{0} {1}'>
                                            <Binding Path="EditWorker.SectionCD" />
                                            <Binding Path="EditWorker.SectionName" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>

                                <!--<Label Grid.Row="0" Content="部課" VerticalAlignment="Center" Margin="0,8"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,8" SelectedValue="{Binding EditWorker.SectionCD}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource SearchableComboBox1}" ItemsSource="{Binding ComboListBuka}"/>-->

                                <uc:CvnetBtListView Grid.Row="1" Title="役職" Margin="0,8"
                                MstName="名称" StyleDesign="1" Param2="YAK"
                                SelectedValue ="{Binding EditWorker.PositionCD}" Command="{Binding SelNameCommand}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" d:Text="部課：Data"  TextWrapping="Wrap" >
                                    <TextBox.Text>
                                        <MultiBinding StringFormat='{}{0} {1}'>
                                            <Binding Path="EditWorker.PositionCD" />
                                            <Binding Path="EditWorker.PositionName" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>

                                <!--<Label Grid.Row="1" Content="役職" VerticalAlignment="Center" Margin="0,8"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8" SelectedValue="{Binding EditWorker.PositionCD}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource SearchableComboBox1}" ItemsSource="{Binding ComoListYakuShoku}"/>-->

                                <Label Grid.Row="2" Content="就業FLG" VerticalAlignment="Center" Margin="0,8"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8" SelectedValue="{Binding EditWorker.EmploymentFLG}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource SearchableComboBox1}" ItemsSource="{Binding ComboListEmplyomentFLG}"/>

                                <Label Grid.Row="3" Content="入社日" VerticalAlignment="Center" Margin="0,8"/>
                                <DatePicker Grid.Row="3" Grid.Column="1" Margin="0,8" Text="{Binding EditWorker.JoiningDate}"/>

                                <Label Grid.Row="4" Content="退職日" VerticalAlignment="Center" Margin="0,8"/>
                                <DatePicker Grid.Row="4" Grid.Column="1" Margin="0,8" Text="{Binding EditWorker.RetireDate}"/>

                                <Label Grid.Row="5" Content="有休残" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,8" Text="{Binding EditWorker.VacationRemaining}"/>

                                <Label Grid.Row="6" Content="特休残" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,8" Text="{Binding EditWorker.SpecHolidayRemain}"/>

                                <Label Grid.Row="7" Content="給与区分" VerticalAlignment="Center" Margin="0,8"/>
                                <ComboBox Grid.Row="7" Grid.Column="1"  Margin="0,8" SelectedValue="{Binding EditWorker.SalaryCate}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource SearchableComboBox1}" ItemsSource="{Binding ComboListSalaryCate}"/>


                                <Label Grid.Row="8" Content="給与給額" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBox Grid.Row="8" Grid.Column="1" Margin="0,8" Text="{Binding EditWorker.SalaryAmount}"/>

                                <Label Grid.Row="9" Content="交通費区分" VerticalAlignment="Center" Margin="0,8"/>
                                <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,8" SelectedValue="{Binding EditWorker.TransExpCate}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource SearchableComboBox1}" ItemsSource="{Binding ComboListTransFeeCate}"/>

                                <Label Grid.Row="10" Content="交通費給額" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBox Grid.Row="10" Grid.Column="1" Margin="0,8" Text="{Binding EditWorker.TransExpAmount}"/>
                            </Grid>

                                                
                        </TabItem>
                        <TabItem Header="拡張情報(Shift+F3)">
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MaxWidth="100"/>
                                    <ColumnDefinition Width="8*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <uc:CvnetBtListView Grid.Row="0" Title="社員分類01" Margin="0,8"
                                MstName="名称" StyleDesign="1" Param2="E01"
                                SelectedValue ="{Binding EditWorker.NameCD01}" Command="{Binding SelNameCommand}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" d:Text="社員分類01：Data"  TextWrapping="Wrap" >
                                    <TextBox.Text>
                                        <MultiBinding StringFormat='{}{0} {1}'>
                                            <Binding Path="EditWorker.NameCD01" />
                                            <Binding Path="EditWorker.NameCD01Name" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>

                                <uc:CvnetBtListView Grid.Row="1" Title="社員分類02" Margin="0,8"
                                MstName="名称" StyleDesign="1" Param2="E02"
                                SelectedValue ="{Binding EditWorker.NameCD02}" Command="{Binding SelNameCommand}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" d:Text="社員分類01：Data"  TextWrapping="Wrap" >
                                    <TextBox.Text>
                                        <MultiBinding StringFormat='{}{0} {1}'>
                                            <Binding Path="EditWorker.NameCD02" />
                                            <Binding Path="EditWorker.NameCD02Name" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>

                                <uc:CvnetBtListView Grid.Row="2" Title="社員分類03" Margin="0,8"
                                MstName="名称" StyleDesign="1" Param2="E03"
                                SelectedValue ="{Binding EditWorker.NameCD03}" Command="{Binding SelNameCommand}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" d:Text="社員分類01：Data"  TextWrapping="Wrap" >
                                    <TextBox.Text>
                                        <MultiBinding StringFormat='{}{0} {1}'>
                                            <Binding Path="EditWorker.NameCD03" />
                                            <Binding Path="EditWorker.NameCD03Name" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>

                                <uc:CvnetBtListView Grid.Row="3" Title="社員分類04" Margin="0,8"
                                MstName="名称" StyleDesign="1" Param2="E01"
                                SelectedValue ="{Binding EditWorker.NameCD04}" Command="{Binding SelNameCommand}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" d:Text="社員分類01：Data"  TextWrapping="Wrap" >
                                    <TextBox.Text>
                                        <MultiBinding StringFormat='{}{0} {1}'>
                                            <Binding Path="EditWorker.NameCD04" />
                                            <Binding Path="EditWorker.NameCD04Name" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>

                                <uc:CvnetBtListView Grid.Row="4" Title="社員分類05" Margin="0,8"
                                MstName="名称" StyleDesign="1" Param2="E05"
                                SelectedValue ="{Binding EditWorker.NameCD05}" Command="{Binding SelNameCommand}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" d:Text="社員分類01：Data"  TextWrapping="Wrap" >
                                    <TextBox.Text>
                                        <MultiBinding StringFormat='{}{0} {1}'>
                                            <Binding Path="EditWorker.NameCD05" />
                                            <Binding Path="EditWorker.NameCD05Name" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>


                            </Grid>
                        </TabItem>

                

                    </TabControl>


                <Grid  Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{DynamicResource AddIconBtn}" Command="{Binding DoInsertCommand}"/>
                    <Button Style="{DynamicResource UpdateIconBtn}" Grid.Column="2" Command="{Binding DoUpdateCommand}"/>
                    <Button Style="{DynamicResource DeleteIconBtn}" Grid.Column="4" Command="{Binding DoDeleteCommand}"/>
                    <Button Style="{DynamicResource PrintIconBtn}" Grid.Column="6" Command="{Binding DoPrintCommand}"/>
                </Grid>
                </Grid>
            </Border>

            <Button Grid.Row="2" Margin="4" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
