<Window x:Class="CvnetClient.Views.SubDlg01UsrView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="社員マスタ" Style="{StaticResource MasterWindowStyle}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg01UsrViewModel/>
    </Window.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="ContentRendered">
            <behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding DoListCommand}" />
        <KeyBinding Key="F6" Command="{Binding DoUpdateCommand}" />
        <KeyBinding Key="F7" Command="{Binding DoDeleteCommand}" />
        <KeyBinding Key="F8" Command="{Binding DoInsertCommand}" />
        <KeyBinding Key="F9" Command="{Binding DoPrintCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="12"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

           

            <Button Grid.Row="0" Margin="13,6" Command="{Binding DoListCommand}" Style="{DynamicResource ExecButton}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
               

            <DataGrid   Grid.Row="1" Margin="8" Height="360" d:ItemsSource="{d:SampleData ItemCount=5}"
                AutoGenerateColumns="False"
                Style="{DynamicResource WinGridData}"
                IsReadOnly="True"
                ItemsSource="{Binding ListMeisho}"
                SelectedItem="{Binding SelectedMeisho}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="80" Binding="{Binding ShainCd}" Header="社員CD" />
                    <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="名前" />
                </DataGrid.Columns>

            </DataGrid>

            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button Margin="1,6" Command="{Binding BackListCommand}" Style="{DynamicResource PrevPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                <Button Margin="1,1,6,1" Command="{Binding NextListCommand}" Style="{DynamicResource NextPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
            </StackPanel>

        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Background="White" BorderThickness="0">
                

                <TabItem Header="基本情報(Shift+F1)">
                    
                </TabItem>
                <TabItem Header="人事情報(Shift+F2)">

                    <StackPanel >
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Content="部課" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" />

                            <Label Grid.Row="1" Content="役職" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" />

                            <Label Grid.Row="2" Content="就業FLG" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"/>

                            <Label Grid.Row="3" Content="入社日" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="3" Grid.Column="1"/>

                            <Label Grid.Row="4" Content="退職日" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="4" Grid.Column="1"/>

                            <Label Grid.Row="5" Content="有休残" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="1" />

                            <Label Grid.Row="6" Content="特休残" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" />

                            <Label Grid.Row="7" Content="給与区分" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="7" Grid.Column="1" />


                            <Label Grid.Row="8" Content="給与給額" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="1" />

                            <Label Grid.Row="9" Content="交通費区分" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="9" Grid.Column="1" />

                            <Label Grid.Row="10" Content="交通費給額" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="10" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                        


                        
                </TabItem>
                <TabItem Header="拡張情報(Shift+F3)">
                    <StackPanel >
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Content="社員分類01" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" />

                            <Label Grid.Row="1" Content="社員分類02" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" />

                            <Label Grid.Row="2" Content="社員分類03" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"/>

                            <Label Grid.Row="3" Content="社員分類04" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1"/>

                            <Label Grid.Row="4" Content="社員分類05" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </TabItem>

                

            </TabControl>

            <Grid Margin="8,8,15,8" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Style="{DynamicResource AddIconBtn}" Command="{Binding DoInsertCommand}"/>
                <Button Style="{DynamicResource UpdateIconBtn}" Padding="0,3" Grid.Column="2" Command="{Binding DoUpdateCommand}"/>
                <Button Style="{DynamicResource DeleteIconBtn}" Grid.Column="4" Command="{Binding DoDeleteCommand}"/>
                <Button Style="{DynamicResource PrintIconBtn}" Grid.Column="6" Command="{Binding DoPrintCommand}"/>
            </Grid>

            <Button Grid.Row="2" Margin="8" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
