<Window x:Class="CvnetClient.Views.v01Master.SubDlg01Kiji"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views.v01Master"
        mc:Ignorable="d"
        Title="SubDlg01Kiji" Height="500" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="12"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.12*"/>
                <RowDefinition Height="0.75*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="生地付属CD"
VerticalAlignment="Center"/>
                    <TextBox x:Name="fabricInclCd" Grid.Column="1" Width="260"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="仕入先CD"
VerticalAlignment="Center"/>
                    <TextBox x:Name="supplierCDSearch" Grid.Column="1" Width="260"/>
                </Grid>
            </Grid>
            <Button Grid.Row="1"/>
            <DataGrid Grid.Row="1" AutoGenerateColumns="True" d:ItemsSource="{d:SampleData ItemCount=5}"/>

        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="9*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <GroupBox
Background="Transparent"
BorderBrush="Black" BorderThickness="2">
                <GroupBox.Header>
                    <Label>
                        詳細
                    </Label>
                </GroupBox.Header>
                <StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="商品CD"
                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" CornerRadius="3" BorderBrush="#CCC" BorderThickness="1" Padding="1" Margin="18,0,18,0"  Width="260">
                            <TextBox x:Name="productCD" BorderThickness="0" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="商品名"
   VerticalAlignment="Center"/>
                        <TextBox x:Name="productName" Grid.Column="1" Width="260"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="略称"
   VerticalAlignment="Center"/>
                        <TextBox x:Name="abbraviation" Grid.Column="1" Width="260"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="旧コード"
   VerticalAlignment="Center"/>
                        <TextBox x:Name="oldCode" Grid.Column="1" Width="260"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="区分CD"
   VerticalAlignment="Center"/>
                        <TextBox x:Name="category" Grid.Column="1" Width="260"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="仕入先CD"
   VerticalAlignment="Center"/>
                        <TextBox x:Name="supplierCD" Grid.Column="1" Width="260"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="仕入先商品CD"
   VerticalAlignment="Center" Height="26"/>
                        <TextBox x:Name="productCDSupplier" Grid.Column="1" Margin="1,0,20,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="単価"
   VerticalAlignment="Center"/>
                        <TextBox x:Name="unitCost" Grid.Column="1" Width="260"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="メモ"
   VerticalAlignment="Center"/>
                        <TextBox x:Name="Memo" Grid.Column="1" Width="260"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="修正日"
   VerticalAlignment="Center"/>
                        <TextBox x:Name="dateEdit" Grid.Column="1" Width="260"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="最終修正日"
   VerticalAlignment="Center"/>
                        <TextBox x:Name="latsDateEdit" Grid.Column="1" Width="260"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Content="修正" Padding="0,3"/>
                        <Button Content="削除" Grid.Column="2"/>
                        <Button Content="追加" Grid.Column="4"/>
                        <Button Content="印刷" Grid.Column="6"/>

                    </Grid>

                </StackPanel>

            </GroupBox>

            <Button Content="戻る" Grid.Row="1"
        Margin="0,0,15,0" Height="24" Width="80" HorizontalAlignment="Right"/>
        </Grid>


    </Grid>
</Window>
