<Window x:Class="CvnetClient.Views.SubDlg02PrnSiiredtyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="諸掛チェックリスト" Style="{StaticResource PrintWindowStyle}">
    <Window.Resources>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg02PrnSiiredtyViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoPrintAsyncCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
        Background="White"
        CornerRadius="12"
        Padding="30"
        BorderBrush="#dcdde1"
        BorderThickness="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="40"/>
                    <RowDefinition Height="*" MinHeight="40"/>
                    <RowDefinition Height="*" MinHeight="40"/>
                    <RowDefinition Height="*" MinHeight="40"/>
                    <RowDefinition Height="*" MinHeight="40"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="印刷範囲指定　(※システム設定にかかわらず対象データ範囲を印刷します)"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="日付" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,20,0" />
                <DatePicker 
            Grid.Row="1"
            Grid.Column="1"
            MinWidth="180" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Left"
            SelectedDate="{Binding CodeNen1}"
            Height="34"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="~" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,10,0"/>
                <DatePicker
                        Grid.Row="1"
            Grid.Column="3"
            MinWidth="180" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Left"
            SelectedDate="{Binding CodeNen2}"
            Height="34"/>

                <TextBlock  Grid.Row="2" Grid.Column="0" Text="仕入先" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,20,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBox Width="auto" MinWidth="150" TextWrapping="Wrap">
                        <TextBox.Text>
                            <MultiBinding StringFormat='{}{0} {1}'>
                                <Binding Path="FindWareHouse1.Code" />
                                <Binding Path="FindWareHouse1.Name" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <uc:CvnetBtListView MstName="仕入先" StyleDesign="2" 
SelectedValue ="{Binding SelectedWareHouse1}"
Command="{Binding SelWareHouse1Command}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="~" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                    <TextBox Width="auto" MinWidth="150" TextWrapping="Wrap">
                        <TextBox.Text>
                            <MultiBinding StringFormat='{}{0} {1}'>
                                <Binding Path="FindWareHouse2.Code" />
                                <Binding Path="FindWareHouse2.Name" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <uc:CvnetBtListView MstName="仕入先" StyleDesign="2" 
SelectedValue ="{Binding SelectedWareHouse2}"
Command="{Binding SelWareHouse2Command}"/>
                </StackPanel>


                <TextBlock  Grid.Row="3" Grid.Column="0" Text="手入力伝票NO" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,20,0" />
                <TextBox Grid.Row="3" Grid.Column="1" MinWidth="180"
                                 d:Text="伝票：Data" 
                                 Text="{Binding SlipNo1}"
                                 TextWrapping="Wrap">
                    </TextBox>

                <TextBlock Grid.Row="3" Grid.Column="2" Text="~" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Row="3" Grid.Column="3" MinWidth ="180"
                                 d:Text="伝票：zzzzzzzzzzzzzzzzzzzz"  
                                 Text="{Binding SlipNo2}"
                                 TextWrapping="Wrap">
                    </TextBox>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="出力区分:" 
               VerticalAlignment="Center" 
               Margin="0,0,20,0"/>

                <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0" Content="スプール" FontStyle="Normal"
GroupName="Output"
        IsChecked="{Binding SelectedOutput, 
                            Converter={StaticResource StringToBoolConverter}, 
                            ConverterParameter=PDF}"
Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="1" Content="CSV"  FontStyle="Normal"
                 GroupName="Output"
                         IsChecked="{Binding SelectedOutput, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=CSV}"
                 Margin="0,0,20,0"/>
                </Grid>



            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                <Button Style="{DynamicResource ExecButton}" Command="{Binding DoPrintCommand}" Content="実行(Enter)" Margin="0,0,8,0"/>
                <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
