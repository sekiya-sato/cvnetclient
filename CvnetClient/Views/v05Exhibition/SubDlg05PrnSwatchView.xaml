<Window x:Class="CvnetClient.Views.SubDlg05PrnSwatchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="スワッチ印刷" Style="{StaticResource PrintWindowStyle1}" >
    <Window.DataContext>
        <vm:SubDlg05PrnSwatchViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <utils:PercentageBelowConverter x:Key="PercentageBelowConverter"/>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <utils:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <!--<Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="30"
                BorderBrush="#dcdde1"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">-->
        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0" Text="ブランド" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBox Width="150"  TextWrapping="Wrap" Text="{Binding Condition.BrandFrom.Display}"/>
                    <uc:CvnetBtListView MstName="ブランド" StyleDesign="2" 
                                            SelectedValue ="{Binding Condition.BrandFrom.Code}"
                                            Command="{Binding SelBrd1Command}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBox Width="150" TextWrapping="Wrap" Text="{Binding Condition.BrandTo.Display}"/>
                    <uc:CvnetBtListView MstName="ブランド" StyleDesign="2" 
                                            SelectedValue ="{Binding Condition.BrandTo.Code}"
                                            Command="{Binding SelBrd2Command}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0" Text="展示会" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBox Width="150"  TextWrapping="Wrap" Text="{Binding Condition.ExhbFrom.Display}"/>
                    <uc:CvnetBtListView MstName="展示会" StyleDesign="2" 
                            SelectedValue ="{Binding Condition.ExhbFrom.Code}"
                            Command="{Binding SelExhb1Command}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBox Width="150" TextWrapping="Wrap" Text="{Binding Condition.ExhbTo.Display}"/>
                    <uc:CvnetBtListView MstName="展示会" StyleDesign="2" 
                            SelectedValue ="{Binding Condition.ExhbTo.Code}"
                            Command="{Binding SelExhb2Command}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0" Text="素材" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBox Width="150"  TextWrapping="Wrap" Text="{Binding Condition.MaterialFrom.Display}"/>
                    <uc:CvnetBtListView MstName="素材" StyleDesign="2" 
                            SelectedValue ="{Binding Condition.MaterialFrom.Code}"
                            Command="{Binding SelSoz1Command}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBox Width="150" TextWrapping="Wrap" Text="{Binding Condition.MaterialTo.Display}"/>
                    <uc:CvnetBtListView MstName="素材" StyleDesign="2" 
                            SelectedValue ="{Binding Condition.MaterialTo.Code}"
                            Command="{Binding SelSoz2Command}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="納品日" 
                              VerticalAlignment="Center" 
                              Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="1" Content="日付表示" 
GroupName="DayType"
        IsChecked="{Binding Condition.SelectedDay, 
                            Converter={StaticResource StringToBoolConverter}, 
                            ConverterParameter=DateDisp, Mode=TwoWay}"
Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="2" Content="旬表示" GroupName="DayType"
        IsChecked="{Binding Condition.SelectedDay, 
                            Converter={StaticResource StringToBoolConverter}, 
                            ConverterParameter=SeasonDisp, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Grid.Column="1" Text="商品マスタの納品日を出力" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            </Grid>

            <Grid Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="出力区分" 
VerticalAlignment="Center" 
Margin="0,0,20,0"/>
                <RadioButton Grid.Column="1" Content="全て" 
  GroupName="OutPutType"
          IsChecked="{Binding Condition.SelectedOutPut, 
                              Converter={StaticResource StringToBoolConverter}, 
                              ConverterParameter=All, Mode=TwoWay}"
  Margin="0,0,20,0"/>
                <RadioButton Grid.Column="2" Content="正規商品" GroupName="OutPutType"
          IsChecked="{Binding Condition.SelectedOutPut, 
                              Converter={StaticResource StringToBoolConverter}, 
                              ConverterParameter=Product, Mode=TwoWay}"/>
            </Grid>

            <Grid Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="受注表示" 
VerticalAlignment="Center" 
Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="1" Content="しない" VerticalAlignment="Center"
  GroupName="OrderType"
          IsChecked="{Binding SelectedOrder, 
                              Converter={StaticResource StringToBoolConverter}, 
                              ConverterParameter=Not, Mode=TwoWay}"
  Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="2" Content="する" GroupName="OrderType" VerticalAlignment="Center"
          IsChecked="{Binding SelectedOrder, 
                              Converter={StaticResource StringToBoolConverter}, 
                              ConverterParameter=Do, Mode=TwoWay}"/>

                </Grid>
                <TextBlock Grid.Column="1" Text="「する」の場合のみ、得意先、得意先分類の設定が可能です" VerticalAlignment="Center"></TextBlock>
            </Grid>

            <Grid Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="得意先" 
            VerticalAlignment="Center" 
            Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="1" Content="全て" 
                GroupName="ShopType"
                IsChecked="{Binding SelectedShop, 
              Converter={StaticResource StringToBoolConverter}, 
              ConverterParameter=All, Mode=TwoWay}"
                Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="2" Content="得意先別" GroupName="ShopType"
                IsChecked="{Binding SelectedShop, 
              Converter={StaticResource StringToBoolConverter}, 
              ConverterParameter=ByCust, Mode=TwoWay}"/>

                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Width="150" TextWrapping="Wrap" Text="{Binding Condition.SelectedShop1.Display}"/>
                    <uc:CvnetBtListView MstName="展示会" StyleDesign="2" 
                                IsEnabled="{Binding FlagCond}"
                                SelectedValue ="{Binding Condition.SelectedShop1.Code}"
                                Command="{Binding SelShopCommand}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="7" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="2" IsEnabled="{Binding FlagCond1}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="得意先分類" 
VerticalAlignment="Center" 
Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="1" Content="AND" 
  GroupName="SendiType"
          IsChecked="{Binding Condition.SelectedSendi, 
                              Converter={StaticResource StringToBoolConverter}, 
                              ConverterParameter=AND, Mode=TwoWay}"
  Margin="0,0,20,0"/>
                    <RadioButton Grid.Column="2" Content="OR" GroupName="SendiType"
          IsChecked="{Binding Condition.SelectedSendi, 
                              Converter={StaticResource StringToBoolConverter}, 
                              ConverterParameter=OR, Mode=TwoWay}"/>
                </Grid>

                <local:ListFlexView IsEnabled="{Binding FlagCond1}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="8" Margin="0" DataSource="{Binding ListFlexData}"/>
            </Grid>

        </Grid>
        <!--</Border>-->
        <Grid Grid.Row="1">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="【スワッチデータ一括作成】にてデータ作成した、データを印刷します"></TextBlock>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,20,0,0">
                <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoPrintCommand}"/>
                <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>