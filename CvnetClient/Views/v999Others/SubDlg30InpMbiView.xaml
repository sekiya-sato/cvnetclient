<Window x:Class="CvnetClient.Views.SubDlg30InpMbiView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils" 
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="月別ﾌﾞﾗﾝﾄﾞｱｲﾃﾑ仕入予算マスタ" Style="{StaticResource MasterWindowStyle}">
    <Window.DataContext>
        <vm:SubDlg30InpMbiViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoSumCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="6.5*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MaxWidth="100"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>


                <Label Grid.Column="0" Content="年月"/>
                <xctk:DateTimePicker Grid.Column="1"
					                 Value="{Binding SearchCond.Date, Mode=TwoWay}"
					                 Format="Custom"
									 Height="30"
					                 FormatString="yyyy/MM"/>

				<uc:CvnetBtListView Width="85" Grid.Column="2"
							Margin="5,0,0,0"
							Title="ブランド" 
							MstName="ブランド"
                            StyleDesign="1"
							SelectedValue ="{Binding SearchCond.Brd.Code}"
							Command="{Binding SelBrandCommand}" />
                <TextBox Grid.Column="3"
				 Margin="5,0,0,0"
				 d:Text="ブランド：Data"  
				 TextWrapping="Wrap" Text="{Binding SearchCond.Brd.Display}">
                </TextBox>
               
            </Grid>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MaxWidth="100"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="アイテム" Margin="0,0,20,0" />
                <StackPanel  Grid.Column="1" Orientation="Horizontal" Margin="0">
                    <TextBox MinWidth="350"
                            d:Text="アイテム：Data"  
                            TextWrapping="Wrap" Text="{Binding SearchCond.ItemFrom.Display}">
                    </TextBox>
                    <uc:CvnetBtListView MstName="アイテム" StyleDesign="2" 
                    SelectedValue ="{Binding SearchCond.ItemFrom.Code}"
                    Command="{Binding SelItem1Command}"/>
                </StackPanel>

                <TextBlock  Grid.Column="2" Text="~" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBox MinWidth="350"
                            d:Text="アイテム：Data"  
                            TextWrapping="Wrap" Text="{Binding SearchCond.ItemTo.Display}">
                    </TextBox>
                    <uc:CvnetBtListView MstName="アイテム" StyleDesign="2" 
                    SelectedValue ="{Binding SearchCond.ItemTo.Code}"
                    Command="{Binding SelItem2Command}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Button Style="{DynamicResource ExecButton}" HorizontalAlignment="Right" Content="検索(F5)" Command="{Binding DoSearchCommand}" Margin="10"/>
            </Grid>
            
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <DataGrid  Grid.Row="0" Margin="8,1" d:ItemsSource="{d:SampleData ItemCount=5}"
                        AutoGenerateColumns="False"
                        Style="{DynamicResource WinGridData}"
                        IsReadOnly="False"
                        CanUserAddRows="False"
                        ItemsSource="{Binding BudgetList}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="80" Binding="{Binding ItemCD}" Header="アイテムCD" IsReadOnly="True" />
                    <DataGridTextColumn Width="*" Binding="{Binding ItemName}" Header="アイテム名" IsReadOnly="True" />
                    <DataGridTextColumn Width="*" Binding="{Binding BudgetPrice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Header="予算"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="合計" HorizontalAlignment="Right" Grid.Column="1"/>
                <TextBox Text="{Binding Sum}" IsReadOnly="True" Grid.Column="2" Margin="10,0"/>
                
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="12" Padding="5" Grid.Column="0" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="アイテムは、【名称マスタ】名称区分：ITM ｱｲﾃﾑ、"/>
                    <TextBlock Grid.Row="1" Text="「表示FLG」に値を入力する事で表示されます。"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10" Orientation="Horizontal">
                <Button Style="{DynamicResource ExecButton}" Content="実行" Margin="5" Command="{Binding DoSumCommand}"/>
                <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" Margin="5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
