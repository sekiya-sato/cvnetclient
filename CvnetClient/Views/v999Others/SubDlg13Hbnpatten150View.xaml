<Window x:Class="CvnetClient.Views.SubDlg13Hbnpatten150View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="発注配分パターン入力" Style="{StaticResource MasterWindowStyle2}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg13Hbnpatten150ViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding DoListCommand}" />
        <KeyBinding Key="F6" Command="{Binding DoUpdateCommand}" />
        <KeyBinding Key="F7" Command="{Binding DoDeleteCommand}" />
        <KeyBinding Key="F8" Command="{Binding DoInsertCommand}" />
        <KeyBinding Key="F9" Command="{Binding DoPrintCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.5*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="5.5*"/>
        </Grid.ColumnDefinitions>

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="7*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="3.5*"/>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="パターンNO" Grid.Column="0"/>
                    <TextBox Grid.Column="1" Text="{Binding Condition.PatternNoFrom}"/>
                    <TextBlock Text="~" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="3" Text="{Binding Condition.PatternNoTo}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="3.5*"/>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="ブランドCD" Grid.Column="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox TextWrapping="Wrap" Text="{Binding Condition.BrdCDFrom.Display}" Width="110"/>
                        <uc:CvnetBtListView MstName="名称" StyleDesign="2" Param2="C01"
                    SelectedValue ="{Binding Condition.BrdCDFrom.Code}"
                    Command="{Binding SelBrd1Command}"/>
                    </StackPanel>
                    <TextBlock Text="~" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBox TextWrapping="Wrap" Text="{Binding Condition.BrdCDTo.Display}" Width="110"/>
                        <uc:CvnetBtListView MstName="名称" StyleDesign="2" Param2="C01"
                            SelectedValue ="{Binding Condition.BrdCDTo.Code}"
                            Command="{Binding SelBrd2Command}"/>
                    </StackPanel>
                </Grid>

                <Button Grid.Row="2" Margin="6,0" Command="{Binding DoListCommand}" Style="{DynamicResource ExecButton}" HorizontalAlignment="Right"/>
            </Grid>

            


            <DataGrid  Grid.Row="1"  d:ItemsSource="{d:SampleData ItemCount=5}"
        AutoGenerateColumns="False"
        Style="{DynamicResource WinGridData}"
        IsReadOnly="True"
HeadersVisibility="Column"
IsSynchronizedWithCurrentItem="True"
        ItemsSource="{Binding PatternList}"
        SelectedItem="{Binding SelectedPattern}"
        SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="4*" Binding="{Binding PatternNO}" Header="パターンNO" />
                    <DataGridTextColumn Width="6*" Binding="{Binding PatternName}" Header="パターン名" />
                </DataGrid.Columns>

            </DataGrid>

            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button Margin="1,6" Command="{Binding BackListCommand}" Style="{DynamicResource PrevPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                <Button Margin="1,6" Command="{Binding NextListCommand}" Style="{DynamicResource NextPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
            </StackPanel>

        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="8*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label Content="パターンNO" Grid.Row="0" Grid.Column="0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditPattern.PatternNO}"/>
                        <Label Content="パターン名" Grid.Row="0" Grid.Column="3"/>
                        <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding EditPattern.PatternName}"/>

                        <uc:CvnetBtListView MstName="ブランド" StyleDesign="1" Grid.Row="1" Grid.Column="0" Title="ブランドCD"
                                SelectedValue ="{Binding EditPattern.Brand.Code}"
                                Command="{Binding SelBrdCommand}" />
                        <TextBox Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{Binding EditPattern.Brand.Display}"/>

                        <uc:CvnetBtListView MstName="担当" StyleDesign="1" Grid.Row="1" Grid.Column="3" Title="入力者"
                                SelectedValue ="{Binding EditPattern.EntEmp.Code}"
                                Command="{Binding SelUserCommand}" />
                        <TextBox Grid.Row="1" Grid.Column="4" TextWrapping="Wrap" Text="{Binding EditPattern.EntEmp.Display}"/>

                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="9*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10">

                            <Button Width="90" Height="28" Content="最終行追加(F11)" Margin="0,0,8,0" Command="{Binding AddRowCommand}"/>
                            <Button Width="90" Height="28" Content="行Clear"  Command="{Binding ClearRowCommand}"/>

                        </StackPanel>
                        <uc:CvnetFlexView Grid.Row="1" 
                  ItemsSource="{Binding PatternDetailList}"
                  d:ItemsSource="{d:SampleData ItemCount=5}">
                            <uc:CvnetFlexView.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </uc:CvnetFlexView.CellStyle>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="CellEditEnding">
                                    <i:InvokeCommandAction Command="{Binding CellEditedCommand}" PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <uc:CvnetFlexView.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding Cust.Code}" Header="店舗CD" />
                                <DataGridTemplateColumn Width="45">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="一覧" Margin="0" Padding="6" Style="{StaticResource FlexButton}"
                                                    Command="{Binding DataContext.SelTenpoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="*" Binding="{Binding Cust.Name}" Header="店舗名" />
                                <DataGridTextColumn Width="*" Binding="{Binding Memo}" Header="指数" />
                                <DataGridTextColumn Width="*" Binding="{Binding AllocRate}" Header="配分率" />
                            </uc:CvnetFlexView.Columns>
                        </uc:CvnetFlexView>
                    </Grid>
                    
                </Grid>
            </Border>
            
            <Grid  Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="クリア"  Grid.Column="0" Command="{Binding DoClearCommand}"/>
                <Button Style="{DynamicResource UpdateIconBtn}" Grid.Column="4" Command="{Binding DoUpdateCommand}"/>
                <Button Style="{DynamicResource AddIconBtn}" Grid.Column="2" Command="{Binding DoInsertCommand}"/>
                <Button Style="{DynamicResource DeleteIconBtn}" Grid.Column="6" Command="{Binding DoDeleteCommand}"/>
                <Button Grid.Column="8" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True"/>
            </Grid>

        </Grid>
        
        
    </Grid>
</Window>
