<Window x:Class="CvnetClient.Views.SubDlgSyoKenSakuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="SubDlgSyoKenSakuViewModel" Style="{StaticResource SmallWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="65.6"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="商品1" HorizontalAlignment="Right" Background="{StaticResource SearchColor1}"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <TextBox  TextWrapping="Wrap" Text="{Binding Product1.Display}" Width="200"/>
                <uc:CvnetBtListView MstName="商品" StyleDesign="2" 
                    SelectedValue ="{Binding Product1.Code}"
                    Command="{Binding SelProduct1Command}"/>
            </StackPanel>

            <Label Grid.Row="1" Grid.Column="0" Content="商品2" HorizontalAlignment="Right" Background="{StaticResource SearchColor2}"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBox  TextWrapping="Wrap" Text="{Binding Product2.Display}" Width="200"/>
                <uc:CvnetBtListView MstName="商品" StyleDesign="2" 
        SelectedValue ="{Binding Product2.Code}"
        Command="{Binding SelProduct2Command}"/>
            </StackPanel>

            <Label Grid.Row="2" Grid.Column="0" Content="商品3" HorizontalAlignment="Right" Background="{StaticResource SearchColor3}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox  TextWrapping="Wrap" Text="{Binding Product3.Display}" Width="200"/>
                <uc:CvnetBtListView MstName="商品" StyleDesign="2" 
SelectedValue ="{Binding Product3.Code}"
Command="{Binding SelProduct3Command}"/>
            </StackPanel>

            <Label Grid.Row="3" Grid.Column="0" Content="商品4" HorizontalAlignment="Right" Background="{StaticResource SearchColor4}"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <TextBox  TextWrapping="Wrap" Text="{Binding Product4.Display}" Width="200"/>
                <uc:CvnetBtListView MstName="商品" StyleDesign="2" 
SelectedValue ="{Binding Product4.Code}"
Command="{Binding SelProduct4Command}"/>
            </StackPanel>

            <Label Grid.Row="4" Grid.Column="0" Content="商品5" HorizontalAlignment="Right" Background="{StaticResource SearchColor5}"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox  TextWrapping="Wrap" Text="{Binding Product5.Display}" Width="200"/>
                <uc:CvnetBtListView MstName="商品" StyleDesign="2" 
SelectedValue ="{Binding Product5.Code}"
Command="{Binding SelProduct5Command}"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Content="選択実行" Width="90" Height="28" Command="{Binding SetChoiceCommand}"/>
            <Button  Margin="8" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
