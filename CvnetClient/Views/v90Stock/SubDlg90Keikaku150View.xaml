<Window
    x:Class="CvnetClient.Views.SubDlg90Keikaku150View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:CvnetClient.Views"
    xmlns:util="clr-namespace:CvnetClient.Utils"
    xmlns:vm="clr-namespace:CvnetClient.ViewModels"
    Title="{Binding Title}"
    Width="1300"
    Height="750"
    Style="{StaticResource MasterWindowStyle}"
    mc:Ignorable="d">
    <Window.DataContext>
        <vm:SubDlg90Keikaku150ViewModel />
    </Window.DataContext>
    <Window.Resources>
        <util:RdIntToBoolConverter x:Key="RdIntToBoolConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,5"
            VerticalAlignment="Center"
            Text="検索条件" />

        <!--  検索条件  -->
        <Border
            Grid.Row="1"
            Margin="3"
            Padding="10"
            Background="White"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5"
                    VerticalAlignment="Center"
                    Content="仕入先CD" />
                <TextBox Grid.Column="1" />
                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="15,5,5,5"
                    VerticalAlignment="Center"
                    Content="仕入先CD" />
                <Grid
                    Grid.Row="0"
                    Grid.Column="3"
                    Grid.ColumnSpan="3"
                    Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchOpt.StartStoreCD}" />
                    <uc:CvnetBtListView
                        Grid.Column="1"
                        Margin="-5,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding DoStartStoreCommand}"
                        MstName="店舗"
                        StyleDesign="2" />
                </Grid>

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5"
                    VerticalAlignment="Center"
                    Content="店舗CD" />
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchOpt.StartStoreCD}" />
                    <uc:CvnetBtListView
                        Grid.Column="1"
                        Margin="-5,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding DoStartStoreCommand}"
                        MstName="店舗"
                        StyleDesign="2" />
                    <Label
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="～" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchOpt.EndStoreCD}" />
                    <uc:CvnetBtListView
                        Grid.Column="1"
                        Margin="-5,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding DoEndStoreCommand}"
                        MstName="店舗"
                        StyleDesign="2" />
                </Grid>
                <Button
                    Grid.Row="1"
                    Grid.Column="7"
                    Margin="0,0,5,0"
                    Command="{Binding DoExecuteCommand}"
                    Style="{DynamicResource ExecButton}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,10,0,10"
            Padding="10"
            Background="White"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="5"
                    VerticalAlignment="Center"
                    Content="仕入先CD" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    IsEnabled="False" />
                <Label
                    Grid.Row="3"
                    Grid.Column="2"
                    Margin="5"
                    VerticalAlignment="Center"
                    Content="仕入先CD" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="3"
                    Grid.ColumnSpan="2"
                    IsEnabled="False" />

                <Button
                    Grid.Row="3"
                    Grid.Column="7"
                    Width="80"
                    Content="クリア" />
            </Grid>
        </Border>

        <!--  条件リスト DataGrid  -->
        <Border
            Grid.Row="3"
            Padding="5,5,5,15"
            Background="White"
            CornerRadius="10">
            <TabControl Grid.Row="0" BorderThickness="1">
                <TabItem Header="【合計】">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8*" />
                            <ColumnDefinition Width="8*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="" />
                        <Border
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            Background="#FFFFCCCC"
                            CornerRadius="10,0,0,0">
                            <Label HorizontalAlignment="Center" Content="今年" />
                        </Border>
                        <Border
                            Grid.Column="2"
                            Margin="0,0,5,0"
                            Background="#FFCCFFFF"
                            CornerRadius="0,10,0,0">
                            <Label HorizontalAlignment="Center" Content="前年" />
                        </Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="3">
                            <DataGrid
                                Height="250"
                                Margin="5"
                                AutoGenerateColumns="False"
                                Background="#FF666666"
                                CanUserAddRows="False"
                                ColumnWidth="*"
                                HeadersVisibility="Column"
                                ItemsSource="{Binding DataSource.ListFlexSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{DynamicResource WinGridData}">
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*" Header="">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />

                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding TotalKotoshi}"
                                        Header="計">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding RatioKotoshi}"
                                        Header="構成比">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week1Kotoshi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="1週" />

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week2Kotoshi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="2週" />

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week3Kotoshi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="3週" />

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week4Kotoshi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="4週" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week5Kotoshi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="5週" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week6Kotoshi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="6週" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding TotalZenen}"
                                        Header="計">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding RatioZenen}"
                                        Header="構成比">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week1Zenen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="1週" />

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week2Zenen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="2週" />

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week3Zenen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="3週" />

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week4Zenen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="4週" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week5Zenen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="5週" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Week6Zenen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="6週" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Content="" />
                        <Border
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            Background="#FFFFCCCC"
                            CornerRadius="10,0,0,0">
                            <Label HorizontalAlignment="Center" Content="今年" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,0,5,0"
                            Background="#FFCCFFFF"
                            CornerRadius="0,10,0,0">
                            <Label HorizontalAlignment="Center" Content="前年" />
                        </Border>
                        <DataGrid
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Height="50"
                            Margin="5"
                            AutoGenerateColumns="False"
                            Background="#FF666666"
                            CanUserAddRows="False"
                            ColumnWidth="*"
                            HeadersVisibility="Column"
                            ItemsSource="{Binding DataSource.ListFlexSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{DynamicResource WinGridData}">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="仕入予算金額">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="発注金額">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="仕入金額">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="予算比">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="原価率(予)">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="原価率(実)">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="仕入予算金額">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="発注金額">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="仕入金額">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="予算比">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="原価率(予)">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RatioKotoshi}"
                                    Header="原価率(実)">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!--  Action Buttons  -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,5,0"
                Command="{Binding DoExecuteCommand}"
                Style="{DynamicResource ExecButton}" />
            <Button
                Margin="0,0,5,0"
                Command="{Binding DoExitCommand}"
                Style="{DynamicResource BackBtn}" />
        </StackPanel>
    </Grid>
</Window>

