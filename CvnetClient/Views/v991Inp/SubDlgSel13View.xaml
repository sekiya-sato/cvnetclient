<Window x:Class="CvnetClient.Views.SubDlgSel13View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" 
        Style="{StaticResource SmallWindow}">
	<Window.DataContext>
		<vm:SubDlgSel13ViewModel />
	</Window.DataContext>
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		
		<DataGrid Grid.Row="0"
					  x:Name="MyDataGrid1"
					  d:ItemsSource="{d:SampleData ItemCount=5}" 
					  ItemsSource="{Binding Sel13GridItems}"
					  SelectedItem="{Binding Sel13GridItem}"
					  Style="{DynamicResource WinGridData}"
					  IsReadOnly="True"
					  AutoGenerateColumns="False"
					  SelectionMode="Single"
					  ScrollViewer.VerticalScrollBarVisibility="Auto"
					  VerticalAlignment="Stretch"
					  HorizontalAlignment="Stretch">
			<DataGrid.Columns>
				<DataGridTextColumn Width="*" Header="伝票No" Binding="{Binding SeqNo}" />
				<DataGridTextColumn Width="*" Header="売上日" Binding="{Binding InvRecordDate}" />
				<DataGridTextColumn Width="*" Header="掛計上日" Binding="{Binding AccountDate}" />
				<DataGridTextColumn Width="*" Header="取引区分" Binding="{Binding TranCate}" />
				<DataGridTextColumn Width="*" Header="上代単価" Binding="{Binding RetailUnitPrice}" />
				<DataGridTextColumn Width="*" Header="下代単価" Binding="{Binding CostUnitPrice}" />
				<DataGridTextColumn Width="*" Header="掛率" Binding="{Binding CallRate}" />
			</DataGrid.Columns>
		</DataGrid>

		<Grid Grid.Row="1" Margin="0,0,5,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Label Grid.Column="0"
				   Content="売上日" />

			<DatePicker Grid.Column="1"
						SelectedDate="{Binding Sel13Dsp.SalesDate}"
						Margin="0,0,5,0"/>

			<Button Grid.Column="2"
					Margin="0,0,5,0"
					Content="再検索 (F5)" 
					Command="{Binding DoSearchCommand}"/>

			<Label Grid.Column="3"
				   Content="色" />

			<TextBox Grid.Column="4"
					 Margin="0,0,5,0"
					 Text="{Binding Sel13Dsp.Color}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"
					 IsEnabled="False" />

			<Label Grid.Column="5"
				   Content="ｻｲｽﾞ" />

			<TextBox Grid.Column="6"
					 Margin="0,0,5,0"
					 Text="{Binding Sel13Dsp.Size}"
					 HorizontalContentAlignment="Left"
					 VerticalContentAlignment="Center"
					 IsEnabled="False" />

			<Button Grid.Column="7"
					Margin="0,0,5,0"
					Content="選択実行(Enter)" 
					Command="{Binding DoExecuteCommand}"/>

			<Button Grid.Column="8"
					Content="戻る(ESC)"
					Command="{Binding DoExitCommand}"/> 
		</Grid>
		
	</Grid>
</Window>
