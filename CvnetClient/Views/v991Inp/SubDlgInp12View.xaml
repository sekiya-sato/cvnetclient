<Window x:Class="CvnetClient.Views.SubDlgInp12View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels" 
		xmlns:uc="clr-namespace:CvnetClient.Views"
		xmlns:util="clr-namespace:CvnetClient.Utils"
		WindowStartupLocation="CenterScreen"
        Style="{StaticResource MasterWindowStyle2}">
	<Window.DataContext>
		<vm:SubDlgInp12ViewModel />
	</Window.DataContext>
	<Window.Resources>
		<util:DateDisplayConverter x:Key="DateDisplayConverter" />
		<util:RdIntToBoolConverter x:Key="RdIntToBoolConverter" />
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TabControl Grid.Row="0"
					d:DataContext="{d:DesignInstance Type=vm:SubDlgInp12ViewModel, IsDesignTimeCreatable=True}"
					VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
					BorderThickness="1" 
					SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
			<TabItem Header="検索画面(Shift+F1)">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="340"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="0,0,0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Label Grid.Row="0" Grid.Column="0"   
							   VerticalContentAlignment="Center"
							   Content="伝票No" />
						<TextBox Grid.Row="0" Grid.Column="1"  
								 HorizontalContentAlignment="Right"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.SlipStartNo}"/>
						<TextBlock Grid.Row="0" Grid.Column="2"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<TextBox Grid.Row="0" Grid.Column="3"
								 HorizontalContentAlignment="Right"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.SlipEndNo}"/>
						<Label Grid.Row="0" Grid.Column="4"   
							   VerticalContentAlignment="Center"
							   Content="受注日" />
						<DatePicker Grid.Row="0" Grid.Column="5"
									SelectedDate="{Binding Inp12SearchOpt.OrderStartDate}"/>
						<TextBlock Grid.Row="0" Grid.Column="6"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<DatePicker Grid.Row="0" Grid.Column="7"
									SelectedDate="{Binding Inp12SearchOpt.OrderEndDate}"/>
						<Label Grid.Row="0" Grid.Column="8"   
							   VerticalContentAlignment="Center"
							   Content="取引区分" />
						<ComboBox Grid.Row="0" Grid.Column="9"
								  VerticalAlignment="Top"
								  VerticalContentAlignment="Center"
								  ItemsSource="{Binding TranCatList}"
								  DisplayMemberPath="Value"
								  SelectedValuePath="Key"
								  SelectedValue="{Binding Inp12SearchOpt.TranStartCat}"
								  Style="{StaticResource SearchableComboBox1}"/>
						<TextBlock Grid.Row="0" Grid.Column="10"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<ComboBox Grid.Row="0" Grid.Column="11"
								  VerticalAlignment="Top"
								  VerticalContentAlignment="Center"
								  ItemsSource="{Binding TranCatList}"
								  DisplayMemberPath="Key"
								  SelectedValuePath="Key"
								  SelectedValue="{Binding Inp12SearchOpt.TranEndCat}"
								  Style="{StaticResource SearchableComboBox1}"/>
					</Grid>

					<Grid Grid.Row="1" Margin="0,0,0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Label Grid.Row="0" Grid.Column="0"   
							   VerticalContentAlignment="Center"
							   Content="関連No1" />
						<TextBox Grid.Row="0" Grid.Column="1"  
								 HorizontalContentAlignment="Right"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.RelatedStartNo}"/>
						<TextBlock Grid.Row="0" Grid.Column="2"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<TextBox Grid.Row="0" Grid.Column="3"
								 HorizontalContentAlignment="Right"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.RelatedEndNo}"/>
						<Label Grid.Row="0" Grid.Column="4"   
							   VerticalContentAlignment="Center"
							   Content="関連No2" />
						<TextBox Grid.Row="0" Grid.Column="5"  
								 HorizontalContentAlignment="Right"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.RelatedStartNo2}"/>
						<TextBlock Grid.Row="0" Grid.Column="6"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<TextBox Grid.Row="0" Grid.Column="7"  
								 HorizontalContentAlignment="Right"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.RelatedEndNo2}"/>
						<Label Grid.Row="0" Grid.Column="8"   
							   VerticalContentAlignment="Center"
							   Content="手入力No" />
						<TextBox Grid.Row="0" Grid.Column="9"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.ManualInpStartNo}"/>
						<TextBlock Grid.Row="0" Grid.Column="10"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<TextBox Grid.Row="0" Grid.Column="11"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.ManualInpEndNo}"/>
					</Grid>

					<Grid Grid.Row="2" Margin="0,0,0,5">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="5" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="5" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="5" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="5" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1.04*" />
							<ColumnDefinition Width="4*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="4*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Label Grid.Row="0" Grid.Column="0"   
							   VerticalContentAlignment="Center"
							   Content="得意先" />
						<TextBox Grid.Row="0" Grid.Column="1"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.CustStartDest.Display}"/>
						<uc:CvnetBtListView Grid.Row="0" Grid.Column="2"
											StyleDesign="2" 
											MstName="全得意先"
											SelectedValue="{Binding Inp12SearchOpt.CustStartDest.Code}"
											Command="{Binding SelCustDest01Command}"/>
						<TextBlock Grid.Row="0" Grid.Column="3"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<TextBox Grid.Row="0" Grid.Column="4"
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.CustEndDest.Display}"/>
						<uc:CvnetBtListView Grid.Row="0" Grid.Column="5"
											StyleDesign="2"
											MstName="全得意先"
											SelectedValue="{Binding Inp12SearchOpt.CustEndDest.Code}"
											Command="{Binding SelCustDest02Command}"/>

						<Label Grid.Row="2" Grid.Column="0"   
							   VerticalContentAlignment="Center"
							   Content="倉庫" />
						<TextBox Grid.Row="2" Grid.Column="1"
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.StoreStartCd.Display}"/>
						<uc:CvnetBtListView Grid.Row="2" Grid.Column="2"
											StyleDesign="2"
											MstName="倉庫"
											SelectedValue="{Binding Inp12SearchOpt.StoreStartCd.Code}"
											Command="{Binding SelStoreCd01Command}" />
						<TextBlock Grid.Row="2" Grid.Column="3"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<TextBox Grid.Row="2" Grid.Column="4"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.StoreEndCd.Display}"/>
						<uc:CvnetBtListView Grid.Row="2" Grid.Column="5"
											StyleDesign="2"
											MstName="倉庫"
											SelectedValue="{Binding Inp12SearchOpt.StoreEndCd.Code}"
											Command="{Binding SelStoreCd02Command}" />

						<Button Grid.Row="4" Grid.Column="0"   
							   VerticalContentAlignment="Center"
							   Content="商品"
							   Command="{Binding SelPrdToggleCommand}"/>
						<TextBox Grid.Row="4" Grid.Column="1"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.ProdStartCd.Display}"/>
						<uc:CvnetBtListView Grid.Row="4" Grid.Column="2"
											StyleDesign="2"
											MstName="商品"
											SelectedValue="{Binding Inp12SearchOpt.ProdStartCd.Code}"
											Command="{Binding SelProdCd01Command}" />
						<TextBlock Grid.Row="4" Grid.Column="3"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<TextBox Grid.Row="4" Grid.Column="4"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.ProdEndCd.Display}"/>
						<uc:CvnetBtListView Grid.Row="4" Grid.Column="5"
											StyleDesign="2"
											MstName="商品"
											SelectedValue="{Binding Inp12SearchOpt.ProdEndCd.Code}" 
											Command="{Binding SelProdCd02Command}"/>

						<Label Grid.Row="6" Grid.Column="0"   
							   VerticalContentAlignment="Center"
							   Content="展示会" />
						<TextBox Grid.Row="6" Grid.Column="1"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.ExhibitStartCd.Display}"/>
						<uc:CvnetBtListView Grid.Row="6" Grid.Column="2"
											StyleDesign="2"
											MstName="展示会"
											SelectedValue="{Binding Inp12SearchOpt.ExhibitStartCd.Code}"
											Command="{Binding SelExhibitCd01Command}"/>
						<TextBlock Grid.Row="6" Grid.Column="3"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<TextBox Grid.Row="6" Grid.Column="4"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.ExhibitEndCd.Display}"/>
						<uc:CvnetBtListView Grid.Row="6" Grid.Column="5"
											StyleDesign="2"
											MstName="展示会"
											SelectedValue="{Binding Inp12SearchOpt.ExhibitEndCd.Code}"
											Command="{Binding SelExhibitCd02Command}"/>

						<Label Grid.Row="8" Grid.Column="0"   
							   VerticalContentAlignment="Center"
							   Content="入力者" />
						<TextBox Grid.Row="8" Grid.Column="1"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.InpStartCd.Display}"/>
						<uc:CvnetBtListView Grid.Row="8" Grid.Column="2"
											StyleDesign="2"
											MstName="担当"
											SelectedValue="{Binding Inp12SearchOpt.InpStartCd.Code}"
											Command="{Binding SelInpCd01Command}"/>
						<TextBlock Grid.Row="8" Grid.Column="3"
								   Text="～"
								   Foreground="Black"
								   VerticalAlignment="Center"/>
						<TextBox Grid.Row="8" Grid.Column="4"  
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12SearchOpt.InpEndCd.Display}"/>
						<uc:CvnetBtListView Grid.Row="8" Grid.Column="5"
											StyleDesign="2"
											MstName="担当"
											SelectedValue="{Binding Inp12SearchOpt.InpEndCd.Code}"
											Command="{Binding SelInpCd02Command}"/>
					</Grid>

					<Grid Grid.Row="3" Margin="0,0,0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition/>
							<ColumnDefinition/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
							<Button Margin="0,0,5,0" 
									HorizontalAlignment="Right" 
									BorderBrush="Black" BorderThickness="10"
									Command="{Binding DoPrevButtonCommand}"
									Style="{DynamicResource PrevPageBtn}"/>
							<Button HorizontalAlignment="Right" 
									BorderBrush="Black" BorderThickness="10"
									Command="{Binding DoNextButtonCommand}"
									Style="{DynamicResource NextPageBtn}" />
						</StackPanel>
						<Button Grid.Column="1" 
								Content="一覧取得(F5)" 
								HorizontalAlignment="Right" 
								BorderBrush="Black" BorderThickness="10"
								Style="{DynamicResource ExecButton}"
								Command="{Binding DoSearchCommand}"/>
					</Grid>

					<DataGrid Grid.Row="4"
							  x:Name="MyDataGrid1"
							  d:ItemsSource="{d:SampleData ItemCount=5}" 
							  Style="{DynamicResource WinGridData}"
							  IsReadOnly="True"
							  AutoGenerateColumns="False"
							  SelectionMode="Single"
							  ScrollViewer.VerticalScrollBarVisibility="Auto"
							  VerticalAlignment="Stretch"
							  HorizontalAlignment="Stretch"
							  ItemsSource="{Binding OrderList}"
							  SelectedItem="{Binding SelOrderItem}">
						<i:Interaction.Triggers>
							<i:EventTrigger EventName="PreviewMouseDoubleClick">
								<i:InvokeCommandAction Command="{Binding RowDoubleClickCommand}" 
													   CommandParameter="{Binding SelectedItem, ElementName=MyDataGrid1, FallbackValue={x:Null}}" />
							</i:EventTrigger>
						</i:Interaction.Triggers>
						<DataGrid.Columns>
							<DataGridTextColumn Width="*" Binding="{Binding SeqNo}" Header="伝票No" />
							<DataGridTextColumn Width="*" Binding="{Binding InvCountDate}" Header="受注日" />
							<DataGridTextColumn Width="*" Binding="{Binding ClientCD1}" Header="得意先" />
							<DataGridTextColumn Width="*" Binding="{Binding TradeName}" Header="得意先名" />
							<DataGridTextColumn Width="*" Binding="{Binding StoreCD}" Header="倉庫" />
							<DataGridTextColumn Width="*" Binding="{Binding StoreName}" Header="倉庫先名" />
							<DataGridTextColumn Width="*" Binding="{Binding ExhibitCD}" Header="展示会" />
							<DataGridTextColumn Width="*" Binding="{Binding ExhibitName}" Header="展示会名" />
							<DataGridTextColumn Width="*" Binding="{Binding TranCate}" Header="取引区分" />
							<DataGridTextColumn Width="*" Binding="{Binding TotalNum}" Header="数量計" />
							<DataGridTextColumn Width="*" Binding="{Binding TotalDetailAmt}" Header="金額計" />
						</DataGrid.Columns>
					</DataGrid>
					 
					<Grid Grid.Row="5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<RadioButton Grid.Column="0" Content="一覧"
								     Margin="0,0,10,0"
									 IsChecked="{Binding Inp12SearchOpt.SelPrintCond, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=0}"
									 GroupName="OutPutType"/>
						<RadioButton Grid.Column="1" Content="明細"
									 Margin="0,0,10,0"
									 IsChecked="{Binding Inp12SearchOpt.SelPrintCond, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=1}"
									 GroupName="OutPutType"/>
						<Button Grid.Column="2" 
								Margin="0,0,10,0"
								Style="{DynamicResource PrintIconBtn}"
								Command="{Binding DoPrintCommand}"/>
						<Button Grid.Column="3"
								Margin="0,0,10,0"
								Content="CSV出力"
								Style="{DynamicResource PrintIconBtn}"
								Command="{Binding DoCSVCommand}"/>

						<Button Grid.Column="5"
								Margin="0,0,10,0"
								Content="修正・照会(F6)" 
								Style="{DynamicResource UpdateIconBtn}" 
								Command="{Binding RowDoubleClickCommand}"/>
						<Button Grid.Column="6"
								Margin="0,0,10,0"
								Style="{DynamicResource DeleteIconBtn}"
								Command="{Binding DoDeleteCommand}"/>
						<Button Grid.Column="7"
								Style="{DynamicResource BackBtn}" 
								Command="{Binding ExitCommand}"/>
					</Grid> 
				</Grid>
			</TabItem>
			<TabItem Header="修正・登録画面(Shift+F2)">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="450"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="0,0,0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Label Grid.Row="0" Grid.Column="0"   
							   VerticalContentAlignment="Center"
							   MinWidth="62" 
							   Content="伝票No" />
						<TextBox Grid.Row="0" Grid.Column="1"   
								 HorizontalContentAlignment="Right"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12DetailOpt.SlipNo}"/>
						<Label Grid.Row="0" Grid.Column="2"   
							   VerticalContentAlignment="Center"
							   Content="受注日" />
						<DatePicker Grid.Row="0" Grid.Column="3"
									Margin="0,0,5,0"
									SelectedDate="{Binding Inp12DetailOpt.OrderDate}"/>
						<Label Grid.Row="0" Grid.Column="4"   
							   VerticalContentAlignment="Center"
							   Content="納品日" />
						<DatePicker Grid.Row="0" Grid.Column="5"
									Margin="0,0,5,0"
									SelectedDate="{Binding Inp12DetailOpt.DeliverDate}"/>
						<Button Grid.Row="0" Grid.Column="6"  
								Content="一括設定"
								Command="{Binding DoBatchSetCommand}"
								Style="{DynamicResource BackBtn}"/>
						<Label Grid.Row="0" Grid.Column="7"   
							   VerticalContentAlignment="Center"
							   Content="取引区分" />
						<ComboBox Grid.Row="0" Grid.Column="8"
								  VerticalAlignment="Top"
								  VerticalContentAlignment="Center"
								  ItemsSource="{Binding TranCatList}"
								  DisplayMemberPath="Key"
								  SelectedValuePath="Key"
								  SelectedValue="{Binding Inp12DetailOpt.TranCate, Mode=TwoWay}"
								  Style="{StaticResource SearchableComboBox1}"/>
						<Label Grid.Row="0" Grid.Column="9"   
							   VerticalContentAlignment="Center"
							   Content="掛率" />
						<TextBox Grid.Row="0" Grid.Column="10"  
								 HorizontalContentAlignment="Right"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12DetailOpt.MarkupRate}"/> 
					</Grid>

					<Grid Grid.Row="1" Margin="0,0,0,5">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*"/>
							<ColumnDefinition Width="7*"/>
						</Grid.ColumnDefinitions>
						<Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Label Grid.Row="0" Grid.Column="0" 
								   VerticalContentAlignment="Center"
								   MinWidth="62"
								   Content="得意先" />
							<TextBox Grid.Row="0" Grid.Column="1"
									 HorizontalContentAlignment="Left"
									 VerticalContentAlignment="Center"
									 Text="{Binding Inp12DetailOpt.CustDest.Display}"/>
							<uc:CvnetBtListView Grid.Row="0" Grid.Column="2" 
												MstName="全得意先"
												StyleDesign="2"
												SelectedValue="{Binding Inp12DetailOpt.CustDest.Code}"
												Command="{Binding SelCustDestCommand}"/>
						</Grid>
						<Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Label Grid.Row="0" Grid.Column="0" 
								   VerticalContentAlignment="Center"
								   MinWidth="62"
								   Content="関連No1" />
							<TextBox Grid.Row="0" Grid.Column="1"
									 Text="{Binding Inp12DetailOpt.RelatedNo}"
									 HorizontalContentAlignment="Right"
									 VerticalContentAlignment="Center"/>
							<Label Grid.Row="0" Grid.Column="2" 
								   VerticalContentAlignment="Center"
								   MinWidth="62"
								   Content="関連No2" />
							<TextBox Grid.Row="0" Grid.Column="3"
									 Text="{Binding Inp12DetailOpt.RelatedNo2}"
									 HorizontalContentAlignment="Right"
									 VerticalContentAlignment="Center"/>
							<Label Grid.Row="0" Grid.Column="4" 
								   VerticalContentAlignment="Center"
								   MinWidth="62"
								   Content="手入力No" />
							<TextBox Grid.Row="0" Grid.Column="5"
									 Margin="0,0,5,0"
									 Text="{Binding Inp12DetailOpt.ManualInpNo}"
									 HorizontalContentAlignment="Right"
									 VerticalContentAlignment="Center"/>
							<Button Grid.Row="0" Grid.Column="6"  
									Margin="0,0,5,0"
									Content="掛率一括展開"
									Command="{Binding DoExpandRateCommand}"
									Style="{DynamicResource BackBtn}"/>
							<Button Grid.Row="0" Grid.Column="7"  
									Content="ｵｰﾙｸﾘｱ"
									Command="{Binding DoAllClearCommand}"
									Style="{DynamicResource BackBtn}"/>
						</Grid>

						<Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Label Grid.Row="0" Grid.Column="0" 
								   VerticalContentAlignment="Center"
								   MinWidth="62"
								   Content="倉庫" />
							<TextBox Grid.Row="0" Grid.Column="1"
									 HorizontalContentAlignment="Left"
									 VerticalContentAlignment="Center"
									 Text="{Binding Inp12DetailOpt.StoreCd.Display}"/>
							<uc:CvnetBtListView Grid.Row="0" Grid.Column="2"
												MstName="倉庫"
												StyleDesign="2"
												SelectedValue="{Binding Inp12DetailOpt.StoreCd.Code}"
												Command="{Binding SelStoreCdCommand}"/>
						</Grid>
						<Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="3*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="3*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="1.8*" />
							</Grid.ColumnDefinitions>
							<Label Grid.Row="0" Grid.Column="0" 
								   VerticalContentAlignment="Center"
								   MinWidth="62"
								   Content="入力者" />
							<TextBox Grid.Row="0" Grid.Column="1"
									 HorizontalContentAlignment="Left"
									 VerticalContentAlignment="Center"
									 Text="{Binding Inp12DetailOpt.InpCd.Display}"/>
							<uc:CvnetBtListView Grid.Row="0" Grid.Column="2"
												StyleDesign="2"
												SelectedValue="{Binding Inp12DetailOpt.InpCd.Code}"
												Command="{Binding SelInpCdCommand}"/>
							<Label Grid.Row="0" Grid.Column="3" 
								   VerticalContentAlignment="Center"
								   Content="展示会" />
							<TextBox Grid.Row="0" Grid.Column="4"
									 HorizontalContentAlignment="Left"
									 VerticalContentAlignment="Center"
									 Text="{Binding Inp12DetailOpt.ExhibitCd.Display}"/>
							<uc:CvnetBtListView Grid.Row="0" Grid.Column="5"
												StyleDesign="2"
												MstName="展示会"
												SelectedValue="{Binding Inp12DetailOpt.ExhibitCd.Code}"
												Command="{Binding SelExhibitCdCommand}"/>
						</Grid>

						<Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" /> 
							</Grid.ColumnDefinitions>
							<Label Grid.Row="0" Grid.Column="0" 
								   VerticalContentAlignment="Center"
								   MinWidth="62"
								   Content="備考" />
							<TextBox Grid.Row="0" Grid.Column="1"
									 HorizontalContentAlignment="Left"
									 VerticalContentAlignment="Center"
									 Text="{Binding Inp12DetailOpt.Memo}"/>
						</Grid>
						<Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="3*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="3*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Label Grid.Row="0" Grid.Column="0"
								   VerticalContentAlignment="Center"
								   Content="営業担当" />
							<TextBox Grid.Row="0" Grid.Column="1"
									 HorizontalContentAlignment="Left"
									 VerticalContentAlignment="Center"
									 Text="{Binding Inp12DetailOpt.SalesRep.Display}"/>
							<uc:CvnetBtListView Grid.Row="0" Grid.Column="2"
												Margin="0,0,5,0"
												StyleDesign="2"
												MstName="営業担当"
												SelectedValue="{Binding Inp12DetailOpt.SalesRep.Code}"
												Command="{Binding SelSalesRepCommand}" />
							<TextBox Grid.Row="0" Grid.Column="3"
									 HorizontalContentAlignment="Left"
									 VerticalContentAlignment="Center"
									 Text="{Binding Inp12DetailOpt.ProdCd.Display}"/>
							<uc:CvnetBtListView Grid.Row="0" Grid.Column="4"
												Margin="0,0,5,0"
												StyleDesign="2"
												MstName="商品"
												SelectedValue="{Binding Inp12DetailOpt.ProdCd.Code}"
												Command="{Binding SelProdCdCommand}"/>
							<Button Grid.Row="0" Grid.Column="5"   
									Content="展開商品CD"
									Command="{Binding DoAvailProdCommand}"
									Style="{DynamicResource BackBtn}"/>
						</Grid>
					</Grid>

					<StackPanel Grid.Row="2" 
								Margin="0,0,0,5" 
								HorizontalAlignment="Center"
								Width="300">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Label Grid.Row="0" Grid.Column="0" 
								   VerticalContentAlignment="Center" 
								   Content="計" />
							<TextBox Grid.Row="0" Grid.Column="1"
									 HorizontalContentAlignment="Right"
									 VerticalContentAlignment="Center"
									 Text="{Binding Inp12DetailOpt.Num}"/>
							<TextBox Grid.Row="0" Grid.Column="2"
									 HorizontalContentAlignment="Right"
									 VerticalContentAlignment="Center"
									 Text="{Binding Inp12DetailOpt.RetailPrice}"/>
							<TextBox Grid.Row="0" Grid.Column="3"
								 HorizontalContentAlignment="Right"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12DetailOpt.WholesalePrice}"/>
						</Grid>
					</StackPanel>
					<StackPanel Grid.Row="2" 
								Margin="0,0,0,5" 
								HorizontalAlignment="Right">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Button Grid.Column="0" 
									Margin="0,0,5,0"
									Content="一括Refresh⇔"
									Style="{DynamicResource BackBtn}"/>
							<Button Grid.Column="1" 
									Margin="0,0,5,0"
									Content="ﾊﾞｰｺｰﾄﾞ入力"
									Command="{Binding InpBarcodeCommand}"
									Style="{DynamicResource BackBtn}"/>
						</Grid>
					</StackPanel>

					<uc:CvnetFlexView Grid.Row="3"
									  x:Name="Inp12DetailGrid"
									  d:ItemsSource="{d:SampleData ItemCount=5}"
									  ItemsSource="{Binding Inp12DetailItems}"
									  IsSynchronizedWithCurrentItem="True"
									  HeadersVisibility="Column"
									  GridLinesVisibility="All"
									  HorizontalGridLinesBrush="#B0B0B0"
									  VerticalGridLinesBrush="#B0B0B0"
									  BorderBrush="#707070"
									  BorderThickness="1">
						<uc:CvnetFlexView.Columns>
							<DataGridTemplateColumn Width="*">
								<DataGridTemplateColumn.HeaderTemplate>
									<DataTemplate>
										<StackPanel>
											<TextBlock Text="商品CD" FontWeight="Bold"/>
											<TextBlock Text="商品名" FontWeight="Bold"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.HeaderTemplate>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition/>
												<RowDefinition/>
											</Grid.RowDefinitions>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="6*"/>
												<ColumnDefinition Width="4*"/>
											</Grid.ColumnDefinitions>
											<TextBox Grid.Column="0" Text="{Binding ProdCD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
											<Button Grid.Column="1" Content="一覧" 
													Margin="0" Padding="6" 
													Command="{Binding DataContext.DoProdRowSearchCommand,
																	  RelativeSource={RelativeSource AncestorType=DataGrid},FallbackValue={x:Null}}"
													CommandParameter="{Binding}" />
											<Border Grid.Row="1" Grid.ColumnSpan="2"  BorderBrush="DarkGray" BorderThickness="0,1,0,0">
												<TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DetailName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
											</Border>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<DataGridTemplateColumn Width="*">
								<DataGridTemplateColumn.HeaderTemplate>
									<DataTemplate>
										<StackPanel>
											<TextBlock Text="色" FontWeight="Bold"/>
											<TextBlock Text="色名" FontWeight="Bold"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.HeaderTemplate>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition/>
												<RowDefinition/>
											</Grid.RowDefinitions>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="6*"/>
												<ColumnDefinition Width="4*"/>
											</Grid.ColumnDefinitions>
											<TextBox Grid.Column="0" Text="{Binding ColorCD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
											<Button Grid.Column="1" Content="一覧" 
													Margin="0" Padding="6" 
													Command="{Binding DataContext.DoColorRowSearchCommand,
															  RelativeSource={RelativeSource AncestorType=DataGrid},FallbackValue={x:Null}}"
													CommandParameter="{Binding}" />
											<Border Grid.Row="1" Grid.ColumnSpan="2"  BorderBrush="DarkGray" BorderThickness="0,1,0,0">
												<TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ColorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
											</Border>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<DataGridTemplateColumn Width="*">
								<DataGridTemplateColumn.HeaderTemplate>
									<DataTemplate>
										<StackPanel>
											<TextBlock Text="サイズ" FontWeight="Bold"/>
											<TextBlock Text="サイズ名" FontWeight="Bold"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.HeaderTemplate>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition/>
												<RowDefinition/>
											</Grid.RowDefinitions>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="6*"/>
												<ColumnDefinition Width="4*"/>
											</Grid.ColumnDefinitions>
											<TextBox Grid.Column="0" Text="{Binding SizeCD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
											<Button Grid.Column="1" Content="一覧" 
													Margin="0" Padding="6" 
													Command="{Binding DataContext.DoSizeRowSearchCommand,
													RelativeSource={RelativeSource AncestorType=DataGrid},FallbackValue={x:Null}}"
													CommandParameter="{Binding}" />
											<Border Grid.Row="1" Grid.ColumnSpan="2"  BorderBrush="DarkGray" BorderThickness="0,1,0,0">
												<TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SizeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Style="{StaticResource DataGridTextBox}"/>
											</Border>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<DataGridTemplateColumn Width="0.5*">
								<DataGridTemplateColumn.HeaderTemplate>
									<DataTemplate>
										<StackPanel>
											<TextBlock Text="数量" FontWeight="Bold"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.HeaderTemplate>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBox Text="{Binding Num, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
												 HorizontalContentAlignment="Right"
												 Style="{StaticResource DataGridTextBox}"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<DataGridTemplateColumn Width="*">
								<DataGridTemplateColumn.HeaderTemplate>
									<DataTemplate>
										<StackPanel>
											<TextBlock Text="上代単価" FontWeight="Bold"/>
											<TextBlock Text="上代金額" FontWeight="Bold"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.HeaderTemplate>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition/>
												<RowDefinition/>
											</Grid.RowDefinitions>
											<TextBox Grid.Column="0" 
													 HorizontalContentAlignment="Right"
													 Text="{Binding RetailUnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
													 Style="{StaticResource DataGridTextBox}"/>
											<TextBox Grid.Row="1"
													 HorizontalContentAlignment="Right"
													 Text="{Binding RetailAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
													 Style="{StaticResource DataGridTextBox}"/>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<DataGridTemplateColumn Width="*">
								<DataGridTemplateColumn.HeaderTemplate>
									<DataTemplate>
										<StackPanel>
											<TextBlock Text="納品日" FontWeight="Bold"/>
											<TextBlock Text="マスタ掛率" FontWeight="Bold"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.HeaderTemplate>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition/>
												<RowDefinition/>
											</Grid.RowDefinitions>
											<TextBox Grid.Column="0"
													 HorizontalContentAlignment="Right">
												<TextBox.Style>
													<Style TargetType="TextBox">
														<!-- Display format -->
														<Setter Property="Text">
															<Setter.Value>
																<Binding Path="DeliverDate" 
																		 Mode="OneWay"
																		 Converter="{StaticResource DateDisplayConverter}" />
															</Setter.Value>
														</Setter>
														<!-- Edit format -->
														<Style.Triggers>
															<Trigger Property="IsKeyboardFocusWithin" Value="True">
																<Setter Property="Text">
																	<Setter.Value>
																		<Binding Path="DeliverDate"
																				 Mode="TwoWay"
																				 UpdateSourceTrigger="PropertyChanged" />
																	</Setter.Value>
																</Setter> 
															</Trigger>
														</Style.Triggers>
													</Style>
												</TextBox.Style>
											</TextBox>
											<TextBox Grid.Row="1"
													 HorizontalContentAlignment="Right"
													 Style="{StaticResource DataGridTextBox}"/>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<DataGridTemplateColumn Width="3*">
								<DataGridTemplateColumn.HeaderTemplate>
									<DataTemplate>
										<StackPanel>
											<Grid>
												<Grid.RowDefinitions>
													<RowDefinition Height="*" />
													<RowDefinition Height="*" />
												</Grid.RowDefinitions>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<TextBlock Grid.Row="0" 
														   HorizontalAlignment="Center"
														   Grid.ColumnSpan="4" 
														   Text="摘要"
														   FontWeight="Bold"/>
												<TextBlock Grid.Row="1" Grid.Column="0" 
														   Text="計算掛率"
														   FontWeight="Bold"/>
												<TextBlock Grid.Row="1" Grid.Column="1"
														   Text="完了FLG"
														   FontWeight="Bold"/>
												<TextBlock Grid.Row="1" Grid.Column="2"
														   Text="頁"
														   FontWeight="Bold"/>
												<TextBlock Grid.Row="1" Grid.Column="3" 
														   Text="位置"
														   FontWeight="Bold"/>
											</Grid>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.HeaderTemplate>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="*" />
												<RowDefinition Height="*" />
											</Grid.RowDefinitions>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
													 HorizontalContentAlignment="Left"
													 Text="{Binding DetailMemo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													 Style="{StaticResource DataGridTextBox}"/>
											<TextBox Grid.Row="1" Grid.Column="0"
													 HorizontalContentAlignment="Right"
													 Foreground="{Binding CalcRateFgColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													 Background="{Binding CalcRateBgColor,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													 Text="{Binding CalcRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													 Style="{StaticResource DataGridTextBox}"/>
											<ComboBox Grid.Row="1" Grid.Column="1"
													  VerticalAlignment="Top"
													  VerticalContentAlignment="Center"
													  ItemsSource="{Binding DataContext.StatusList, RelativeSource={RelativeSource AncestorType=TabControl}}"
													  DisplayMemberPath="Value"
													  SelectedValuePath="Key"
													  SelectedValue="{Binding CompleteFlg, Mode=TwoWay}"
													  Style="{StaticResource SearchableComboBox1}"/>
											<TextBox Grid.Row="1" Grid.Column="2"
													 Text="{Binding SwatchPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													 Style="{StaticResource DataGridTextBox}"/>
											<TextBox Grid.Row="1" Grid.Column="3" 
													 Text="{Binding SwatchPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													 Style="{StaticResource DataGridTextBox}"/>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn> 
						</uc:CvnetFlexView.Columns>
					</uc:CvnetFlexView>

					<Grid Grid.Row="4" Margin="0,0,0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Label Grid.Row="0" Grid.Column="0" 
								   VerticalContentAlignment="Center"
								   MinWidth="62"
								   Content="作成/修正日" />
						<TextBox Grid.Row="0" Grid.Column="1"
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12DetailOpt.CreatedAt}"/>
						<TextBox Grid.Row="0" Grid.Column="2"
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Text="{Binding Inp12DetailOpt.UpdatedAt}"/>
						<Button Grid.Column="3" 
								Margin="0,0,5,0"
								Content="商品CD検索"
								Style="{DynamicResource BackBtn}"/>
						<Button Grid.Column="4" 
								Margin="0,0,5,0"
								Content="ｽﾜｯﾁ検索"
								Style="{DynamicResource BackBtn}"/>
						<Button Grid.Column="6" 
								Margin="0,0,5,0"
								Content="修正(F6)"
								Style="{DynamicResource BackBtn}"/>
						<Button Grid.Column="7" 
								Margin="0,0,5,0"
								Content="追加(F8)"
								Style="{DynamicResource BackBtn}"/>
						<Button Grid.Column="8" 
								Margin="0,0,5,0"
								Content="印刷(F9)"
								Style="{DynamicResource BackBtn}"/>
						<Button Grid.Column="9" 
								Margin="0,0,5,0"
								Content="一覧へ(ESC)"
								Style="{DynamicResource BackBtn}"/>
					</Grid>
				</Grid>
			</TabItem>
		</TabControl>

		<Grid Grid.Row="1" VerticalAlignment="Bottom">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Label Grid.Column="0" 
				   VerticalContentAlignment="Center"
				   HorizontalContentAlignment="Right"
				   Content="{Binding Mess1}" />
			<Label Grid.Column="1"
				   VerticalContentAlignment="Center"
				   HorizontalContentAlignment="Left"
				   Content="{Binding Mess2}" />
		</Grid>
	</Grid>
</Window>
