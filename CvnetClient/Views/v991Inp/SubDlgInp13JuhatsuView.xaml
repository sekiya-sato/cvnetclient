<Window x:Class="CvnetClient.Views.SubDlgInp13JuhatsuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="受注発注連携更新" Style="{StaticResource PrintWindowStyle1}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <utils:SubtractHeaderFooterHeightConverter x:Key="SubtractHeaderFooterHeightConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlgInp13JuhatsuViewModel/>
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="5.5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.RowSpan="1" Grid.ColumnSpan="4" Header="受注情報" BorderThickness="1" BorderBrush="#CCC"/>
        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <Label Grid.Row="0" Grid.Column="0" Content="日付"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <xctk:DateTimePicker 
     Format="Custom"
     FormatString="yyyy/MM/dd" 
     ShowButtonSpinner="True" 
     TimePickerVisibility="Collapsed" 
     AllowTextInput="False"
     Value="{Binding Condition.CodeNen1}" 
     MaxHeight="30"
     MinWidth="270"/>
            </StackPanel>
            <Label Grid.Row="0" Grid.Column="2" Content="~" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,0">
                <xctk:DateTimePicker 
     Format="Custom"
     FormatString="yyyy/MM/dd" 
     ShowButtonSpinner="True" 
     TimePickerVisibility="Collapsed" 
     AllowTextInput="False"
     Value="{Binding Condition.CodeNen2}" 
     MaxHeight="30"
     MinWidth="270"/>
            </StackPanel>
            <uc:CvnetBtListView Grid.Row="1" Grid.Column="0" MstName="倉庫" StyleDesign="1" Title="入庫倉庫" 
SelectedValue ="{Binding Condition.CodeSoko.Code}"
Command="{Binding SelSokoCommand}"/>
            <TextBox Width="280" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Condition.CodeSoko.Display}" HorizontalAlignment="Left"/>

            <Label Grid.Row="2" Grid.Column="0" Content="得意先" VerticalAlignment="Center" Margin="0,1"/>
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding Condition.CodeTokui1.Display}"/>
                <uc:CvnetBtListView Grid.Column="1" MstName="得意先" StyleDesign="2" 
        SelectedValue ="{Binding Condition.CodeTokui1.Code}"
        Command="{Binding SelTokui1Command}"/>
            </Grid>

            <Label Grid.Row="2" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
            <Grid Grid.Row="2" Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding Condition.CodeTokui2.Display}"/>
                <uc:CvnetBtListView Grid.Column="1" MstName="得意先" StyleDesign="2" 
            SelectedValue ="{Binding Condition.CodeTokui2.Code}"
            Command="{Binding SelTokui2Command}"/>
            </Grid>

            <Label Grid.Row="3" Grid.Column="0" Content="伝票NO"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Condition.CodeDenNo1}"/>
            <Label Grid.Row="3" Grid.Column="2" Content="~" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Condition.CodeDenNo2}"/>

            <Label Grid.Row="4" Grid.Column="0" Content="入力者" VerticalAlignment="Center" Margin="0,1"/>
            <Grid Grid.Row="4" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding Condition.CodeTan1.Display}"/>
                <uc:CvnetBtListView Grid.Column="1" MstName="担当" StyleDesign="2" 
SelectedValue ="{Binding Condition.CodeTan1.Code}"
Command="{Binding SelUser1Command}"/>
            </Grid>

            <Label Grid.Row="4" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
            <Grid Grid.Row="4" Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding Condition.CodeTan2.Display}"/>
                <uc:CvnetBtListView Grid.Column="1" MstName="担当" StyleDesign="2" 
    SelectedValue ="{Binding Condition.CodeTan2.Code}"
    Command="{Binding SelUser2Command}"/>
            </Grid>

            <local:ListFlexView Grid.Row="5" Grid.ColumnSpan="4" Grid.RowSpan="4" Margin="0" DataSource="{Binding ListFlexData}"/>
            
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <Path Data="M 10,20 L 20,0 L 0,0 Z" Fill="Black" Height="30" Width="30" x:Name="Arrow1" Margin="10">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Arrow1Translate"/>
                    </Path.RenderTransform>
                </Path>
                <Path Data="M 10,20 L 20,0 L 0,0 Z" Fill="Black" Height="30" Width="30" x:Name="Arrow2" Margin="10">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Arrow2Translate"/>
                    </Path.RenderTransform>
                </Path>
                <Path Data="M 10,20 L 20,0 L 0,0 Z" Fill="Black" Height="30" Width="30" x:Name="Arrow3" Margin="10">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Arrow3Translate"/>
                    </Path.RenderTransform>
                </Path>
            </StackPanel>

            
            
        </Grid>
        <GroupBox Grid.Row="2" Grid.RowSpan="1" Grid.ColumnSpan="4" Header="発注情報" BorderThickness="1" BorderBrush="#CCC"/>
        <Grid Grid.Row="2" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="発注日"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                    <xctk:DateTimePicker 
                     Format="Custom"
                     FormatString="yyyy/MM/dd" 
                     ShowButtonSpinner="True" 
                     TimePickerVisibility="Collapsed" 
                     AllowTextInput="False"
                     Value="{Binding Condition.CodeNen3}" 
                     MaxHeight="30"
                     MinWidth="270"/>
                </StackPanel>
                <Label Grid.Column="3" Content="納品日"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,0">
                    <xctk:DateTimePicker 
                         Format="Custom"
                         FormatString="yyyy/MM/dd" 
                         ShowButtonSpinner="True"
                         TimePickerVisibility="Collapsed"
                         AllowTextInput="False"
                         Value="{Binding Condition.CodeNen4}" 
                         MaxHeight="30"
                         MinWidth="270"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="仕入先設定:" VerticalAlignment="Center" Margin="0,0,20,0" Visibility="{Binding ShowOrNot}"/>
                <RadioButton Grid.Column="1" Content="商品メーカー" GroupName="SettingType" Visibility="{Binding ShowOrNot}" IsEnabled="{Binding OnOrNot}"
                         IsChecked="{Binding Condition.SelectedSetting, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=Maker, Mode=TwoWay}"
                        Margin="0,0,20,0"/>
                <RadioButton Grid.Column="2" Content="入力" GroupName="SettingType" Visibility="{Binding ShowOrNot}" IsEnabled="{Binding OnOrNot}"
                         IsChecked="{Binding Condition.SelectedSetting, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=Input, Mode=TwoWay}"/>
            </Grid>
            <Grid Grid.Row="2" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>
                <uc:CvnetBtListView Grid.Column="0" MstName="仕入先" StyleDesign="1" Title="仕入先" 
                SelectedValue ="{Binding Condition.CodeSiire.Code}"
                Command="{Binding SelSiireCommand}"/>
                <TextBox Width="200" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Condition.CodeSiire.Display}" HorizontalAlignment="Left"/>
                
            </Grid>
        </Grid>
        <Grid Grid.Row="3">
            <TextBlock Text="（注）１度連携したデータは再度発注には変換できません" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoExecuteCommand}" Content="実行(F5)"/>
                <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
