<Window x:Class="CvnetClient.Views.SubDlg13HbnhtykNewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="発注入力" Style="{StaticResource MasterWindowStyle2}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <utils:SubtractHeaderFooterHeightConverter x:Key="SubtractHeaderFooterHeightConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlgInp13ViewModel/>
    </Window.DataContext>
    <Grid>
        <TabControl BorderThickness="1" Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="検索画面(Shift+F1)">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="0.2*"/>
                                    <ColumnDefinition Width="2*"/>

                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="0.2*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="伝票No" VerticalAlignment="Center" Margin="0,1"/>
                                <TextBox Grid.Row="0" Grid.Column="1"  Margin="0,1" Text="{Binding EditSearch.DenpyoNo1}" />
                                <Label Grid.Row="0" Grid.Column="2" Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="3"  Margin="0,1" Text="{Binding EditSearch.DenpyoNo2}"/>

                                <Button Grid.Row="0" Grid.Column="4" Content="{Binding DateName}" VerticalAlignment="Center" Margin="0,1" Command="{Binding ClickDateTitleCommand}"/>
                                <xctk:DateTimePicker 
                                                    Format="Custom"
                                                    FormatString="yyyy/MM/dd" Grid.Row="0" Grid.Column="5"
                                                    Width="180" 
                                                    ShowButtonSpinner="True" 
                                                    TimePickerVisibility="Collapsed" 
                                                    AllowTextInput="False"
                                                    Value="{Binding EditSearch.NohinbiFrom}" 
                                                    Height="34"></xctk:DateTimePicker>
                                <Label Grid.Row="0" Grid.Column="6" Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                                <xctk:DateTimePicker 
                                                    Format="Custom"
                                                    FormatString="yyyy/MM/dd" Grid.Row="0" Grid.Column="7"
                                                    Width="180" 
                                                    ShowButtonSpinner="True" 
                                                    TimePickerVisibility="Collapsed" 
                                                    AllowTextInput="False"
                                                    Value="{Binding EditSearch.NohinbiTo}" 
                                                    Height="34"></xctk:DateTimePicker>

                                <Label Grid.Row="1" Grid.Column="0" Content="取引区分" VerticalAlignment="Center" Margin="0,1"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"  Margin="0,1" ItemsSource="{Binding ComboListToriHikiFrom}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditSearch.ToriKubunFrom}" Style="{StaticResource SearchableComboBox1}"/>
                                <Label Grid.Row="1" Grid.Column="2" Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="3"  Margin="0,1" ItemsSource="{Binding ComboListToriHikiTo}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditSearch.ToriKubunTo}" Style="{StaticResource SearchableComboBox1}"/>

                                <Label Grid.Row="1" Grid.Column="4" Content="関連No1" VerticalAlignment="Center" Margin="0,1"/>
                                <TextBox Grid.Row="1" Grid.Column="5"  Margin="0,1" Text="{Binding EditSearch.Kanren1From}"/>
                                <Label Grid.Row="1" Grid.Column="6" Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="7"  Margin="0,1" Text="{Binding EditSearch.Kanren1To}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="関連No2" VerticalAlignment="Center" Margin="0,1"/>
                                <TextBox Grid.Row="2" Grid.Column="1"  Margin="0,1" Text="{Binding EditSearch.Kanren2From}"/>
                                <Label Grid.Row="2" Grid.Column="2" Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="3"  Margin="0,1" Text="{Binding EditSearch.Kanren2To}"/>

                                <Label Grid.Row="2" Grid.Column="4" Content="手入力No" VerticalAlignment="Center" Margin="0,1"/>
                                <TextBox Grid.Row="2" Grid.Column="5"  Margin="0,1" Text="{Binding EditSearch.Tenyuryoku1}"/>
                                <Label Grid.Row="2" Grid.Column="6" Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="7"  Margin="0,1" Text="{Binding EditSearch.Tenyuryoku2}"/>

                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="4.5*"/>
                                    <ColumnDefinition Width="0.2*"/>
                                    <ColumnDefinition Width="4.5*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="仕入先" VerticalAlignment="Center" Margin="0,1"/>
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding EditSearch.SupplierFrom.Display}"/>
                                    <uc:CvnetBtListView Grid.Column="1" MstName="仕入先" StyleDesign="2" 
                                        SelectedValue ="{Binding EditSearch.SupplierFrom.Code}"
                                        Command="{Binding SelSupplier1Command}"/>
                                </Grid>

                                <Label Grid.Row="0" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="0" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding EditSearch.SupplierTo.Display}"/>
                                        <uc:CvnetBtListView Grid.Column="1" MstName="仕入先" StyleDesign="2" 
                                            SelectedValue ="{Binding EditSearch.SupplierTo.Code}"
                                            Command="{Binding SelSupplier2Command}"/>
                                </Grid>


                                <Label Grid.Row="1" Grid.Column="0" Content="入庫先" VerticalAlignment="Center" Margin="0,1" Visibility="{Binding sokoshow}"/>
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding EditSearch.WareFrom.Display}" Visibility="{Binding sokoshow}"/>
                                    <uc:CvnetBtListView Grid.Column="1" MstName="Ac移動倉庫" StyleDesign="2" 
    SelectedValue ="{Binding EditSearch.WareFrom.Code}" Visibility="{Binding Sokoshow}"
    Command="{Binding SelWare1Command}"/>
                                </Grid>

                                <Label Grid.Row="1" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center" Visibility="{Binding sokoshow}"/>
                                <Grid Grid.Row="1" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding EditSearch.WareTo.Display}" Visibility="{Binding sokoshow}"/>
                                    <uc:CvnetBtListView Grid.Column="1" MstName="Ac移動倉庫" StyleDesign="2" 
    SelectedValue ="{Binding EditSearch.WareTo.Code}" Visibility="{Binding sokoshow}"
    Command="{Binding SelWare2Command}"/>
                                </Grid>


                                <Button Grid.Row="2" Grid.Column="0" Content="商品" VerticalAlignment="Center" Margin="0,1" Command="{Binding ClickProdCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <!-- Gaya asal -->
                                            <Setter Property="Background" Value="LightGray"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Height" Value="28"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                x:Name="border"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <!-- Tukar gaya bila FlgSho = 1 -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FlgSho}" Value="1">
                                                    <Setter Property="Background" Value="LightBlue"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding EditSearch.ProductFrom.Display}"/>
                                    <uc:CvnetBtListView Grid.Column="1" MstName="商品" StyleDesign="2" 
    SelectedValue ="{Binding EditSearch.ProductFrom.Code}"
    Command="{Binding SelProduct1Command}"/>
                                </Grid>

                                <Label Grid.Row="2" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="2" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding EditSearch.ProductTo.Display}"/>
                                    <uc:CvnetBtListView Grid.Column="1" MstName="商品" StyleDesign="2" 
                                                        SelectedValue ="{Binding EditSearch.ProductTo.Code}"
                                                        Command="{Binding SelProduct2Command}"/>
                                </Grid>


                                <Label Grid.Row="3" Grid.Column="0" Content="入力者" VerticalAlignment="Center" Margin="0,1"/>
                                <Grid Grid.Row="3" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding EditSearch.UserFrom.Display}"/>
                                    <uc:CvnetBtListView Grid.Column="1" MstName="担当" StyleDesign="2" 
                                                        SelectedValue ="{Binding EditSearch.UserFrom.Code}"
                                                        Command="{Binding SelUser1Command}"/>
                                </Grid>

                                <Label Grid.Row="3" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,1" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="3" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding EditSearch.UserTo.Display}"/>
                                    <uc:CvnetBtListView Grid.Column="1" MstName="担当" StyleDesign="2" 
                                                        SelectedValue ="{Binding EditSearch.UserTo.Code}"
                                                        Command="{Binding SelUser2Command}"/>
                                </Grid>


                            </Grid>

                        </Grid>

                    </Border>

                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,10,0,0">
                            <Button Margin="1,6" Command="{Binding BackListCommand}" Style="{DynamicResource PrevPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                            <Button Margin="1,1,6,1" Command="{Binding NextListCommand}" Style="{DynamicResource NextPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                            <Label Content="連携" Visibility="{Binding Renkeishow}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"  Margin="0,1" ItemsSource="{Binding ComboListRenkei}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditSearch.Renkei}" Style="{StaticResource SearchableComboBox1}" Visibility="{Binding Renkeishow}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Margin="13,10,13,0" Command="{Binding DoListCommand}" Style="{DynamicResource ExecButton}" Content="一覧取得(F5)" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                    </Grid>

                    <DataGrid  Grid.Row="2" Margin="8,3,8,10" d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="MyDataGrid1"
                                AutoGenerateColumns="False"
                                Style="{DynamicResource WinGridData}"
                                IsReadOnly="True"
                                ItemsSource="{Binding ListOrder}"
                                SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                SelectionMode="Single"
                                ScrollViewer.CanContentScroll="True"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                               d:DataContext="{d:DesignInstance Type=vm:SubDlgInp13ViewModel, IsDesignTimeCreatable=True}"
                                MaxHeight="{Binding ActualHeight,
                                      RelativeSource={RelativeSource AncestorType=Window},
                                      Converter={StaticResource SubtractHeaderFooterHeightConverter},
                                      ConverterParameter=430}">
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding DenpyoNo}" Header="伝票No" />
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{Binding DataContext.DateName, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nohinbi}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Supplier}" Header="仕入先" />
                            <DataGridTextColumn Width="*" Binding="{Binding SupplierName}" Header="仕入先名" />
                            <DataGridTextColumn Width="*" Binding="{Binding Ware}" Header="入庫先" />
                            <DataGridTextColumn Width="*" Binding="{Binding WareName}" Header="入庫先名" />
                            <DataGridTextColumn Width="*" Binding="{Binding Torihiki}" Header="取引区分" />
                            <DataGridTextColumn Width="*" Binding="{Binding WeightSum }" Header="数量計" />
                            <DataGridTextColumn Width="*" Binding="{Binding PriceSum }" Header="金額計" />
                            <DataGridTextColumn Width="*" Binding="{Binding Kanren}" Header="関連伝票NO" />
                        </DataGrid.Columns>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding RowDoubleClickCommand}" CommandParameter="{Binding SelectedItem, ElementName=MyDataGrid1, FallbackValue={x:Null}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </DataGrid>

                    <Border Grid.Row="3" BorderThickness="0" BorderBrush="Black" Margin="8,0,8,0" HorizontalAlignment="Left" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0" Content="一覧" 
                                         GroupName="OutPutType"
                                         IsChecked="{Binding SelectedOutPut, 
                                                     Converter={StaticResource StringToBoolConverter}, 
                                                     ConverterParameter=List, Mode=TwoWay}"
                                         Margin="0,0,8,0"/>
                            <RadioButton Grid.Column="1" Content="明細" 
                                         GroupName="OutPutType"
                                         IsChecked="{Binding SelectedOutPut, 
                                                      Converter={StaticResource StringToBoolConverter}, 
                                                      ConverterParameter=Detail, Mode=TwoWay}"
                                         Margin="0,0,8,0"/>

                            <Button Grid.Column="2" Style="{DynamicResource PrintIconBtn}" Margin="0,0,8,0" Command="{Binding DoPrintCommand}"/>
                            <Button Grid.Column="3" Content="{Binding Csvname}" Width="90" Margin="0,0,8,0" Command="{Binding DoCSVCommand}"/>
                        </Grid>

                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource UpdateIconBtn}" Margin="0,0,8,0" Content="修正・照会(F6)" Command="{Binding RowDoubleClickCommand}"/>
                        <Button Style="{DynamicResource DeleteIconBtn}" Margin="0,0,8,0" Command="{Binding DoDeleteCommand}"/>
                        <Button  Margin="8" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="修正・登録画面(Shift+F2)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="伝票No" VerticalAlignment="Center" Margin="0,1"/>
                            <TextBox Grid.Column="1"  Margin="0,1" Text="{Binding SelectedOrderHeader.DenpyoNo}" />
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="取引区分" VerticalAlignment="Center" Margin="0,1"/>
                            <ComboBox Grid.Column="1"  Margin="0,1" Text="{Binding SelectedOrderHeader.ToriKubun}" Style="{StaticResource SearchableComboBox1}"/>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="発注日" VerticalAlignment="Center" Margin="0,1"/>
                            <xctk:DateTimePicker Width="380"
                                                Format="Custom"
                                                FormatString="yyyy/MM/dd" Grid.Column="1"
                                                ShowButtonSpinner="True" 
                                                TimePickerVisibility="Collapsed" 
                                                AllowTextInput="False"
                                                Value="{Binding SelectedOrderHeader.Hachubi}" 
                                                Height="34"></xctk:DateTimePicker>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="納品日" VerticalAlignment="Center" Margin="0,1"/>
                            <xctk:DateTimePicker 
                                                Format="Custom"
                                                FormatString="yyyy/MM/dd" Grid.Column="1"
                                                Width="380" 
                                                ShowButtonSpinner="True" 
                                                TimePickerVisibility="Collapsed" 
                                                AllowTextInput="False"
                                                Value="{Binding SelectedOrderHeader.Nohinbi}" 
                                                Height="34"></xctk:DateTimePicker>
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="関連No1" VerticalAlignment="Center" Margin="0,1"/>
                            <TextBox Grid.Column="1"  Margin="0,1" Text="{Binding SelectedOrderHeader.Kanren1}"/>
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="関連No2" VerticalAlignment="Center" Margin="0,1"/>
                            <TextBox Grid.Column="1"  Margin="0,1" Text="{Binding SelectedOrderHeader.Kanren2}"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="仕入先" VerticalAlignment="Center" Margin="0,1"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding SelectedOrderHeader.Supplier.Display}"/>
                                <uc:CvnetBtListView Grid.Column="1" MstName="仕入先" StyleDesign="2" 
    SelectedValue ="{Binding SelectedOrderHeader.Supplier.Code}"
    Command="{Binding SelSupplierDetailCommand}"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="入庫先" VerticalAlignment="Center" Margin="0,1"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding SelectedOrderHeader.Ware.Display}"/>
                                <uc:CvnetBtListView Grid.Column="1" MstName="Ac移動倉庫" StyleDesign="2" 
    SelectedValue ="{Binding SelectedOrderHeader.Ware.Code}"
    Command="{Binding SelWareDetailCommand}"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="手入力NO" VerticalAlignment="Center" Margin="0,1"/>
                            <TextBox Grid.Column="1"  Margin="0,1" Text="{Binding SelectedOrderHeader.Tenyuryoku}"/>
                        </Grid>
                        <Grid Grid.Row="4" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="入力者" VerticalAlignment="Center" Margin="0,1"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding SelectedOrderHeader.User.Display}"/>
                                <uc:CvnetBtListView Grid.Column="1" MstName="担当" StyleDesign="2" 
    SelectedValue ="{Binding SelectedOrderHeader.User.Code}"
    Command="{Binding SelUserDetailCommand}"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="5" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="備考" VerticalAlignment="Center" Margin="0,1"/>
                            <TextBox Grid.Column="1"  Margin="0,1" Text="{Binding SelectedOrderHeader.Biko}"/>
                        </Grid>
                        <Grid Grid.Row="5" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Margin="4" Content="展開商品CD" Command="{Binding ProductExpandCommand}"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" TextWrapping="Wrap" Text="{Binding Product.Display}"/>
