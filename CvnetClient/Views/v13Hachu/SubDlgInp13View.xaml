<Window x:Class="CvnetClient.Views.SubDlg13HbnhtykNewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        mc:Ignorable="d"
        Title="SubDlg13HbnhtykNewView" Style="{StaticResource MasterWindowStyle2}">
    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlgInp13ViewModel/>
    </Window.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="ContentRendered">
            <behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Grid>
        <TabControl BorderThickness="1" Grid.Row="0">
            <TabItem Header="検索画面(Shift+F1)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="0.2*"/>
                                    <ColumnDefinition Width="2*"/>

                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="0.2*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="伝票No" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1"  Margin="0,8" Text="{Binding EditSearch.DenpyoNo1}" />
                                <Label Grid.Row="0" Grid.Column="2" Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="3"  Margin="0,8" Text="{Binding EditSearch.DenpyoNo2}"/>

                                <Label Grid.Row="0" Grid.Column="4" Content="納品日" VerticalAlignment="Center" Margin="0,8"/>
                                <DatePicker Grid.Row="0" Grid.Column="5"  Margin="0,8" Text="{Binding EditSearch.NohinbiFrom}"/>
                                <Label Grid.Row="0" Grid.Column="6" Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <DatePicker Grid.Row="0" Grid.Column="7"  Margin="0,8" Text="{Binding EditSearch.NohinbiTo}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="取引区分" VerticalAlignment="Center" Margin="0,8"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"  Margin="0,8" ItemsSource="{Binding ComboListToriHikiFrom}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditSearch.ToriKubunFrom}" Style="{StaticResource SearchableComboBox1}"/>
                                <Label Grid.Row="1" Grid.Column="2" Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="3"  Margin="0,8" ItemsSource="{Binding ComboListToriHikiTo}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditSearch.ToriKubunTo}" Style="{StaticResource SearchableComboBox1}"/>

                                <Label Grid.Row="1" Grid.Column="4" Content="関連No1" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBox Grid.Row="1" Grid.Column="5"  Margin="0,8" Text="{Binding EditSearch.Kanren1From}"/>
                                <Label Grid.Row="1" Grid.Column="6" Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="7"  Margin="0,8" Text="{Binding EditSearch.Kanren1To}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="関連No2" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBox Grid.Row="2" Grid.Column="1"  Margin="0,8" Text="{Binding EditSearch.Kanren2From}"/>
                                <Label Grid.Row="2" Grid.Column="2" Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="3"  Margin="0,8" Text="{Binding EditSearch.Kanren2To}"/>

                                <Label Grid.Row="2" Grid.Column="4" Content="手入力No" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBox Grid.Row="2" Grid.Column="5"  Margin="0,8" Text="{Binding EditSearch.Tenyuryoku1}"/>
                                <Label Grid.Row="2" Grid.Column="6" Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="7"  Margin="0,8" Text="{Binding EditSearch.Tenyuryoku2}"/>

                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="4.5*"/>
                                    <ColumnDefinition Width="0.2*"/>
                                    <ColumnDefinition Width="4.5*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="仕入先" VerticalAlignment="Center" Margin="0,8"/>
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0" Text="{Binding EditSearch.SupplierFrom}"/>
                                    <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                                </Grid>

                                <Label Grid.Row="0" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="0" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0" Text="{Binding EditSearch.SupplierTo}"/>
                                    <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                                </Grid>


                                <Label Grid.Row="1" Grid.Column="0" Content="入庫先" VerticalAlignment="Center" Margin="0,8"/>
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0" Text="{Binding EditSearch.WareFrom}"/>
                                    <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                                </Grid>

                                <Label Grid.Row="1" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="1" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0" Text="{Binding EditSearch.WareTo}"/>
                                    <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                                </Grid>


                                <Label Grid.Row="2" Grid.Column="0" Content="商品" VerticalAlignment="Center" Margin="0,8"/>
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0" Text="{Binding EditSearch.ProductFrom}"/>
                                    <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                                </Grid>

                                <Label Grid.Row="2" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="2" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0" Text="{Binding EditSearch.ProductTo}"/>
                                    <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                                </Grid>


                                <Label Grid.Row="3" Grid.Column="0" Content="入力者" VerticalAlignment="Center" Margin="0,8"/>
                                <Grid Grid.Row="3" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0" Text="{Binding EditSearch.UserFrom}"/>
                                    <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                                </Grid>

                                <Label Grid.Row="3" Grid.Column="2"  Content="~" VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="3" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0" Text="{Binding EditSearch.UserTo}"/>
                                    <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                                </Grid>


                            </Grid>

                        </Grid>
                        
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Margin="1,6" Command="{Binding BackListCommand}" Style="{DynamicResource PrevPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                            <Button Margin="1,1,6,1" Command="{Binding NextListCommand}" Style="{DynamicResource NextPageBtn}" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                            <TextBox Text="0"/>
                            <Label Content="/0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Margin="13,6" Command="{Binding DoListCommand}" Style="{DynamicResource ExecButton}" Content="一覧登録(F5)" HorizontalAlignment="Right" BorderBrush="Black" BorderThickness="10"/>
                    </Grid>
                    
                    <DataGrid  Grid.Row="2" Margin="8,10,8,10" d:ItemsSource="{d:SampleData ItemCount=5}"
                                AutoGenerateColumns="False"
                                Style="{DynamicResource WinGridData}"
                                IsReadOnly="True"
                                ItemsSource="{Binding ListOrder}"
                                SelectionMode="Single"
                                MaxHeight="260"  
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding DenpyoNo }" Header="伝票No" />
                            <DataGridTextColumn Width="*" Binding="{Binding Nohinbi}" Header="納品日" />
                            <DataGridTextColumn Width="*" Binding="{Binding Supplier}" Header="仕入先" />
                            <DataGridTextColumn Width="*" Binding="{Binding SupplierName}" Header="仕入先名" />
                            <DataGridTextColumn Width="*" Binding="{Binding Ware}" Header="入庫先" />
                            <DataGridTextColumn Width="*" Binding="{Binding WareName}" Header="入庫先名" />
                            <DataGridTextColumn Width="*" Binding="{Binding Torihiki}" Header="取引区分" />
                            <DataGridTextColumn Width="*" Binding="{Binding WeightSum }" Header="数量計" />
                            <DataGridTextColumn Width="*" Binding="{Binding PriceSum }" Header="金額計" />
                            <DataGridTextColumn Width="*" Binding="{Binding Kanren}" Header="関連伝票NO" />
                            
                        </DataGrid.Columns>

                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Border  BorderThickness="0" BorderBrush="Black" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0" Content="一覧" Margin="0,0,8,0"/>
                                <RadioButton Grid.Column="1" Content="明細" Margin="0,0,8,0"/>

                                <Button Grid.Column="2" Style="{DynamicResource PrintIconBtn}" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="CSV出力" Width="90" Margin="0,0,8,0"/>
                            </Grid>
                            
                        </Border>
                        <Button Style="{DynamicResource UpdateIconBtn}" Margin="0,0,8,0"/>
                        <Button Style="{DynamicResource DeleteIconBtn}" Margin="0,0,8,0"/>
                        <Button  Margin="8" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>
                    </StackPanel>
                    
                    
                </Grid>
            </TabItem>
            <TabItem Header="修正・登録画面(Shift+F2)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="伝票No" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Column="1"  Margin="0,8" />
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="取引区分" VerticalAlignment="Center" Margin="0,8"/>
                            <ComboBox Grid.Column="1"  Margin="0,8" />
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="発注日" VerticalAlignment="Center" Margin="0,8"/>
                            <DatePicker Grid.Column="1"  Margin="0,8" />
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="納品日" VerticalAlignment="Center" Margin="0,8"/>
                            <DatePicker Grid.Column="1"  Margin="0,8" />
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="関連No1" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Column="1"  Margin="0,8" />
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="関連No2" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Column="1"  Margin="0,8" />
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="仕入先" VerticalAlignment="Center" Margin="0,8"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0"/>
                                <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="入庫先" VerticalAlignment="Center" Margin="0,8"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0"/>
                                <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="手入力NO" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Column="1"  Margin="0,8" />
                        </Grid>
                        <Grid Grid.Row="4" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="入力者" VerticalAlignment="Center" Margin="0,8"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0"/>
                                <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="5" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="備考" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Column="1"  Margin="0,8" />
                        </Grid>
                        <Grid Grid.Row="5" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"  Margin="0,8" />
                            <Button Grid.Column="1" Style="{DynamicResource ComboBtn}" Margin="2,0,0,0"/>
                            <Button Grid.Column="2" Content="展開商品CD"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="最終行追加(F11)"/>
                        <Label Grid.Column="3" Content="計"/>
                        <TextBox Grid.Column="4"/>
                        <TextBox Grid.Column="5"/>
                        <TextBox Grid.Column="6"/>
                        <Button Grid.Column="8" Content="一括Refresh↩"/>
                        <Button Grid.Column="9" Content="バーコード入力"/>
                    </Grid>
                    <DataGrid x:Name="MyDataGrid" AlternationCount="999999" Grid.Row="2" LoadingRow="MyDataGrid_LoadingRow" 
                              Style="{DynamicResource WinGridData}" d:ItemsSource="{d:SampleData ItemCount=5}"
                              AutoGenerateColumns="True" Height="300"
                              HeadersVisibility="Column" 
                              CanUserAddRows="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="挿入" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="削除" FontWeight="Bold" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="行Refresh" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="++↑" Margin="2" Padding="2,0"/>
                                                <Button Content="X←" Margin="2" Padding="2,0"/>
                                            </StackPanel>
                                            <Button Content="Refresh↩" Margin="2" Padding="2,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="商品CD" FontWeight="Bold"/>
                                            <TextBlock Text="商品名" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding 商品CD}" Margin="2"/>
                                                <Button Content="一覧" Margin="2" Padding="2,0"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding 商品名}" Margin="2"/>
                                            
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="色" FontWeight="Bold"/>
                                            <TextBlock Text="色名" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding 色CD}" Margin="2"/>
                                                <Button Content="一覧" Margin="2" Padding="2,0"/>    
                                            </StackPanel>
                                            <TextBox Text="{Binding 色}" Margin="2"/>
                                            
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="サイズ" FontWeight="Bold"/>
                                            <TextBlock Text="サイズ名" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding サイズ}" Margin="2"/>
                                                <Button Content="一覧" Margin="2" Padding="2,0"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding サイズ}" Margin="2"/>
                                            
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="数量" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding 数量}" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="上代単価" FontWeight="Bold"/>
                                            <TextBlock Text="上代金額" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBox Text="{Binding 上代単価}" Margin="2"/>
                                            <TextBox Text="{Binding 上代金額}" Margin="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <TextBlock Text="摘要" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="完了FLG" FontWeight="Bold"/>
                                                <TextBlock Text="メーカー品番" FontWeight="Bold"/>
                                                <TextBlock Text="区分" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBox Text="{Binding 摘要}" Margin="2" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding 完了FLG}" Margin="2"/>
                                                <TextBox Text="{Binding メーカー品番}" Margin="2"/>
                                                <TextBox Text="{Binding 区分}" Margin="2"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Label Content="作成/修正日"/>
                            <TextBox Margin="0,8"/>
                            <TextBox Margin="0,8"/>
                            <Button Content="商品CD検索"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{DynamicResource UpdateIconBtn}" Command="{Binding DoUpdateCommand}"/>
                            <Button Style="{DynamicResource AddIconBtn}" Command="{Binding DoInsertCommand}"/>
                            <Button Style="{DynamicResource PrintIconBtn}" Command="{Binding DoPrintCommand}"/>
                        </StackPanel>
                        
                        <Button Grid.Column="2" Margin="8" Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}" IsCancel="True" HorizontalAlignment="Right"/>
                    </Grid>
                    
                </Grid>
                
            </TabItem>
        </TabControl>

        
    </Grid>
</Window>
