<Window x:Class="CvnetClient.Views.SubDlg09UpallView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="在庫・掛再更新(管理者用)" Style="{StaticResource SmallWindow}">
    <Window.Resources>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg09UpallViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoExecuteCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="※更新処理は処理件数により数分～数十分かかります" Foreground="Red" HorizontalAlignment="Left"/>


        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="一括更新対象年月"/>
            <xctk:DateTimePicker Grid.Column="1"
                                     Format="Custom"
                                     FormatString="yyyy-MM" 
                                     MinWidth="180" 
                                     ShowButtonSpinner="True" 
                                     TimePickerVisibility="Collapsed" 
                                     AllowTextInput="False"
                                     Value="{Binding Condition.DateMonthFrom, Mode=TwoWay}" 
                                     MaxHeight="34"
                                     Margin="0,0,10,0"/>

            <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>
            <xctk:DateTimePicker Grid.Column="3"
                                     Format="Custom"
                                     FormatString="yyyy-MM" 
                                     MinWidth="180" 
                                     ShowButtonSpinner="True" 
                                     TimePickerVisibility="Collapsed" 
                                     AllowTextInput="False"
                                     Value="{Binding Condition.DateMonthTo, Mode=TwoWay}" 
                                     MaxHeight="34"
                                     Margin="0,0,10,0"/>
        </Grid>
        <TextBlock Grid.Row="2" HorizontalAlignment="Center">
            <TextBlock.Text>
                <MultiBinding StringFormat="更新対象範囲＝{0:yyyy/MM/dd}～{1:yyyy/MM/dd}">
                    <Binding Path="Condition.DateFrom" />
                    <Binding Path="Condition.DateTo" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        
        <Grid Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="4" CornerRadius="12" BorderBrush="#CCC" BorderThickness="1" MaxHeight="100"/>
            <RadioButton Grid.Column="0" Content="在庫" GroupName="ProcessType" Margin="20,0,20,0"
                IsChecked="{Binding Condition.SelectedProcess, 
                                    Converter={StaticResource StringToBoolConverter}, 
                                    ConverterParameter=Stock, Mode=TwoWay}"/>
            <RadioButton Grid.Column="1" Content="売掛" GroupName="ProcessType" Margin="0,0,20,0"
                         IsChecked="{Binding Condition.SelectedProcess, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=Account, Mode=TwoWay}"/>
            <RadioButton Grid.Column="2" Content="買掛" GroupName="ProcessType" Margin="0,0,20,0"
                         IsChecked="{Binding Condition.SelectedProcess, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=Payable, Mode=TwoWay}"/>
            <RadioButton Grid.Column="3" Content="全て" GroupName="ProcessType" Margin="0,0,20,0"
                         IsChecked="{Binding Condition.SelectedProcess, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=All, Mode=TwoWay}"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoExecuteCommand}"/>
            <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
        </StackPanel>

    </Grid>
</Window>
