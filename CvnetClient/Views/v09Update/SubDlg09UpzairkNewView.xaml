<Window x:Class="CvnetClient.Views.SubDlg09UpzairkNewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="在庫累計更新(管理者用)" Style="{StaticResource SmallWindow}">
    <Window.Resources>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg09UpzairkNewViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoExecuteCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="※更新処理は処理件数により数分～数十分かかります" Foreground="Red"></TextBlock>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="在庫更新対象年月" Grid.Column="0"></Label>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                <xctk:DateTimePicker 
                         Format="Custom"
                         FormatString="yyyy-MM" 
                         Width="180" 
                         ShowButtonSpinner="True" 
                         TimePickerVisibility="Collapsed" 
                         AllowTextInput="False"
                         Value="{Binding Condition.Date1, Mode=TwoWay}" 
                         Height="34"></xctk:DateTimePicker>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="0ﾃﾞｰﾀ除外月数"></Label>
            <TextBox Grid.Column="1" Margin="10" Text="{Binding Condition.Day}" Width="40"></TextBox>
            <TextBox Grid.Column="2" IsEnabled="False" Text="{Binding Condition.Date3}" Width="100"></TextBox>
        </Grid>

        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <RadioButton Grid.Column="0" Content="再計算" 
        GroupName="CalcType"
        IsChecked="{Binding Condition.SelectedCalc, 
                            Converter={StaticResource StringToBoolConverter}, 
                            ConverterParameter=再計算, Mode=TwoWay}"
Margin="0,0,20,0"/>
            <RadioButton Grid.Column="1" Content="指定月数以前在庫0除外" 
                 GroupName="CalcType"
                         IsChecked="{Binding Condition.SelectedCalc, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=指定月数以前在庫0除外, Mode=TwoWay}"
                 Margin="0,0,20,0"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoExecuteCommand}"/>
            <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
        </StackPanel>
    </Grid>
</Window>
