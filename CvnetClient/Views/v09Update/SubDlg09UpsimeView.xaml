<Window x:Class="CvnetClient.Views.SubDlg09UpsimeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        mc:Ignorable="d"
        Title="SubDlg09UpsimeView" Style="{StaticResource SmallWindow}">
    <Window.DataContext>
        <vm:SubDlg09UpsimeViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoExecuteCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="6.5*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="※設定日付以前の伝票、更新処理が行われません。" Foreground="Red"></TextBlock>
            <TextBlock Grid.Row="1" Text="※実行後、締日以前の伝票修正、更新処理が実行不可となります" Foreground="Red"></TextBlock>
        </Grid>
        <Grid Grid.Row="2" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>
            <Label Content="締日" Grid.Column="0"/>
            <xctk:DateTimePicker 
                Grid.Column="1"
         Format="Custom"
         FormatString="yyyy/MM/dd" 
         MinWidth="180" 
         ShowButtonSpinner="True" 
         TimePickerVisibility="Collapsed" 
         AllowTextInput="False"
         Value="{Binding Condition.Date}"/>
            <Grid Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Condition.FirstDate}"></TextBlock>
            </Grid>
            <Grid Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Condition.LastDate}"></TextBlock>
            </Grid>
            <Grid Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Condition.Person}"></TextBlock>
            </Grid>
            
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoExecuteCommand}"/>
            <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
        </StackPanel>

    </Grid>
</Window>
