<Window
    x:Class="CvnetClient.Views.SubDlg_prn_kakumstView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:CvnetClient.Views"
    xmlns:utils="clr-namespace:CvnetClient.Utils"
    xmlns:vm="clr-namespace:CvnetClient.ViewModels"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="各マスタ印刷画面"
    Width="1200"
    Style="{StaticResource MasterWindowStyle2}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <utils:VdateConverter x:Key="VdateConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utils:RdIntToBoolConverter x:Key="RdIntToBoolConverter" />
    </Window.Resources>

    <Window.DataContext>
        <vm:SubDlg_prn_kakumstViewModel />
    </Window.DataContext>

    <!--  Key bindings  -->
    <Window.InputBindings>
        <KeyBinding Key="F9" Command="{Binding DoPrintCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>

    <Grid>
        <Border Padding="0" Background="#FFEEEEEE">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="9*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!--  ==================== HEADER ====================  -->
                <Border
                    Margin="3"
                    Background="White"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Margin="5" Orientation="Horizontal">

                        <!--  マスタ区分  -->
                        <Label Content="マスタ区分" />

                        <ComboBox
                            Width="180"
                            ItemsSource="{Binding ChooseTab}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                            Style="{StaticResource SearchableComboBox1}" />
                        <Button
                            Width="100"
                            Margin="5"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleDateFlagCommand}">

                            <Button.Style>
                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">

                                    <!--  Default state  -->
                                    <Setter Property="Content" Value="修正日" />

                                    <Style.Triggers>

                                        <!--  When flag = 0  -->
                                        <DataTrigger Binding="{Binding DateFlag}" Value="0">
                                            <Setter Property="Content" Value="作成日" />
                                            <Setter Property="Background" Value="#FFEBF7F7" />
                                        </DataTrigger>

                                        <!--  When flag = 1  -->
                                        <DataTrigger Binding="{Binding DateFlag}" Value="1">
                                            <Setter Property="Content" Value="修正日" />
                                            <Setter Property="Background" Value="#FFF3F7EB" />
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                        </Button>

                        <xctk:DateTimePicker
                            Width="180"
                            Height="30"
                            Margin="5,0,5,0"
                            AllowTextInput="True"
                            Format="Custom"
                            FormatString="yyyy/MM/dd"
                            ShowButtonSpinner="True"
                            TimePickerVisibility="Collapsed"
                            Value="{Binding Condition.DateFrom}" />

                        <Label
                            Width="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="～" />

                        <xctk:DateTimePicker
                            Width="180"
                            Height="30"
                            AllowTextInput="True"
                            Format="Custom"
                            FormatString="yyyy/MM/dd"
                            ShowButtonSpinner="True"
                            TimePickerVisibility="Collapsed"
                            Value="{Binding Condition.DateTo}" />

                        <!--  入力社員  -->
                        <uc:CvnetBtListView
                            Title="入力社員CD"
                            Width="100"
                            Margin="10,0"
                            Command="{Binding ChooseEmployeeCommand}"
                            MstName="担当"
                            SelectedValue="{Binding Employee.Code}"
                            StyleDesign="1" />

                        <TextBox
                            Width="250"
                            Margin="5,0,0,0"
                            Text="{Binding Employee.Display, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!--  ==================== MAIN BODY ====================  -->
                <Border Grid.Row="1" Padding="5" Background="White" CornerRadius="10">
                    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                        <!--  商品マスタ  -->
                        <TabItem Header="商品マスタ(Shift+F1)">
                            <StackPanel>
                                <Border Margin="10" Background="#FFEBF7F7" BorderBrush="#FFF3F4F6" BorderThickness="1" CornerRadius="10">
                                    <ItemsControl Margin="0,10" ItemsSource="{Binding Tab1RowsA}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  Label 1  -->
                                                    <Label Margin="5,0,0,0" Content="{Binding Label1}" />
                                                    <TextBox Grid.Column="1" Text="{Binding RangeFrom1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="2"
                                                        Margin="-5,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding PickFrom1Command}"
                                                        MstName="{Binding Mstname1}"
                                                        SelectedValue="{Binding RangeFrom1.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                    <Label
                                                        Grid.Column="3"
                                                        Margin="-15,0,0,0"
                                                        Content="～" />
                                                    <TextBox Grid.Column="4" Text="{Binding RangeTo1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="5"
                                                        Margin="-5,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding PickTo1Command}"
                                                        MstName="{Binding Mstname1}"
                                                        SelectedValue="{Binding RangeTo1.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />

                                                    <!--  Label 2  -->
                                                    <Label
                                                        Grid.Column="6"
                                                        Margin="15,0,0,0"
                                                        Content="{Binding Label2}" />
                                                    <TextBox Grid.Column="7" Text="{Binding RangeFrom2.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="8"
                                                        Margin="-5,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding PickFrom2Command}"
                                                        MstName="{Binding Mstname2}"
                                                        SelectedValue="{Binding RangeFrom2.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                    <Label
                                                        Grid.Column="9"
                                                        Margin="-15,0,0,0"
                                                        Content="～" />
                                                    <TextBox Grid.Column="10" Text="{Binding RangeTo2.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="11"
                                                        Margin="-5,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding PickTo2Command}"
                                                        MstName="{Binding Mstname2}"
                                                        SelectedValue="{Binding RangeTo2.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Border Margin="10" Background="#FFEBF7F7" BorderBrush="#FFF3F4F6" BorderThickness="1" CornerRadius="10">
                                    <ItemsControl Margin="0,10" ItemsSource="{Binding Tab1RowsB}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  Label 1  -->
                                                    <Label Margin="5,0,0,0" Content="{Binding Label1}" />
                                                    <TextBox Grid.Column="1" Text="{Binding RangeFrom1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="2"
                                                        Margin="-5,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding PickFrom1Command}"
                                                        MstName="{Binding Mstname1}"
                                                        Param2="{Binding Parameter1}"
                                                        SelectedValue="{Binding RangeFrom1.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                    <Label
                                                        Grid.Column="3"
                                                        Margin="-15,0,0,0"
                                                        Content="～" />
                                                    <TextBox Grid.Column="4" Text="{Binding RangeTo1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="5"
                                                        Margin="-5,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding PickTo1Command}"
                                                        MstName="{Binding Mstname1}"
                                                        Param2="{Binding Parameter1}"
                                                        SelectedValue="{Binding RangeTo1.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />

                                                    <!--  Label 2  -->
                                                    <Label
                                                        Grid.Column="6"
                                                        Margin="15,0,0,0"
                                                        Content="{Binding Label2}" />
                                                    <TextBox Grid.Column="7" Text="{Binding RangeFrom2.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="8"
                                                        Margin="-5,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding PickFrom2Command}"
                                                        MstName="{Binding Mstname2}"
                                                        Param2="{Binding Parameter2}"
                                                        SelectedValue="{Binding RangeFrom2.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                    <Label
                                                        Grid.Column="9"
                                                        Margin="-15,0,0,0"
                                                        Content="～" />
                                                    <TextBox Grid.Column="10" Text="{Binding RangeTo2.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="11"
                                                        Margin="-5,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding PickTo2Command}"
                                                        MstName="{Binding Mstname2}"
                                                        Param2="{Binding Parameter2}"
                                                        SelectedValue="{Binding RangeTo2.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                            </StackPanel>
                        </TabItem>

                        <!--  得意先マスタ  -->
                        <TabItem Header="得意先マスタ(Shift+F2)">
                            <Border
                                Margin="10"
                                Background="#FFEBF7F0"
                                BorderBrush="#FFF3F4F6"
                                BorderThickness="1"
                                CornerRadius="10">
                                <ItemsControl Margin="0,20" ItemsSource="{Binding Tab2Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="50,10,100,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="5*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="5*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Label Content="{Binding Label1}" />
                                                <TextBox Grid.Column="1" Text="{Binding RangeFrom1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <uc:CvnetBtListView
                                                    Grid.Column="2"
                                                    Margin="-10,0,0,0"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding PickFrom1Command}"
                                                    MstName="{Binding Mstname1}"
                                                    SelectedValue="{Binding RangeFrom1.Code, Mode=TwoWay}"
                                                    StyleDesign="2" />
                                                <Label Grid.Column="3" Content="～" />
                                                <TextBox Grid.Column="4" Text="{Binding RangeTo1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <uc:CvnetBtListView
                                                    Grid.Column="5"
                                                    Margin="-10,0,0,0"
                                                    Command="{Binding PickTo1Command}"
                                                    MstName="{Binding Mstname1}"
                                                    SelectedValue="{Binding RangeTo1.Code, Mode=TwoWay}"
                                                    StyleDesign="2" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </TabItem>

                        <!--  仕入先マスタ  -->
                        <TabItem Header="仕入先マスタ(Shift+F3)">
                            <Border
                                Margin="10"
                                Background="#FFF3F7EB"
                                BorderBrush="#FFF3F4F6"
                                BorderThickness="1"
                                CornerRadius="10">
                                <ItemsControl Margin="0,20" ItemsSource="{Binding Tab3Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="50,10,100,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="5*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="5*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Label Content="{Binding Label1}" />
                                                <TextBox Grid.Column="1" Text="{Binding RangeFrom1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <uc:CvnetBtListView
                                                    Grid.Column="2"
                                                    Margin="-10,0,0,0"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding PickFrom1Command}"
                                                    MstName="{Binding Mstname1}"
                                                    SelectedValue="{Binding RangeFrom1.Code, Mode=TwoWay}"
                                                    StyleDesign="2" />
                                                <Label Grid.Column="3" Content="～" />
                                                <TextBox Grid.Column="4" Text="{Binding RangeTo1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <uc:CvnetBtListView
                                                    Grid.Column="5"
                                                    Margin="-10,0,0,0"
                                                    Command="{Binding PickTo1Command}"
                                                    MstName="{Binding Mstname1}"
                                                    SelectedValue="{Binding RangeTo1.Code, Mode=TwoWay}"
                                                    StyleDesign="2" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </TabItem>

                        <TabItem Header="名称マスタ(Shift+F4)">
                            <Border
                                Margin="10"
                                Background="#FFF7F2EB"
                                BorderBrush="#FFF3F4F6"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Margin="0,10">
                                    <Grid Margin="50,10,100,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>

                                        <!--  区分 ComboBox  -->
                                        <Label
                                            Grid.Row="0"
                                            Margin="0,10,0,10"
                                            Content="名称区分" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Margin="5,10,0,10"
                                            DisplayMemberPath="Value"
                                            ItemsSource="{Binding KubunOptions}"
                                            SelectedValue="{Binding SelectedKubun, Mode=TwoWay}"
                                            SelectedValuePath="Key"
                                            Style="{StaticResource SearchableComboBox1}" />

                                        <!--  名称CD Range  -->
                                        <Label
                                            Grid.Row="1"
                                            Margin="0,10,0,10"
                                            VerticalAlignment="Center"
                                            Content="名称CD" />

                                        <!--  From  -->
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="5,10,0,10"
                                            Text="{Binding RangeFrom3.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <uc:CvnetBtListView
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="-5,0,0,0"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding PickFrom3Command}"
                                            MstName="名称"
                                            Param2="{Binding SelectedKubun}"
                                            SelectedValue="{Binding RangeFrom3.Code, Mode=TwoWay}"
                                            StyleDesign="2" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            Margin="10,0,10,0"
                                            VerticalAlignment="Center"
                                            Content="～" />

                                        <!--  To  -->
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="4"
                                            Text="{Binding RangeTo3.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <uc:CvnetBtListView
                                            Grid.Row="1"
                                            Grid.Column="5"
                                            Margin="-5,0,0,0"
                                            Command="{Binding PickTo3Command}"
                                            MstName="名称"
                                            Param2="{Binding SelectedKubun}"
                                            SelectedValue="{Binding RangeTo3.Code, Mode=TwoWay}"
                                            StyleDesign="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <!--  生地付属マスタ  -->
                        <TabItem Header="生地付属マスタ(Shift+F5)">
                            <Border
                                Margin="10"
                                Background="#FFEBF5F7"
                                BorderBrush="#FFF3F4F6"
                                BorderThickness="1"
                                CornerRadius="10">
                                <ItemsControl Margin="0,20" ItemsSource="{Binding Tab5Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="50,10,100,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="5*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="5*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Label Content="{Binding Label1}" />
                                                <TextBox Grid.Column="1" Text="{Binding RangeFrom1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <uc:CvnetBtListView
                                                    Grid.Column="2"
                                                    Margin="-10,0,0,0"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding PickFrom1Command}"
                                                    MstName="{Binding Mstname1}"
                                                    SelectedValue="{Binding RangeFrom1.Code, Mode=TwoWay}"
                                                    StyleDesign="2" />
                                                <Label Grid.Column="3" Content="～" />
                                                <TextBox Grid.Column="4" Text="{Binding RangeTo1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <uc:CvnetBtListView
                                                    Grid.Column="5"
                                                    Margin="-10,0,0,0"
                                                    Command="{Binding PickTo1Command}"
                                                    MstName="{Binding Mstname1}"
                                                    SelectedValue="{Binding RangeTo1.Code, Mode=TwoWay}"
                                                    StyleDesign="2" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </TabItem>

                        <!--  社員マスタ  -->
                        <TabItem Header="社員マスタ(Shift+F6)">
                            <StackPanel>
                                <Border
                                    Margin="10"
                                    Background="#FFEBEDF7"
                                    BorderBrush="#FFF3F4F6"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <ItemsControl Margin="0,20" ItemsSource="{Binding Tab6RowsA}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="50,10,100,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="5*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="5*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Label Content="{Binding Label1}" />
                                                    <TextBox Grid.Column="1" Text="{Binding RangeFrom1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="2"
                                                        Margin="-10,0,0,0"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding PickFrom1Command}"
                                                        MstName="{Binding Mstname1}"
                                                        SelectedValue="{Binding RangeFrom1.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                    <Label Grid.Column="3" Content="～" />
                                                    <TextBox Grid.Column="4" Text="{Binding RangeTo1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="5"
                                                        Margin="-10,0,0,0"
                                                        Command="{Binding PickTo1Command}"
                                                        MstName="{Binding Mstname1}"
                                                        SelectedValue="{Binding RangeTo1.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Border
                                    Margin="10"
                                    Background="#FFEBEDF7"
                                    BorderBrush="#FFF3F4F6"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <ItemsControl Margin="0,20" ItemsSource="{Binding Tab6RowsB}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="50,10,100,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="5*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="5*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Label Content="{Binding Label1}" />
                                                    <TextBox Grid.Column="1" Text="{Binding RangeFrom1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="2"
                                                        Margin="-10,0,0,0"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding PickFrom1Command}"
                                                        MstName="名称"
                                                        Param2="{Binding Parameter1}"
                                                        SelectedValue="{Binding RangeFrom1.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                    <Label Grid.Column="3" Content="～" />
                                                    <TextBox Grid.Column="4" Text="{Binding RangeTo1.Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <uc:CvnetBtListView
                                                        Grid.Column="5"
                                                        Margin="-10,0,0,0"
                                                        Command="{Binding PickTo1Command}"
                                                        MstName="名称"
                                                        Param2="{Binding Parameter1}"
                                                        SelectedValue="{Binding RangeTo1.Code, Mode=TwoWay}"
                                                        StyleDesign="2" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>

                <Grid Grid.Row="2" Margin="10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Sort Order  -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Label Content="並び順" />
                        <ComboBox Width="200" ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                  Style="{StaticResource SearchableComboBox1}" />
                    </StackPanel>

                    <!--  Print / CSV  -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Label Margin="0,0,10,0" Content="出力区分" />
                        <RadioButton Margin="0,0,10,0" Content="スプール" GroupName="PrintType"
                                     IsChecked="{Binding Condition.SelectedPrint, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=スプール}" />
                        <RadioButton Content="CSV" GroupName="PrintType"
                                     IsChecked="{Binding Condition.SelectedPrint, Converter={StaticResource RdIntToBoolConverter}, ConverterParameter=CSV}" />
                    </StackPanel>
                </Grid>

                <!--  ==================== FOOTER ====================  -->
                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,5,0"
                        Command="{Binding DoPrintCommand}"
                        Style="{DynamicResource ExecButton}" />
                    <Button
                        Margin="8"
                        Command="{Binding ExitCommand}"
                        IsCancel="True"
                        Style="{DynamicResource BackBtn}" />
                </StackPanel>
