<Window x:Class="CvnetClient.Views.SubDlg71SendManualView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="連携データ手動送信" Style="{StaticResource SmallWindow}">
    <Window.Resources>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg71SendManualViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoExecuteCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">

            <Grid Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <RadioButton Grid.Column="0" Content="WMS出荷指示" 
                    GroupName="WMSType"
                    IsChecked="{Binding SelectedWMS, 
                            Converter={StaticResource StringToBoolConverter}, 
                            ConverterParameter=WMSOUT, Mode=TwoWay}"
                    Margin="0,0,20,0"/>
                <RadioButton Grid.Column="1" Content="WMS入荷予定" 
                    GroupName="WMSType"
                         IsChecked="{Binding SelectedWMS, 
                                             Converter={StaticResource StringToBoolConverter}, 
                                             ConverterParameter=WMSIN, Mode=TwoWay}"
                    Margin="0,0,20,0"/>
            </Grid>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox Text="{Binding DayAfter}" Margin="10" Width="50" IsEnabled="True"></TextBox>
                <TextBlock Text="日前" VerticalAlignment="Center"></TextBlock>
            </StackPanel>
            <TextBlock Text="{Binding Subject}" HorizontalAlignment="Right" VerticalAlignment="Center"></TextBlock>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="送信データ"  FontSize="12" Margin="0,0,0,4"/>

            <RichTextBox Grid.Row="1"
                         x:Name="LogBox"
                         IsReadOnly="True"
                         utils:RichTextBoxHelper.Document="{Binding LogDocument}"
                         FontSize="13"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         Background="#F9FAFB"
                         Padding="5"
                         Margin="0,4,0,0" />
        </Grid>

        <TextBlock Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Result}"></TextBlock>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoExecuteCommand}" Content="実行(Enter)"/>
            <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
        </StackPanel>
    </Grid>
</Window>
