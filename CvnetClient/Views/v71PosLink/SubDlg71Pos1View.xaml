<Window x:Class="CvnetClient.Views.SubDlg71Pos1View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvnetClient.Views"
        xmlns:vm="clr-namespace:CvnetClient.ViewModels"
        xmlns:utils="clr-namespace:CvnetClient.Utils"
        xmlns:uc="clr-namespace:CvnetClient.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="マスタデータ作成" Style="{StaticResource SmallWindow}">
    <Window.Resources>
        <utils:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:SubDlg71Pos1ViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding DoExecuteCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock HorizontalAlignment="Left" Text="※倉庫連携用マスタデータを作成します" VerticalAlignment="Top" Margin="10"></TextBlock>
            <xctk:DateTimePicker VerticalAlignment="Top"
                HorizontalAlignment="Right" Margin="10"
                Format="Custom"
                FormatString="yyyy/MM/dd HH:mm:ss" 
                Width="180"                                  
                ShowButtonSpinner="True" 
                TimePickerVisibility="Collapsed" 
                AllowTextInput="False"
                Value="{Binding DateFrom}" 
                Height="30">
                <xctk:DateTimePicker.Resources>
                    <Style TargetType="RepeatButton">
                        <Setter Property="Width" Value="14"/>
                        <Setter Property="Height" Value="14"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </xctk:DateTimePicker.Resources>
            </xctk:DateTimePicker>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <!-- biar RichTextBox stretch dan scroll -->
            </Grid.RowDefinitions>

            <TextBlock Text="送信ファイルログ"  FontSize="12" Margin="0,0,0,4"/>

            <RichTextBox Grid.Row="1"
                 x:Name="LogBox"
                 IsReadOnly="True"
                 utils:RichTextBoxHelper.Document="{Binding LogDocument}"
                 FontSize="13"
                 VerticalScrollBarVisibility="Auto"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1"
                 Background="#F9FAFB"
                 Padding="5"
                 Margin="0,4,0,0" />
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding Result}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox Text="{Binding DayBefore, StringFormat={}{0:0.000}, UpdateSourceTrigger=PropertyChanged}" Margin="10" Width="100" IsEnabled="False"></TextBox>
                <TextBlock Text="日前" VerticalAlignment="Center"></TextBlock>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button Style="{DynamicResource ExecButton}" Margin="0,0,8,0" Command="{Binding DoExecuteCommand}" Content="実行(Enter)"/>
            <Button Style="{DynamicResource BackBtn}" Command="{Binding ExitCommand}"/>
        </StackPanel>
    </Grid>
</Window>
