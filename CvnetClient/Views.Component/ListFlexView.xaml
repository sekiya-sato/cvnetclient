<UserControl x:Class="CvnetClient.Views.Component.ListFlexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CvnetClient.Views.Component"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
			 Height="Auto" Width="Auto"
			 Name="listflexview">
	<StackPanel>
		<Button Content="+行追加" Click="AddRow_Click" 
				Width="80" 
				Margin="5"
				HorizontalAlignment="Left"/>
		<DataGrid ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}"
				  AutoGenerateColumns="False" 
				  CanUserAddRows="False" 
				  HeadersVisibility="Column"
				  Margin="5"
				  Width="{Binding GridWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
				  Height="{Binding GridHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
				  ColumnWidth="*">
			<DataGrid.Columns>
				<!--行-->
				<DataGridTextColumn Header="行" Binding="{Binding No}" Width="*"/>

				<!-- 検索項目 -->
				<DataGridTemplateColumn Header="検索項目" Width="3*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ComboBox ItemsSource="{Binding unit_list, RelativeSource={RelativeSource AncestorType=UserControl}}"
									  DisplayMemberPath="Value"
									  SelectedValuePath="Value"
								      SelectedValue="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"> 
							</ComboBox>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 選択項目のコード(FROM) -->
				<DataGridTextColumn Header="選択項目のコード(FROM)" Binding="{Binding FromValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>

				<!-- 一覧 (FROM) -->
				<DataGridTemplateColumn Header="一覧" Width="0.5*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="一覧" Click="ListFrom_Click"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 選択項目のコード(TO) -->
				<DataGridTextColumn Header="選択項目のコード(TO)" Binding="{Binding ToValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>

				<!-- 一覧 (TO) -->
				<DataGridTemplateColumn Header="一覧" Width="0.5*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="一覧" Click="ListTo_Click"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 削除ボタン -->
				<DataGridTemplateColumn Header="削除" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="🗑" 
									Foreground="Red"
									Click="DeleteRow_Click"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

			</DataGrid.Columns>
		</DataGrid> 
	</StackPanel>
</UserControl>
