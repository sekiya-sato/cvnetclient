<UserControl x:Class="CvnetClient.Views.CustomDateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

	<UserControl.Resources>
		<DropShadowEffect x:Key="ShadowEffect"
                      BlurRadius="10"
                      ShadowDepth="0"
                      Color="Black"
                      Opacity="0.15"/>
	</UserControl.Resources>
	
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>

		<!-- TextBox -->
		<TextBox Grid.Column="0"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 IsReadOnly="True"/>

		<!-- Button -->
		<Button Grid.Column="1"
                Content="📅" 
				FontWeight="Bold"
                Click="OpenPopup"/>

		<!-- Popup -->
		<Popup IsOpen="{Binding IsPopupOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}" 
               StaysOpen="False">
			<Border Background="White" 
					BorderBrush="DarkGray" 
					BorderThickness="2" 
					CornerRadius="8" 
					Padding="10" 
					Effect="{StaticResource ShadowEffect}">
				<StackPanel>
					<Calendar x:Name="Calendar"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<!-- Hour -->
						<ComboBox x:Name="HourComboBox"
								  ItemsSource="{Binding HourList, RelativeSource={RelativeSource AncestorType=UserControl}}"
								  Width="60" Margin="2"
								  DisplayMemberPath="Value"
								  SelectedValuePath="Key"
								  SelectedValue="{Binding IsHour, RelativeSource={RelativeSource AncestorType=UserControl}}"
								  Style="{StaticResource SearchableComboBox1}"/>
						<TextBlock Text="時" VerticalAlignment="Center"/>
						<!-- Minute -->
						<ComboBox x:Name="MinuteComboBox"
								  ItemsSource="{Binding MinsList, RelativeSource={RelativeSource AncestorType=UserControl}}"
								  Width="60" Margin="2"
								  DisplayMemberPath="Value"
								  SelectedValuePath="Key"
								  SelectedValue="{Binding IsMins, RelativeSource={RelativeSource AncestorType=UserControl}}"
								  Style="{StaticResource SearchableComboBox1}"/>
						<TextBlock Text="分" VerticalAlignment="Center"/>
						<!-- Second -->
						<ComboBox x:Name="SecondComboBox"
								  ItemsSource="{Binding SecsList, RelativeSource={RelativeSource AncestorType=UserControl}}"
								  Width="60" Margin="2"
								  DisplayMemberPath="Value"
								  SelectedValuePath="Key"
								  SelectedValue="{Binding IsSecs, RelativeSource={RelativeSource AncestorType=UserControl}}"
								  Style="{StaticResource SearchableComboBox1}"/>
						<TextBlock Text="秒" VerticalAlignment="Center"/>
					</StackPanel>
					<Button Content="確定" Click="Confirm"/>
				</StackPanel>
			</Border>
		</Popup>
	</Grid>
</UserControl>
